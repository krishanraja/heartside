{% comment %}Temporary private theme-editor diagnostic. Remove before launch.{% endcomment %}
{% if request.design_mode %}
  <main style="max-width:48rem;margin:2rem auto;padding:1rem">
    <h1>Existing artwork preparation check</h1>
    <p>The preparation checks use saved artwork without generating images. The separate Add button adds one prepared item only when the cart is empty. No order or payment is submitted.</p>
    <form id="hs-image-check">
      <p><label>Existing customization ID <input name="customizationId" required pattern="[a-f0-9-]{36}" autocomplete="off"></label></p>
      <p><label>Original variant ID <input name="variantId" required pattern="[0-9]+" autocomplete="off"></label></p>
      <button type="submit">Check existing artwork preparation</button>
    </form>
    <pre id="hs-image-result" role="status" style="white-space:pre-wrap"></pre>
    <img id="hs-image-preview" alt="Saved design returned by the artwork preparation service" width="512" height="512" hidden style="max-width:100%;max-height:32rem;object-fit:contain">
    <hr>
    <form id="hs-adapter-check">
      <p><label>Existing native cart payload <textarea name="payload" required rows="6" style="width:100%" autocomplete="off"></textarea></label></p>
      <p><label>Shopify Files prefix <input name="prefix" required type="url" autocomplete="off"></label></p>
      <button type="submit">Prepare existing native cart item</button>
    </form>
    <button id="hs-add-prepared" type="button" disabled>Add prepared test item to cart</button>
    <pre id="hs-adapter-result" role="status" style="white-space:pre-wrap"></pre>
    <a href="{{ routes.cart_url }}" target="_blank" rel="noopener">Open test cart</a>
    <hr>
    <h2>Retained cart quantity check</h2>
    <p>Read the retained cart, then update one existing line. This does not add a product, generate artwork or place an order.</p>
    <form id="hs-retained-cart">
      <p><label>Retained cart ID <input name="cartId" type="password" required autocomplete="off"></label></p>
      <button type="submit">Read retained cart</button>
      <p><label>Existing native line ID <input name="lineId" autocomplete="off"></label></p>
      <p><label>Desired native quantity <input name="quantity" type="number" min="1" max="10" step="1" value="1"></label></p>
      <button type="button" id="hs-retained-update" disabled>Update retained native quantity</button>
    </form>
    <pre id="hs-retained-result" role="status" style="white-space:pre-wrap"></pre>
  </main>
  <script src="{{ 'hs-checkout-image.js' | asset_url }}" defer="defer"></script>
  <script>
    (function () {
      var form = document.getElementById('hs-image-check');
      var retainedForm = document.getElementById('hs-retained-cart');
      var retainedResult = document.getElementById('hs-retained-result');
      var retainedUpdate = document.getElementById('hs-retained-update');
      var checkedCartId = '';
      function showRetainedCart(cart) {
        retainedResult.textContent = JSON.stringify({
          found: !!cart,
          totalQuantity: cart && cart.totalQuantity,
          total: cart && cart.cost && cart.cost.totalAmount,
          lines: cart && cart.lines && cart.lines.map(function (line) { return { id: line.id, quantity: line.quantity, cost: line.cost }; })
        }, null, 2);
      }
      retainedForm.elements.cartId.addEventListener('input', function () { checkedCartId = ''; retainedUpdate.disabled = true; });
      retainedForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        retainedUpdate.disabled = true; checkedCartId = '';
        var cartId = retainedForm.elements.cartId.value.trim();
        try {
          var response = await Shopify.actions.getCart({ cartId: cartId });
          showRetainedCart(response.cart);
          if (response.cart) { checkedCartId = cartId; retainedUpdate.disabled = false; }
        } catch (_) { retainedResult.textContent = 'Cart read failed. No change made.'; }
      });
      retainedUpdate.addEventListener('click', async function () {
        if (retainedUpdate.disabled || !checkedCartId || checkedCartId !== retainedForm.elements.cartId.value.trim()) return;
        var lineId = retainedForm.elements.lineId.value.trim(), quantity = Number(retainedForm.elements.quantity.value);
        if (!lineId || !Number.isInteger(quantity) || quantity < 1 || quantity > 10) { retainedResult.textContent = 'Enter the exact existing native line ID and a quantity from 1 to 10.'; return; }
        retainedUpdate.disabled = true;
        try {
          var response = await Shopify.actions.updateCart({ cartId: checkedCartId, lines: [{ id: lineId, quantity: quantity }] });
          if (response.userErrors && response.userErrors.length) { retainedResult.textContent = JSON.stringify({ rejected: true, errors: response.userErrors.map(function (error) { return { code: error.code, message: error.message }; }) }, null, 2); return; }
          var readback = await Shopify.actions.getCart({ cartId: checkedCartId });
          showRetainedCart(readback.cart);
        } catch (_) { retainedResult.textContent = 'Could not confirm the update. Read the retained cart before trying again. No automatic retry.'; }
      });
      var result = document.getElementById('hs-image-result');
      var preview = document.getElementById('hs-image-preview');
      form.addEventListener('submit', async function (event) {
        event.preventDefault();
        var button = form.querySelector('button');
        if (button.disabled || !form.reportValidity()) return;
        var data = {
          customizationId: form.elements.customizationId.value,
          variantId: form.elements.variantId.value
        };
        var endpoint = new URL('/apps/heartside-artwork', location.origin);
        endpoint.search = new URLSearchParams(data).toString();
        button.disabled = true;
        result.textContent = 'Checking the saved design…';
        preview.hidden = true;
        var controller = new AbortController();
        var responseMeta = null;
        var timer = setTimeout(function () { controller.abort(); }, 32000);
        try {
          var response = await fetch(endpoint.href, {
            method: 'POST', credentials: 'same-origin', redirect: 'error',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data), signal: controller.signal
          });
          responseMeta = { httpStatus: response.status, contentType: response.headers.get('content-type') };
          if (!(response.headers.get('content-type') || '').includes('application/json')) throw new Error('Unexpected response type');
          var body = await response.json();
          result.textContent = JSON.stringify({ httpStatus: response.status, result: body }, null, 2);
          if (body.state === 'ready' && body.customizationId === data.customizationId && body.variantId === data.variantId && /^https:\/\/cdn\.shopify\.com\/s\/files\//.test(body.imageUrl || '')) {
            preview.src = body.imageUrl;
            preview.hidden = false;
          }
        } catch (error) {
          result.textContent = JSON.stringify({ checkCompleted: false, automaticRetry: false, response: responseMeta, errorType: error.name }, null, 2);
        } finally {
          clearTimeout(timer);
          button.disabled = false;
        }
      });
      var adapterForm = document.getElementById('hs-adapter-check');
      var adapterResult = document.getElementById('hs-adapter-result');
      var addButton = document.getElementById('hs-add-prepared');
      var preparedBody = null;
      adapterForm.addEventListener('input', function () { preparedBody = null; addButton.disabled = true; });
      adapterForm.addEventListener('submit', async function (event) {
        event.preventDefault();
        var button = adapterForm.querySelector('button');
        if (button.disabled || !adapterForm.reportValidity()) return;
        button.disabled = true; addButton.disabled = true; preparedBody = null;
        adapterResult.textContent = 'Preparing existing native data…';
        try {
          var original = JSON.parse(adapterForm.elements.payload.value);
          var before = original.items || [original];
          preparedBody = await window.HSCheckoutImage.prepare(JSON.stringify(original), {
            endpoint: '/apps/heartside-artwork', cdnPrefix: adapterForm.elements.prefix.value
          });
          var prepared = JSON.parse(preparedBody), after = prepared.items || [prepared];
          var preserved = before.every(function (item, i) {
            return item.id === after[i].id && item.quantity === after[i].quantity && Object.keys(item.properties).every(function (key) { return item.properties[key] === after[i].properties[key]; });
          });
          if (!preserved) throw new Error('Native data changed');
          adapterResult.textContent = JSON.stringify({ prepared: true, nativeDataPreserved: preserved, itemCount: after.length, propertyKeys: Object.keys(after[0].properties), imageUrl: after[0].properties._hs_checkout_image }, null, 2);
          addButton.disabled = false;
        } catch (error) {
          preparedBody = null;
          adapterResult.textContent = JSON.stringify({ prepared: false, cartChanged: false, message: error.message });
        } finally { button.disabled = false; }
      });
      addButton.addEventListener('click', async function () {
        if (!preparedBody || addButton.disabled) return;
        addButton.disabled = true;
        try {
          var cart = await fetch('{{ routes.cart_url }}.js', { credentials: 'same-origin', cache: 'no-store' }).then(function (r) { if (!r.ok) throw new Error('Cart read failed'); return r.json(); });
          if (cart.item_count !== 0) throw new Error('Existing cart is not empty; no item added');
          var added = await fetch('{{ routes.cart_add_url }}.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json' }, body: preparedBody });
          if (!added.ok) {
            var rejected = await added.json().catch(function () { return {}; });
            throw new Error('Cart add failed: ' + added.status + ' ' + String(rejected.description || rejected.message || '').slice(0,500));
          }
          adapterResult.textContent = JSON.stringify({ added: true, orderPlaced: false });
          preparedBody = null;
        } catch (error) { adapterResult.textContent = JSON.stringify({ added: false, message: error.message }); }
      });
    }());
  </script>
{% else %}
  <p>This diagnostic is available only in the private theme editor.</p>
{% endif %}
