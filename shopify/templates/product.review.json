    "policy": {
      "type": "hs2-policy",
      "blocks": {
        "p1": {
          "type": "policy",
          "settings": {
            "title": "A human checks every order",
            "text": "Before anything prints, a person looks at it. If the photo will not print well, we tell you first."
          }
        },
        "p2": {
          "type": "policy",
          "settings": {
            "title": "Misprinted? Remade free",
            "text": "Send a photo of the problem and we make it again. No forms, no hold music."
          }
        },
        "p3": {
          "type": "policy",
          "settings": {
            "title": "Every review gets published",
            "text": "We are new, so there are none yet. When they come in, good or bad, they go here."
          }
        }
      },
