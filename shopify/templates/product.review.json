    "faq": {
      "type": "hs2-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "My dog's photos are all blurry. Is that a problem?",
            "answer": "Send your best one. A person checks it before printing and tells you if it needs a better shot. You can also send it after you order."
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Can I order a review for a friend's dog?",
            "answer": "Yes. That is most of the fun. Fill in their dog and their name, and we ship it straight to them."
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Can I change what the review says?",
            "answer": "Within 12 hours of ordering, yes. After that, {dog} considers the matter closed."
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Where do you ship?",
            "answer": "Anywhere in the US, free."
          }
