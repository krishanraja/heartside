{%- render 'hs2-head' -%}
{%- assign s = section.settings -%}
<div class="hs2">
  <section id="benefits" class="hs2-wrap hs2-benefits" aria-labelledby="benefits-h-{{ section.id }}">
    <div class="hs2-benefits__head" data-hs2-reveal>
      <div class="hs2-eyebrow-stamp">{% render 'hs2-t', text: s.eyebrow %}</div>
      <h2 id="benefits-h-{{ section.id }}">{{ s.heading }}</h2>
      {%- if s.subheading != blank -%}<p class="hs2-benefits__sub">{% render 'hs2-t', text: s.subheading %}</p>{%- endif -%}
    </div>
    <div class="hs2-cards" data-hs2-carousel data-hs2-reveal data-hs2-group>
      {%- assign shown = 0 -%}
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- if b.hide -%}{%- continue -%}{%- endif -%}
        {%- assign link = '#review' -%}
        {%- if b.product != blank -%}{%- assign link = b.product.url | append: '?view=heartside' -%}{%- endif -%}
        <article class="hs2-card" style="--i: {{ shown }}" {{ block.shopify_attributes }}>
          {%- assign shown = shown | plus: 1 -%}
          <div class="hs2-card__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 90vw', alt: b.alt }}
            {%- else -%}
              {%- assign f640 = 'hs-photo-' | append: b.fallback | append: '-640.webp' -%}
              {%- assign f1200 = 'hs-photo-' | append: b.fallback | append: '-1200.webp' -%}
              <img src="{{ f640 | asset_url }}" srcset="{{ f640 | asset_url }} 640w, {{ f1200 | asset_url }} 1200w" sizes="(min-width: 900px) 25vw, 90vw" alt="{{ b.alt | escape }}" width="640" height="640" loading="lazy">
            {%- endif -%}
            {%- if b.shot != blank -%}<div class="hs2-card__shot">{{ b.shot }}</div>{%- endif -%}
            <div class="hs2-card__code">{{ b.code }}</div>
          </div>
          <div class="hs2-card__body">
            <h3>{{ b.name }}</h3>
            {%- if b.kind != blank -%}<div class="hs2-card__kind">{% render 'hs2-t', text: b.kind %}</div>{%- endif -%}
            <p>{% render 'hs2-t', text: b.copy %}</p>
            <div class="hs2-card__foot">
              <div class="hs2-card__price">{{ b.price }}</div>
              <a class="hs2-card__cta" href="{{ link }}"{% if b.product != blank %} data-hs2-carry{% endif %}>{% render 'hs2-t', text: b.cta %}</a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="hs2-carousel-nav" data-hs2-carousel-nav>
      <button type="button" data-hs2-carousel-step="-1" aria-label="Previous item"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
      <div class="hs2-carousel-dots" data-hs2-carousel-dots></div>
      <button type="button" data-hs2-carousel-step="1" aria-label="Next item"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "HS benefits package",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "YOUR BENEFITS PACKAGE, APPROVED BY {DOG}" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Company merchandise. Mandatory, in some cases." },
    { "type": "text", "id": "subheading", "label": "Plain line under the heading", "default": "More gifts made from your dog's photo. Free US shipping on every one." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "checkbox", "id": "hide", "label": "Hide this card", "info": "For a product that isn't on sale yet. The card keeps its settings.", "default": false },
        { "type": "product", "id": "product", "label": "Product", "info": "The link goes here with the shopper's answers. Empty links to the review builder." },
        { "type": "text", "id": "name", "label": "Name", "default": "The Body Double" },
        { "type": "text", "id": "kind", "label": "What it is, in plain words", "default": "Square photo pillow · 16 in" },
        { "type": "text", "id": "code", "label": "Item code", "default": "ITEM BD-01" },
        { "type": "text", "id": "price", "label": "Price", "default": "$59" },
        { "type": "textarea", "id": "copy", "label": "Copy", "info": "{dog} and {dogs} become the shopper's dog." },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Make the double" },
        { "type": "image_picker", "id": "image", "label": "Product shot", "info": "Printful mockup (assets/IMAGE-BRIEF.md items 10 to 15). Then clear the placeholder tag below." },
        { "type": "text", "id": "shot", "label": "Placeholder tag", "default": "[PRODUCT SHOT]" },
        {
          "type": "select", "id": "fallback", "label": "Stand-in photo until the product shot exists", "default": "asleep",
          "options": [
            { "value": "asleep", "label": "In a meeting (asleep on the laptop)" },
            { "value": "ornament-tree", "label": "Tiny Me on the tree (product photo)" },
            { "value": "pillow-sofa", "label": "The Body Double on the sofa (product photo)" },
            { "value": "team-01", "label": "Pug, head tilt" },
            { "value": "team-02", "label": "Doodle asleep at the desk" },
            { "value": "team-03", "label": "Golden at the desk" },
            { "value": "team-04", "label": "Golden on the rug" },
            { "value": "bed", "label": "Your side of the bed" },
            { "value": "window", "label": "The mailman watch" },
            { "value": "incident", "label": "The incident (sock)" },
            { "value": "vacuum", "label": "The vacuum standoff" },
            { "value": "manager", "label": "The manager (hero dachshund)" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Image description", "default": "A dog" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "HS benefits package" }]
}
{% endschema %}
