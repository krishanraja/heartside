{%- render 'hs2-head' -%}
{%- assign s = section.settings -%}
<div class="hs2">
  <section id="benefits" class="hs2-wrap hs2-benefits" aria-labelledby="benefits-h-{{ section.id }}">
    <div class="hs2-benefits__head">
      <div class="hs2-eyebrow-stamp">{% render 'hs2-t', text: s.eyebrow %}</div>
      <h2 id="benefits-h-{{ section.id }}">{{ s.heading }}</h2>
    </div>
    <div class="hs2-cards">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign link = '#review' -%}
        {%- if b.product != blank -%}{%- assign link = b.product.url -%}{%- endif -%}
        <article class="hs2-card" {{ block.shopify_attributes }}>
          <div class="hs2-card__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 90vw', alt: b.alt }}
            {%- else -%}
              {%- assign f800 = 'hs-photo-' | append: b.fallback | append: '-800.webp' -%}
              <img src="{{ f800 | asset_url }}" alt="{{ b.alt | escape }}" width="800" height="530" loading="lazy">
            {%- endif -%}
            {%- if b.shot != blank -%}<div class="hs2-card__shot">{{ b.shot }}</div>{%- endif -%}
            <div class="hs2-card__code">{{ b.code }}</div>
          </div>
          <div class="hs2-card__body">
            <h3>{{ b.name }}</h3>
            <p>{% render 'hs2-t', text: b.copy %}</p>
            <div class="hs2-card__foot">
              <div class="hs2-card__price">{{ b.price }}</div>
              <a class="hs2-card__cta" href="{{ link }}"{% if b.product != blank %} data-hs2-carry{% endif %}>{% render 'hs2-t', text: b.cta %}</a>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "HS benefits package",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "YOUR BENEFITS PACKAGE, APPROVED BY {DOG}" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Company merchandise. Mandatory, in some cases." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Benefit",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "The link goes here with the shopper's answers. Empty links to the review builder." },
        { "type": "text", "id": "name", "label": "Name", "default": "The Body Double" },
        { "type": "text", "id": "code", "label": "Item code", "default": "ITEM BD-01" },
        { "type": "text", "id": "price", "label": "Price", "default": "$59" },
        { "type": "textarea", "id": "copy", "label": "Copy", "info": "{dog} and {dogs} become the shopper's dog." },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Make the double" },
        { "type": "image_picker", "id": "image", "label": "Product shot", "info": "Printful mockup (assets/IMAGE-BRIEF.md items 10 to 15). Then clear the placeholder tag below." },
        { "type": "text", "id": "shot", "label": "Placeholder tag", "default": "[PRODUCT SHOT]" },
        {
          "type": "select", "id": "fallback", "label": "Stand-in photo until the product shot exists", "default": "golden-asleep",
          "options": [
            { "value": "golden-asleep", "label": "Golden puppy asleep" },
            { "value": "poodle", "label": "Red poodle" },
            { "value": "pug", "label": "Pug" },
            { "value": "maltipoo", "label": "Maltipoo" },
            { "value": "dachshund", "label": "Dachshund" }
          ]
        },
        { "type": "text", "id": "alt", "label": "Image description", "default": "A dog" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "HS benefits package" }]
}
{% endschema %}
