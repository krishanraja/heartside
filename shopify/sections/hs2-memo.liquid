{%- render 'hs2-head' -%}
{%- liquid
  assign s = section.settings
  # The order-by date shows only once it is confirmed in "Last order date for Christmas":
  # [DATE] in the memo becomes that date. Until then the bar shows the line without a date.
  assign msg = s.text
  assign when = s.deadline | strip
  if when != blank
    assign nice = when | date: '%B %-d'
    assign msg = msg | replace: '[DATE]', nice
  elsif msg contains '[DATE]'
    assign msg = s.text_undated
  endif
-%}
{%- comment -%}
  The memo bar also carries the store-wide dates that drive every countdown on the
  site (hs2.js reads them from data-* here): the confirmed last order date and the
  launch offer window. With no last order date, the countdowns count to Christmas
  morning, which is always true.
{%- endcomment -%}
<div class="hs2">
  <div class="hs2-memo" data-hs2-memo data-deadline="{{ s.deadline | strip | escape }}" data-offer-start="{{ s.offer_start | strip | escape }}" data-offer-end="{{ s.offer_end | strip | escape }}" data-offer-label="{{ s.offer_label | escape }}">
    <div class="hs2-memo__viewport">
      <div class="hs2-memo__track" data-hs2-ticker>
        <span class="hs2-memo__item"><span class="hs2-memo__msg">{% render 'hs2-t', text: msg %}</span><span class="hs2-memo__count" data-hs2-countdown="memo" hidden></span></span>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HS memo bar",
  "tag": "section",
  "class": "hs2-section",
  "enabled_on": { "templates": ["*"], "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Memo",
      "info": "One message: the order-by date and free shipping. [DATE] becomes the last order date below, once it is set.",
      "default": "Order by [DATE] for Christmas delivery. Free US shipping."
    },
    {
      "type": "text",
      "id": "text_undated",
      "label": "Memo until the last order date is set",
      "info": "Shows while the date below is empty, so the bar never shows [DATE].",
      "default": "Free US shipping on every order."
    },
    { "type": "header", "content": "Countdowns (whole site)" },
    {
      "type": "text",
      "id": "deadline",
      "label": "Last order date for Christmas",
      "info": "As YYYY-MM-DD, for example 2026-12-10. Only once Printful's dashboard confirms it. Empty: the countdowns count to Christmas morning instead."
    },
    {
      "type": "text",
      "id": "offer_start",
      "label": "Free video offer starts",
      "info": "YYYY-MM-DD. docs/V2-FROM-THE-DOG.md section 4: the read-aloud video is free with any order from 20 October to 1 November. Empty switches the offer off.",
      "default": "2026-10-20"
    },
    { "type": "text", "id": "offer_end", "label": "Free video offer ends (last day)", "default": "2026-11-01" },
    { "type": "text", "id": "offer_label", "label": "Offer wording on the read-aloud button", "default": "Free until November 1" }
  ],
  "presets": [{ "name": "HS memo bar" }]
}
{% endschema %}
