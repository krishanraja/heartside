{%- render 'hs2-head' -%}
{%- assign s = section.settings -%}
<div class="hs2">
  <section id="closure" class="hs2-wrap hs2-closure" aria-labelledby="closure-h-{{ section.id }}">
    <div class="hs2-closure__scene">
      <div class="hs2-closure__bg hs2-anim-drift" aria-hidden="true">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', sizes: '(min-width: 1180px) 1180px, 100vw', loading: 'lazy', alt: '' }}
        {%- else -%}
          <img src="{{ 'hs-photo-holiday-1600.webp' | asset_url }}" srcset="{{ 'hs-photo-holiday-960.webp' | asset_url }} 960w, {{ 'hs-photo-holiday-1600.webp' | asset_url }} 1600w"
            sizes="(min-width: 1180px) 1180px, 100vw" width="1600" height="900" loading="lazy" alt="">
        {%- endif -%}
      </div>
      <div class="hs2-closure__clock" data-hs2-clock hidden>
        <div class="hs2-closure__clock-label" data-hs2-clock-label>CHRISTMAS MORNING IN</div>
        <div class="hs2-closure__digits" role="timer" aria-live="off">
          <span><b data-hs2-clock-part="d">00</b><i>days</i></span>
          <span><b data-hs2-clock-part="h">00</b><i>hrs</i></span>
          <span><b data-hs2-clock-part="m">00</b><i>min</i></span>
          <span><b data-hs2-clock-part="s">00</b><i>sec</i></span>
        </div>
      </div>
      <div class="hs2-closure__box" data-hs2-reveal>
        <div class="hs2-closure__copy">
          <div class="hs2-closure__eyebrow">{{ s.eyebrow }}</div>
          <h2 id="closure-h-{{ section.id }}">{{ s.heading }}</h2>
          <p>{{ s.text }}</p>
          <p class="hs2-closure__missed">{% render 'hs2-t', text: s.missed %}</p>
        </div>
        <div class="hs2-closure__table">
          {%- for block in section.blocks -%}
            {%- if block.settings.hide -%}{%- continue -%}{%- endif -%}
            <div class="hs2-closure__row" {{ block.shopify_attributes }}><span>{% render 'hs2-t', text: block.settings.item %}</span><strong data-hs2-date>{{ block.settings.date }}</strong><em class="hs2-closure__left" data-hs2-left hidden></em></div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "HS Christmas order dates",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "Last order dates. Replace each [DATE] only once Printful's dashboard confirms it (docs/V2-FROM-THE-DOG.md section 5)." },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "CHRISTMAS ORDER DATES" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Last days to order for Christmas" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Everything is made after you order, so each item has its own deadline. These come from our maker. If they change, this table changes the same day." },
    { "type": "textarea", "id": "missed", "label": "Missed it", "default": "Missed it? The story card is free and instant, so {dog} still has something to say on Christmas morning. The poster follows." },
    { "type": "image_picker", "id": "image", "label": "Background photo", "info": "assets/IMAGE-BRIEF.md item 8. Empty uses holiday-party.jpg." }
  ],
  "blocks": [
    {
      "type": "deadline",
      "name": "Deadline",
      "settings": [
        { "type": "text", "id": "item", "label": "Item", "default": "The Body Double" },
        { "type": "checkbox", "id": "hide", "label": "Hide this row", "info": "For a product that isn't on sale yet.", "default": false },
        { "type": "text", "id": "date", "label": "Last order date", "default": "[DATE]" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [{ "name": "HS Christmas order dates" }]
}
{% endschema %}
