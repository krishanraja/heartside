{%- render 'hs2-head' -%}
{%- assign s = section.settings -%}
<div class="hs2">
  <section id="shop" class="hs2-wrap hs2-shop" aria-labelledby="shop-h-{{ section.id }}" data-hs2-shop>
    <div class="hs2-shop__head">
      {%- if s.eyebrow != blank -%}<div class="hs2-eyebrow-stamp">{% render 'hs2-t', text: s.eyebrow %}</div>{%- endif -%}
      <h2 id="shop-h-{{ section.id }}">{% render 'hs2-t', text: s.heading %}</h2>
      {%- if s.subheading != blank -%}<p class="hs2-shop__sub">{% render 'hs2-t', text: s.subheading %}</p>{%- endif -%}
    </div>
    <div class="hs2-shop__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign p = b.product -%}
        {%- if b.hide or p == blank -%}{%- continue -%}{%- endif -%}
        {%- assign url = p.url -%}
        {%- if b.view != blank -%}{%- assign url = url | append: '?view=' | append: b.view -%}{%- endif -%}
        <label class="hs2-shop__item" {{ block.shopify_attributes }}>
          <input type="checkbox" class="hs2-shop__check" data-hs2-shop-check
            data-price="{{ p.price }}" data-url="{{ url }}" data-title="{{ p.title | escape }}"{% if b.checked %} checked{% endif %}>
          <span class="hs2-shop__media">
            {%- if b.image != blank -%}
              {{ b.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 900px) 25vw, 46vw', alt: p.title }}
            {%- elsif b.fallback != blank and b.fallback != 'none' -%}
              {%- assign f640 = 'hs-photo-' | append: b.fallback | append: '-640.webp' -%}
              {%- assign f1200 = 'hs-photo-' | append: b.fallback | append: '-1200.webp' -%}
              <img src="{{ f640 | asset_url }}" srcset="{{ f640 | asset_url }} 640w, {{ f1200 | asset_url }} 1200w" sizes="(min-width: 900px) 25vw, 46vw" alt="{{ p.title | escape }}" width="640" height="640" loading="lazy">
            {%- elsif p.featured_media -%}
              {{ p.featured_media | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 900px) 25vw, 46vw', alt: p.title }}
            {%- endif -%}
            <span class="hs2-shop__tick" aria-hidden="true"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>
          </span>
          <span class="hs2-shop__body">
            <span class="hs2-shop__name">{{ p.title }}</span>
            {%- if b.kind != blank -%}<span class="hs2-shop__kind">{{ b.kind }}</span>{%- endif -%}
            <span class="hs2-shop__price">{{ p.price | money_without_trailing_zeros }}</span>
          </span>
        </label>
      {%- endfor -%}
    </div>
    <div class="hs2-shop__bar" data-hs2-shop-bar hidden>
      <div class="hs2-shop__bar-text">
        <strong data-hs2-shop-count></strong>
        <span><span data-hs2-shop-total></span> · Free US shipping</span>
      </div>
      <a class="hs2-btn" href="#shop" data-hs2-shop-go data-one="{{ s.cta_one | escape }}" data-many="{{ s.cta_many | escape }}">{{ s.cta_many }}</a>
    </div>
    {%- if s.hint != blank -%}<p class="hs2-shop__hint" data-hs2-shop-hint>{% render 'hs2-t', text: s.hint %}</p>{%- endif -%}
  </section>
</div>

{% schema %}
{
  "name": "HS shop",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "Every gift on one screen. Tapping a card picks it; the button takes the shopper to the first pick, and after each Add To Cart a bar offers the next one, with the photo and names carried over. {dog} and {dogs} become the shopper's dog." },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "EVERYTHING, ONE PHOTO" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick what you want. Personalize once." },
    { "type": "text", "id": "subheading", "label": "Plain line under the heading", "default": "Free US shipping, however many you choose." },
    { "type": "text", "id": "hint", "label": "Line under the grid", "default": "Tap to pick. You add the photo and names on the next screen." },
    { "type": "text", "id": "cta_one", "label": "Button, one picked", "default": "Personalize it" },
    { "type": "text", "id": "cta_many", "label": "Button, several picked", "default": "Personalize them" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Gift",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "kind", "label": "What it is, in plain words", "info": "One short line under the name, e.g. 12 × 18 in poster." },
        { "type": "image_picker", "id": "image", "label": "Photo", "info": "A lifestyle shot, 4:5. Empty uses the stand-in below, then the product's first photo." },
        {
          "type": "select", "id": "fallback", "label": "Stand-in photo", "default": "none",
          "options": [
            { "value": "none", "label": "None (use the product's first photo)" },
            { "value": "ornament-tree", "label": "Tiny Me on the tree" },
            { "value": "pillow-sofa", "label": "The Body Double on the sofa" },
            { "value": "manager", "label": "The manager (hero dachshund)" }
          ]
        },
        { "type": "text", "id": "view", "label": "Product page template", "info": "Opens the product with ?view=this. Empty uses its normal template." },
        { "type": "checkbox", "id": "checked", "label": "Picked to start", "default": false },
        { "type": "checkbox", "id": "hide", "label": "Hide this card", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "HS shop" }]
}
{% endschema %}
