{%- render 'hs-head' -%}
{%- assign s = section.settings -%}
<div class="hs hs-faq hs-section">
  <div class="hs-wrap hs-faq__grid">
    <div class="hs-faq__head" data-hs-reveal>
      {%- if s.eyebrow != blank -%}<p class="hs-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.text != blank -%}<div class="hs-muted">{{ s.text }}</div>{%- endif -%}
    </div>
    <div class="hs-faq__list" data-hs-reveal>
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="hs-faq__answer">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%} FAQ structured data, so search results can show the answers {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Heartside questions",
  "tag": "section",
  "class": "hs-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you order" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Something else? Email <a href=\"mailto:krish@heart-side.org\">krish@heart-side.org</a> and a person writes back.</p>" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer</p>" }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "Heartside questions" }]
}
{% endschema %}
