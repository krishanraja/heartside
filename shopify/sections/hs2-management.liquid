{%- render 'hs2-head' -%}
<div class="hs2">
  <section class="hs2-management" aria-label="A word from management">
    {%- assign img = section.settings.image -%}
    <figure class="hs2-management__photo hs2-anim-drift" aria-hidden="true">
      {%- if img != blank -%}
        {{ img | image_url: width: 1600 | image_tag: widths: '800, 1200, 1600', sizes: '(min-width: 1100px) 1000px, 100vw', loading: 'lazy', alt: section.settings.alt }}
      {%- else -%}
        <img src="{{ 'hs-photo-memo-1600.webp' | asset_url }}" srcset="{{ 'hs-photo-memo-960.webp' | asset_url }} 960w, {{ 'hs-photo-memo-1600.webp' | asset_url }} 1600w"
          sizes="(min-width: 1100px) 1000px, 100vw" width="1600" height="900" loading="lazy" alt="{{ section.settings.alt | escape }}">
      {%- endif -%}
    </figure>
    <div class="hs2-management__inner">
      <div class="hs2-management__eyebrow" data-hs2-reveal>{{ section.settings.eyebrow }}</div>
      {%- comment -%} Each paragraph lands on its own beat; the last one is the signature {%- endcomment -%}
      {%- assign paras = section.settings.memo | split: '<br><br>' -%}
      <div class="hs2-management__memo" data-hs2-reveal data-hs2-group>
        {%- for para in paras -%}
          <span class="hs2-memo-p{% if forloop.last %} hs2-memo-p--sign{% endif %}" style="--i: {{ forloop.index0 }}">{% render 'hs2-t', text: para %}</span>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "HS word from management",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "The tender turn. Approved copy, word for word." },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "A WORD FROM MANAGEMENT" },
    {
      "type": "html",
      "id": "memo",
      "label": "Memo",
      "default": "To {person}.<br><br>This year you were late four times. You waved at the mailman, which I consider treason. You once left for nine days and came back smelling of another dog.<br><br>You also came back. Every single time. I noticed.<br><br>Keep me close.<br>{dog}"
    },
    { "type": "image_picker", "id": "image", "label": "Photo under the memo", "info": "assets/IMAGE-BRIEF.md item 7. Empty uses memo-chest.jpg." },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A dachshund asleep on a blanket, a hand resting on its back" }
  ],
  "presets": [{ "name": "HS word from management" }]
}
{% endschema %}
