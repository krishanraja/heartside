{%- render 'hs-head' -%}
{%- liquid
  assign s = section.settings
  assign hs_url = s.button_link | default: '/collections/all'
  if s.product != blank
    assign hs_url = s.product.url
  endif
  assign hs_url2 = s.button2_link | default: '#maker'
-%}
<div class="hs hs-hero" data-hs-hero>
  <div class="hs-wrap hs-hero__grid">
    <div class="hs-hero__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1800 | image_tag:
          widths: '600, 900, 1200, 1500, 1800',
          sizes: '(min-width: 900px) 55vw, 100vw',
          class: 'hs-hero__photo',
          loading: 'eager',
          fetchpriority: 'high' }}
      {%- else -%}
        <img class="hs-hero__photo"
          src="{{ 'hs-photo-dachshund-1600.webp' | asset_url }}"
          srcset="{{ 'hs-photo-dachshund-800.webp' | asset_url }} 800w, {{ 'hs-photo-dachshund-1600.webp' | asset_url }} 1600w"
          sizes="(min-width: 900px) 55vw, 100vw"
          width="1600" height="1048" fetchpriority="high"
          alt="A chestnut dachshund resting its chin on the floor, looking up at the camera">
      {%- endif -%}
      {%- if s.ornament_image != blank -%}
        {{ s.ornament_image | image_url: width: 700 | image_tag: class: 'hs-hero__ornament', loading: 'eager', sizes: '(min-width: 900px) 22vw, 46vw' }}
      {%- else -%}
        <img class="hs-hero__ornament" src="{{ 'hs-ornament-dachshund.webp' | asset_url }}" width="760" height="819"
          alt="The ornament: a dachshund's photo in a watercolor heart, with the words Biscuit is my person">
      {%- endif -%}
    </div>

    <div class="hs-hero__copy">
      {%- if s.eyebrow != blank -%}<p class="hs-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h1>{{ s.heading }}</h1>
      {%- if s.text != blank -%}<p class="hs-lede">{{ s.text }}</p>{%- endif -%}
      {%- if s.show_price -%}
        {%- render 'hs-price', hs_product: s.product, fallback_cents: s.fallback_price, note: true -%}
      {%- endif -%}
      <div class="hs-hero__actions">
        <a class="hs-btn" href="{{ hs_url }}" data-hs-hero-cta>{{ s.button_label }}</a>
        {%- if s.button2_label != blank -%}
          <a class="hs-btn hs-btn--outline" href="{{ hs_url2 }}">{{ s.button2_label }}</a>
        {%- endif -%}
      </div>
      {%- if s.trust != blank -%}
        <p class="hs-hero__trust">
          <img src="{{ 'hs-heart.webp' | asset_url }}" alt="" width="18" height="17" loading="lazy">
          <span>{{ s.trust }}</span>
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Heartside hero",
  "tag": "section",
  "class": "hs-section",
  "settings": [
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Personalized ceramic ornament" },
    { "type": "inline_richtext", "id": "heading", "label": "Headline", "info": "One italic word, at most.", "default": "Put the real <em>favorite</em> on the tree." },
    { "type": "text", "id": "text", "label": "Subline", "default": "Their photo in our watercolor heart, their name underneath, and a note from them on the back." },
    { "type": "text", "id": "trust", "label": "Reassurance line", "default": "A person checks every photo before it prints." },
    { "type": "header", "content": "Product and price" },
    { "type": "product", "id": "product", "label": "Ornament product", "info": "Sets the button link and the price." },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "number", "id": "fallback_price", "label": "Price in cents if no product is chosen", "default": 3499 },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Make theirs" },
    { "type": "url", "id": "button_link", "label": "Main button link if no product is chosen" },
    { "type": "text", "id": "button2_label", "label": "Second button", "default": "Try their name on it" },
    { "type": "url", "id": "button2_link", "label": "Second button link", "info": "Leave empty to jump to the name preview below." },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Leave empty to use the dachshund that ships with these sections." },
    { "type": "image_picker", "id": "ornament_image", "label": "Ornament image", "info": "Leave empty to use the built-in render. Swap in a real product photo once the sample arrives." }
  ],
  "presets": [{ "name": "Heartside hero" }]
}
{% endschema %}
