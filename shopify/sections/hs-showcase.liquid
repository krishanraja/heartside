{%- comment -%}
  The example artwork, below the first screen (Krish, 30 Oct: bring the new breed examples in so they
  show the products off). Six stock-photo dogs, each painted in its own style by the store's painter
  (v15), approved 30 Oct. Every picture is an Example and is labeled so; none is a customer, an order,
  a review or a result. Pictures are built by tools/print-art/showcase-assets.py from
  design/examples-2026-10-30-showcase/site.json, one small file each. Behavior: assets/hs-showcase.js;
  without it every picture still shows. The journey's own steps hide this section.
  3 Nov (Krish: the phone homepage is two screens at most): the six sets moved up to be the first
  screen's hero (sections/hs-journey.liquid), the headings lost their extra lines, the credit is one line
  and the pinned button replaces the one that was here.
{%- endcomment -%}
{%- render 'hs2-head' -%}
{{ 'hs-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hs-showcase.js' | asset_url }}" defer="defer"></script>
{%- assign s = section.settings -%}
<section class="hss" data-hss aria-label="Examples">
  <div class="hss__wrap">
    <div class="hss-block hss-flow" data-hss-flow>
      <h2 class="hss-h3">{{ s.flow_heading }}</h2>
      <div class="hss-flow__stage" data-hss-stage>
        {%- render 'hs-showcase-fig', id: 'flow-photo', w: 720, h: 900, alt: 'Reference photo: a golden retriever sitting on a tiled floor.', eager: false -%}
        {%- render 'hs-showcase-fig', id: 'flow-painting', w: 720, h: 900, alt: 'Example painting of the same golden retriever in a play bow on a fleece blanket with a plush toy.' -%}
        {%- render 'hs-showcase-fig', id: 'flow-gift', w: 720, h: 900, alt: 'Example: the painting on a black-handled mug held in a hand.' -%}
      </div>
      <div class="hss-flow__ctl" data-hss-ctl hidden>
        <input type="range" min="0" max="2" step="0.01" value="1" aria-label="Photo, painting, gift" aria-valuetext="Painting" data-hss-range>
        <div class="hss-flow__steps">
          <button type="button" data-hss-step="0">Photo</button>
          <button type="button" data-hss-step="1">Painting</button>
          <button type="button" data-hss-step="2">Gift</button>
        </div>
      </div>
    </div>

    {%- comment -%}
      styles, gifts and moods in one row that drifts by on its own and runs faster under a flick
      (Krish, 31 Oct); without the script, or with reduced motion, it is a plain swipe row
    {%- endcomment -%}
    <div class="hss-block" data-hss-strip>
      <h2 class="hss-h3">{{ s.strip_heading }}</h2>
      <div class="hss-strip__view" data-hss-strip-view>
        <ul class="hss-strip" data-hss-strip-track>
          <li>{%- render 'hs-showcase-fig', id: 'style-painterly', w: 360, h: 450, alt: 'Example: Maple, a golden retriever, asleep on a rug with a plush toy, in painterly style. Sentimental.', caption: 'Painterly', sub: 'Maple' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'tone-paint-sentimental', w: 540, h: 675, alt: 'Example painting: Maple, a golden retriever, asleep on a rug with a plush toy. Sentimental.', caption: 'Sentimental', sub: 'Maple' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-mug-home', w: 540, h: 675, alt: 'Example: a golden retriever mug in a bright living room.', caption: 'Mug', sub: 'At home' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'style-cinematic', w: 360, h: 450, alt: 'Example: Bear, a black Labrador, in a truck window with a tennis ball and a red bandana, in cinematic style. Warm with a wink.', caption: 'Cinematic', sub: 'Bear' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'flow-gift', w: 720, h: 900, alt: 'Example: the painting on a black-handled mug held in a hand.', caption: 'Mug', sub: 'In the hand' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'tone-paint-warm', w: 540, h: 675, alt: 'Example painting: Maple, a golden retriever, in a play bow on a fleece blanket with a plush toy. Warm with a wink.', caption: 'Warm with a wink', sub: 'Maple' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-blanket-studio', w: 540, h: 675, alt: 'Example: a sherpa blanket printed with a scatter of small black Labradors, on a plain studio backdrop.', caption: 'Blanket', sub: 'Studio' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'style-comic', w: 360, h: 450, alt: 'Example: Bao, a French bulldog, asleep on a blanket with a blue bone toy, in comic book style. Sentimental.', caption: 'Comic book', sub: 'Bao' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-blanket-home', w: 540, h: 675, alt: 'Example: a sherpa blanket printed with a scatter of small black Labradors, in a bright living room.', caption: 'Blanket', sub: 'At home' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'style-screenprint', w: 360, h: 450, alt: 'Example: Clover, a goldendoodle, resting on a red disc under a hand, in vintage screenprint. Sentimental.', caption: 'Vintage screenprint', sub: 'Clover' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-blanket-hand', w: 540, h: 675, alt: 'Example: a sherpa blanket printed with a scatter of small black Labradors, held in hand.', caption: 'Blanket', sub: 'In the hand' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'tone-paint-hilarious', w: 540, h: 675, alt: 'Example painting: Maple, a golden retriever, in a scatter of silly poses with a plush toy. Hilarious.', caption: 'Hilarious', sub: 'Maple' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-portrait-studio', w: 540, h: 675, alt: 'Example: a framed portrait of a black Labrador in a truck window, on a plain studio backdrop.', caption: 'Portrait', sub: 'Studio' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'style-ink', w: 360, h: 450, alt: 'Example: Frank, a dachshund in a green sweater on a wooden chair holding a bone, in fine ink drawing. Warm with a wink.', caption: 'Fine ink drawing', sub: 'Frank' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-portrait-home', w: 540, h: 675, alt: 'Example: a framed portrait of a black Labrador in a truck window, in a bright living room.', caption: 'Portrait', sub: 'At home' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'tone-paint-over', w: 540, h: 675, alt: 'Example painting: Maple, a golden retriever, enthroned on a rug in a spotlight. Over the top.', caption: 'Over the top', sub: 'Maple' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'style-collage', w: 360, h: 450, alt: 'Example: Juno, a German shepherd bounding through a meadow, in cut-paper collage. Hilarious.', caption: 'Cut-paper collage', sub: 'Juno' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-portrait-hand', w: 540, h: 675, alt: 'Example: a framed portrait of a black Labrador in a truck window, held in hand.', caption: 'Portrait', sub: 'In the hand' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'scene-mug-studio', w: 540, h: 675, alt: 'Example: a golden retriever mug on a plain studio backdrop.', caption: 'Mug', sub: 'Studio' -%}</li>
        </ul>
      </div>
      <div class="hss-ctl hss-ctl--strip" data-hss-strip-ctl hidden>
        <button type="button" class="hss-pause" data-hss-pause aria-pressed="false" aria-label="Pause"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path class="hss-pause__bars" d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/><path class="hss-pause__play" d="M8 5l11 7-11 7z" fill="currentColor"/></svg></button>
      </div>
    </div>

    <details class="hss-credit"><summary>{{ s.credit_short }}</summary><p>{{ s.credit }}</p></details>
  </div>
</section>

{% schema %}
{
  "name": "HS showcase",
  "tag": "section",
  "class": "hss-section",
  "settings": [
    { "type": "paragraph", "content": "The example artwork under the first screen. Every picture is an Example: a stock-photo dog painted by the store's painter, never a customer or an order." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (retired 3 Nov, not shown)", "default": "Examples" },
    { "type": "text", "id": "heading", "label": "Heading (retired 3 Nov, not shown)", "default": "Your dog, on the gift" },
    { "type": "textarea", "id": "intro", "label": "Intro (retired 3 Nov, not shown)", "default": "Every picture here is an Example, painted from a photo the way yours will be." },
    { "type": "text", "id": "flow_heading", "label": "Photo to gift heading", "default": "From a photo to a gift" },
    { "type": "text", "id": "flow_note", "label": "Photo to gift note (retired 3 Nov, not shown)", "default": "Drag from the photo to the painting to the mug. Maple, an Example." },
    { "type": "text", "id": "strip_heading", "label": "Styles, gifts and moods heading", "default": "Styles, gifts and moods" },
    { "type": "text", "id": "strip_note", "label": "Styles, gifts and moods note (retired 3 Nov, not shown)", "default": "Every style is painted from your photo, and you choose how it sounds. Flick to go faster." },
    { "type": "text", "id": "sets_heading", "label": "Sets heading (retired 3 Nov, not shown)", "default": "A set for one dog" },
    { "type": "text", "id": "sets_note", "label": "Sets note (retired 3 Nov, not shown)", "default": "One painting of your dog, on a mug, a blanket and a framed portrait. Each gift comes in its own box, with your note inside. Six dogs, one at a time; swipe to skip." },
    { "type": "text", "id": "credit_short", "label": "Photo credit, one line", "default": "Reference photos: Pexels" },
    { "type": "text", "id": "credit", "label": "Photo credit, in full (opens from the line)", "default": "Reference photos from Pexels (Gundula Vogel, Genadi Yakovlev, Marino Kurunić, Oliver Morgan Media, Sharon Snider, Sabine Kosters), used under the Pexels License." },
    { "type": "text", "id": "cta", "label": "Button (retired 3 Nov, not shown)", "default": "Make one for my dog" }
  ],
  "presets": [{ "name": "HS showcase" }]
}
{% endschema %}
