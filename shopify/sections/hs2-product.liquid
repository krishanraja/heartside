{%- render 'hs2-head' -%}
{%- render 'hs-schema', kind: 'product', product: product -%}
{%- liquid
  assign s = section.settings
  assign native_artwork = s.blanket_purchase
  if s.native_artwork_kind != blank and s.native_artwork_kind != 'off'
    assign native_artwork = true
  endif
  assign current = product.selected_or_first_available_variant
  assign artwork_preview = s.city_art_preview
  if s.blanket_art_preview or s.mug_art_preview
    assign artwork_preview = true
  endif

  # Teeinblue's app block brings its own variant picker and add to cart, and only its button
  # attaches the print file. When it is on the page, ours stand down.
  assign tib = false
  # Each description block can name a product. The one for this product wins, then one for any
  # product, then the product's own description (Teeinblue overwrites that with Printful's text).
  # (block positions, not IDs: Shopify generates the IDs)
  assign desc_pick = 0
  assign desc_any = 0
  assign desc_first = 0
  # v3 gifts (the buy block's v3 setting) get the one-screen gift page (hs2.css "gift view")
  assign v3 = false
  for b in section.blocks
    if b.type == '@app'
      assign tib = true
    endif
    if b.type == 'buy' and b.settings.v3
      assign v3 = true
    endif
    if b.type == 'description'
      if desc_first == 0
        assign desc_first = forloop.index
      endif
      if b.settings.text != blank
        if b.settings.product != blank and b.settings.product.id == product.id and desc_pick == 0
          assign desc_pick = forloop.index
        elsif b.settings.product == blank and desc_any == 0
          assign desc_any = forloop.index
        endif
      endif
    endif
  endfor
  if desc_pick == 0
    assign desc_pick = desc_any
  endif

  # Plain names for the options shoppers choose, from "Color: Frame | Size: Size"
  assign label_from = ''
  assign label_to = ''
  assign pairs = s.option_labels | split: '|'
  for pair in pairs
    assign kv = pair | split: ':'
    if kv.size == 2
      assign k0 = kv[0] | strip | downcase
      assign k1 = kv[1] | strip
      assign label_from = label_from | append: '|' | append: k0
      assign label_to = label_to | append: '|' | append: k1
    endif
  endfor
  assign label_from = label_from | remove_first: '|' | split: '|'
  assign label_to = label_to | remove_first: '|' | split: '|'

  # Options with more than one value are the only real choices
  assign choice_positions = ''
  assign choice_label = ''
  for opt in product.options_with_values
    if opt.values.size > 1
      assign choice_positions = choice_positions | append: ',' | append: opt.position
      assign nice = opt.name
      assign key = opt.name | downcase
      for f in label_from
        if f == key
          assign nice = label_to[forloop.index0]
        endif
      endfor
      if choice_label != ''
        assign choice_label = choice_label | append: ' / '
      endif
      assign choice_label = choice_label | append: nice
    endif
  endfor
  assign choice_positions = choice_positions | remove_first: ',' | split: ','
-%}
{%- comment -%}
  Tell Teeinblue where this template keeps its gallery and its form, so its live preview
  lands in the media column and its add to cart carries our hidden answers. Settings a
  theme or app sets elsewhere win.
{%- endcomment -%}
<script>
  window.teeinblue = Object.assign({ gallerySelector: '[data-hs2-tib-gallery]', gallerySetupMethod: 'append', formSelector: '#hs2-product-form' }, window.teeinblue || {});
</script>

<div class="hs2">
  {%- comment -%} Clear the header before the first paint (audit, 30 Oct): Helio draws its header row as an
    overlay, and hs2.js clearHeader padded the page for it only at DOMContentLoaded, after the page had
    drawn, so everything dropped about 100 px (layout shift 0.12 on phones, 0.43 on desktop). Same measure
    and the same 12 px as clearHeader, so its later run finds nothing to change. {%- endcomment -%}
  <script>
    (function (box) {
      try {
        var header = document.querySelector('.header-section, header.shopify-section');
        if (!box || !header || window.scrollY > 10) return;
        // journey mode hides the store header (hs-journey-choose.css), so there is nothing to clear
        if (/[?&]journey=1/.test(location.search)) return;
        for (var i = 0; i < sessionStorage.length; i++) if (/^hs2-journey-on:/.test(sessionStorage.key(i))) return;
        var top = box.getBoundingClientRect().top, bottom = header.getBoundingClientRect().bottom;
        header.querySelectorAll('header-component, .header__row, .header__underlay').forEach(function (el) { var r = el.getBoundingClientRect(); if (r.width && r.height) bottom = Math.max(bottom, r.bottom); });
        bottom = Math.min(bottom, top + 200);
        if (bottom > top) box.style.paddingTop = Math.ceil(bottom - top + 12) + 'px';
        document.documentElement.style.setProperty('--hs2-clear', Math.max(0, Math.ceil(bottom)) + 'px');
      } catch (e) { /* hs2.js clearHeader still runs */ }
    })(document.currentScript.closest('.shopify-section'));
  </script>
  {%- capture option_labels -%}{ {%- for f in label_from -%}{{ f | handleize | json }}: {{ label_to[forloop.index0] | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }{%- endcapture -%}
  <div class="hs2-wrap hs2-product{% if tib %} hs2-product--tib{% endif %}{% if s.photo_shape == 'portrait' %} hs2-product--portrait{% endif %}" id="buy" data-hs2-checkout-image-enabled="{{ s.checkout_image_enabled }}" data-hs2-checkout-image-endpoint="{{ s.checkout_image_endpoint | escape }}" data-hs2-checkout-image-cdn-prefix="{{ s.checkout_image_cdn_prefix | escape }}"{% if v3 %} data-hs2-v3{% endif %}{% if artwork_preview %} data-hs2-city-art-preview{% endif %}{% if s.blanket_art_preview %} data-hs2-blanket-art-preview{% endif %}{% if s.blanket_purchase %} data-hs2-blanket-purchase{% endif %}{% if s.native_artwork_kind != blank and s.native_artwork_kind != 'off' %} data-hs2-artwork-kind="{{ s.native_artwork_kind }}" data-hs2-purchase-enabled="{{ s.native_purchase_enabled }}"{% endif %}{% if s.mug_art_preview %} data-hs2-mug-art-preview{% endif %} data-hs2-option-labels="{{ option_labels | escape }}">
    {%- comment -%} journey mode: the painting on every gift, the bundle, one tick, one button {%- endcomment -%}
    {%- if native_artwork -%}{% render 'hs-journey-choose', s: s, product: product %}{%- endif -%}

    {% if s.mug_art_preview %}
    <figure class="hs-art-wrap-reference">
      <img src="{{ 'hs-mug-wrap-reference.png' | asset_url }}" alt="Existing mug wrap concept: a large painted pug scene with a short handwritten note beside it" width="2011" height="782" fetchpriority="high">
      <figcaption>Existing wrap concept. This is an art-direction reference, not your generated dog or an approved print file.</figcaption>
    </figure>
    {% else %}
    {% render 'hs-product-gallery', product: product, current: current, s: s, tib: tib, v3: v3, artwork_preview: artwork_preview %}

    {% endif %}
    <div class="hs2-product__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'stamp' -%}
            <div class="hs2-stamp" style="align-self: flex-start; transform: rotate(-2deg);" {{ block.shopify_attributes }}>{% render 'hs2-t', text: block.settings.text %}</div>
          {%- when 'title' -%}
            <h1 {{ block.shopify_attributes }}>{{ product.title }}</h1>
          {%- when 'price' -%}
            {% if artwork_preview %}
              <p class="hs-art-draft-status">Draft review only. Artwork generation and ordering are paused. Price is not approved.</p>
            {% else %}
            <div {{ block.shopify_attributes }}>
              <div class="hs2-product__price" data-hs2-price>{{ current.price | money_without_trailing_zeros }}</div>
              {%- comment -%} a product with framed and unframed variants says both prices, from Shopify {%- endcomment -%}
              {%- assign framed_min = '' -%}{%- assign unframed_min = '' -%}
              {%- for v in product.variants -%}
                {%- if v.options contains 'Framed' and framed_min == '' -%}{%- assign framed_min = v.price -%}{%- endif -%}
                {%- if v.options contains 'Unframed' and unframed_min == '' -%}{%- assign unframed_min = v.price -%}{%- endif -%}
              {%- endfor -%}
              {%- if framed_min != '' and unframed_min != '' -%}<div class="hs2-product__formats">Unframed {{ unframed_min | money_without_trailing_zeros }} · Framed {{ framed_min | money_without_trailing_zeros }}</div>{%- endif -%}
              {%- unless product.has_only_default_variant -%}
                <script type="application/json" data-hs2-prices>{ {%- for v in product.variants -%}{{ v.id | append: '' | json }}: {{ v.price | money_without_trailing_zeros | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} }</script>
                {%- comment -%} each variant's own photo, so the picture follows the color chosen in Teeinblue {%- endcomment -%}
                <script type="application/json" data-hs2-vimages>{ {%- assign vi = 0 -%}{%- assign v_hide = section.settings.hide_media_alt | default: 'shown in your cart' | downcase -%}{%- for v in product.variants -%}{%- assign v_alt = v.featured_media.alt | downcase -%}{%- assign v_mid = v.featured_media.id | append: '' -%}{%- if v.featured_media -%}{%- unless v_alt contains v_hide or v_alt contains 'blank ' or v_alt contains 'checkout tile' or v_mid == '71850515169662' or v_mid == '71856697049470' -%}{%- if vi > 0 -%},{%- endif -%}{%- assign vi = vi | plus: 1 -%}{{ v.id | append: '' | json }}: { "src": {{ v.featured_media | image_url: width: 1200 | json }}, "alt": {{ v.featured_media.alt | default: product.title | json }} }{%- endunless -%}{%- endif -%}{%- endfor -%} }</script>
              {%- endunless -%}
              {%- if block.settings.note != blank -%}<div class="hs2-product__ship">{{ block.settings.note }}</div>{%- endif -%}
              <div class="hs2-product__when" data-hs2-countdown="product"></div>
              {%- comment -%} the strongest reassurance on the site, beside the price (audit, 30 Oct) {%- endcomment -%}
              {%- if native_artwork -%}<p class="hs2-product__promise">A person checks every order before it prints. Misprinted or damaged? Full refund or a free remake.</p>{%- endif -%}
            </div>
            {%- comment -%} name and price first, then the one way in (audit, 30 Oct: the price sat a screen and a half down) {%- endcomment -%}
            {%- if native_artwork -%}{% render 'hs-journey', s: s %}{%- endif -%}
            {% endif %}
          {%- when 'description' -%}
            {%- if desc_pick > 0 -%}
              {%- if forloop.index == desc_pick -%}
                <div class="hs2-product__desc" {{ block.shopify_attributes }}>{% render 'hs2-t', text: block.settings.text %}</div>
              {%- endif -%}
            {%- elsif forloop.index == desc_first -%}
              <div class="hs2-product__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}
          {%- when 'answers' -%}
            {% if artwork_preview or native_artwork %}<div class="hs-art-choices" id="hs-art-choices" data-hs-art-choices></div>{% endif %}
            {% if native_artwork %}{% render 'hs-native-artwork', settings: s %}{% endif %}
            {%- comment -%} The review's answers, short. Once they are in Teeinblue's preview, its copies of
              them fold away and "Edit details" opens them again. {%- endcomment -%}
            <div class="hs2-answers" data-hs2-answers hidden {{ block.shopify_attributes }}>
              <div class="hs2-answers__top">
                <div class="hs2-answers__title">{{ block.settings.title }}</div>
              {% unless native_artwork %}<button type="button" class="hs2-answers__edit" data-hs2-tib-edit aria-expanded="false" hidden>Edit details</button>{% endunless %}
              </div>
              <p class="hs2-answers__who">From <strong data-hs2="dog"></strong><span data-hs2-person-wrap hidden> to <strong data-hs2="person"></strong></span></p>
              {%- if block.settings.picks -%}
                <p class="hs2-answers__picks"><span data-hs2="improvement">Leaving</span> · <span data-hs2="incident">The sock</span> · <span data-hs2="enemy">The mailman</span> · <span data-hs2="cupboard">1,412</span> treats</p>
              {%- endif -%}
              {%- if block.settings.note != blank -%}<div class="hs2-answers__note" data-hs2-bridge-note>{{ block.settings.note }}</div>{%- endif -%}
              <div class="hs2-answers__status" data-hs2-bridge-status role="status" aria-live="polite" hidden></div>
              {% if s.blanket_art_preview %}
                <p>Inspired by what you told Buddy. No words on the blanket.</p>
                <p data-hs2-artwork-status role="status">Preview only. Check their face, markings and personality.</p>
                <a data-hs2-artwork-source data-hs2-artwork-layer="layer-292294" target="_blank" rel="noopener noreferrer" hidden>View artwork</a>
              {% elsif s.city_art_preview %}
                <p><span data-hs2-artwork-city>Somewhere quiet</span> · <button type="button" class="hs2-answers__edit" data-hs2-artwork-edit-city>Change place</button></p>
                <p data-hs2-artwork-status role="status">Preview only. Check your dog, city and note before release.</p>
                <a data-hs2-artwork-source data-hs2-artwork-layer="layer-747218" target="_blank" rel="noopener noreferrer" hidden>View artwork</a>
              {% endif %}
              <div class="hs2-answers__photo" data-hs2-handoff hidden>
                <img src="{{ 'hs-photo-headshot-480.webp' | asset_url }}" alt="" width="56" height="56" loading="lazy" data-hs2-handoff-img>
                <button type="button" data-hs2-handoff-btn>{% render 'hs2-t', text: block.settings.photo_button %}</button>
              </div>
            </div>
            {%- unless s.show_poster -%}
              {% render 'hs2-lines', kind: 'improvement', mode: 'json' %}
              {% render 'hs2-lines', kind: 'incident', mode: 'json' %}
              {% render 'hs2-lines', kind: 'enemy', mode: 'json' %}
            {%- endunless -%}
          {%- when '@app' -%}
            {% render block %}
          {%- when 'buy' -%}
            <div {{ block.shopify_attributes }}>
              {%- form 'product', product, id: 'hs2-product-form', novalidate: 'novalidate' -%}
                {%- if tib or choice_positions.size == 0 -%}
                  <input type="hidden" name="id" value="{{ current.id }}" data-hs2-variant-id>
                {%- else -%}
                  <div class="hs2-variant">
                    <label for="hs2-variant-{{ section.id }}">{{ choice_label }}</label>
                    <select id="hs2-variant-{{ section.id }}" name="id" data-hs2-variant>
                      {%- for v in product.variants -%}
                        {%- capture v_name -%}
                          {%- for pos in choice_positions -%}{%- assign i = pos | minus: 1 -%}{{ v.options[i] }}{%- unless forloop.last %} / {% endunless -%}{%- endfor -%}
                        {%- endcapture -%}
                        <option value="{{ v.id }}" data-price="{{ v.price | money_without_trailing_zeros }}" data-available="{{ v.available }}"{% if v.id == current.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v_name | strip }}{% unless v.available %} (gone for now){% endunless %}</option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endif -%}
                {%- if native_artwork -%}
                  {% unless s.blanket_purchase %}<input type="hidden" name="properties[_hs_lines]" data-hs2-prop="hs_lines" value="">{% endunless %}
                  <input type="hidden" name="properties[_hs_art_profile]" data-hs2-prop="personality" value="">
                  <input type="hidden" name="properties[_hs_art_style]" data-hs2-prop="art_style" value="">
                  <input type="hidden" name="properties[_hs_art_tone]" data-hs2-prop="art_tone" value="">
                  {%- comment -%} what the buyer told Buddy and who it ships to, for the person who checks the order:
                    they never reached a native order before (28 Oct, orders #1005 to #1008). hs2.js syncBlanketProperties fills them. {%- endcomment -%}
                  <input type="hidden" name="properties[_hs_answers]" data-hs2-prop="hs_answers" value="">
                  <input type="hidden" name="properties[_hs_ship_to]" data-hs2-prop="hs_ship_to" value="">
                {%- elsif block.settings.v3 -%}
                  {%- comment -%} v3 gifts: what the buyer told Buddy and the words on the gift, for the person who checks the order {%- endcomment -%}
                  <input type="hidden" name="properties[_hs_answers]" data-hs2-prop="hs_answers" value="">
                  <input type="hidden" name="properties[_hs_lines]" data-hs2-prop="hs_lines" value="">
                  <input type="hidden" name="properties[_hs_ship_to]" data-hs2-prop="hs_ship_to" value="">
                {%- else -%}
                <input type="hidden" name="properties[_Manager]" data-hs2-prop="dog" value="">
                <input type="hidden" name="properties[_Employee]" data-hs2-prop="person" value="">
                <input type="hidden" name="properties[_Treat cupboard]" data-hs2-prop="cupboard" value="">
                <input type="hidden" name="properties[_Improvement]" data-hs2-prop="improvement" value="">
                <input type="hidden" name="properties[_Incident]" data-hs2-prop="incident" value="">
                <input type="hidden" name="properties[_Enemy]" data-hs2-prop="enemy" value="">
                <input type="hidden" name="properties[_Read-aloud video]" data-hs2-prop="voice" value="">
                {%- endif -%}
                {%- unless tib -%}
                  <button type="{% if artwork_preview %}button{% else %}submit{% endif %}" name="add" class="hs2-btn" data-hs2-add{% if artwork_preview or current.available == false %} disabled{% endif %}>
                    {%- if artwork_preview -%}Preview only{%- elsif current.available -%}{{ block.settings.label }}{%- else -%}Gone for now. We'll tell you when it's back.{%- endif -%}
                  </button>
                {%- endunless -%}
              {%- endform -%}
            </div>
          {%- when 'upsell' -%}
            {%- comment -%} A quiet link to another version (the framed poster from the plain one). It shows
              its own price and reads as a link, so it never competes with Add To Cart. Hidden on the
              product it points to. {%- endcomment -%}
            {%- assign up = block.settings.product -%}
            {%- if up != blank and up.id != product.id -%}
              <a class="hs2-upsell" href="{{ up.url }}?view={{ block.settings.view | default: 'review' }}" data-hs2-carry {{ block.shopify_attributes }}>
                {%- if up.featured_media -%}<img src="{{ up.featured_media | image_url: width: 160 }}" alt="" width="56" height="56" loading="lazy">{%- endif -%}
                <span class="hs2-upsell__text">
                  <span class="hs2-upsell__title">{% render 'hs2-t', text: block.settings.title %} <strong>{{ up.price | money_without_trailing_zeros }}</strong></span>
                  {%- if block.settings.note != blank -%}<span class="hs2-upsell__note">{{ block.settings.note }}</span>{%- endif -%}
                </span>
                <svg class="hs2-upsell__go" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}
          {%- when 'fine' -%}
            <div class="hs2-product__fine" {{ block.shopify_attributes }}>
              {%- if block.settings.line_ai != blank -%}<div>{{ block.settings.line_ai }}</div>{%- endif -%}
              {%- if block.settings.line_1 != blank -%}<div>{{ block.settings.line_1 }}</div>{%- endif -%}
              {%- if block.settings.line_2 != blank -%}<div>{{ block.settings.line_2 }}</div>{%- endif -%}
              {%- if block.settings.link_label != blank -%}<div><a href="{{ routes.root_url }}#closure">{{ block.settings.link_label }}</a></div>{%- endif -%}
              {%- comment -%} the gift view is one screen with no footer, so the policies live here (Krish, 21 Oct) {%- endcomment -%}
              {%- if v3 -%}
                <div class="hs2-product__legal">
                  {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a> · {% endif -%}
                  {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Terms</a> · {% endif -%}
                  {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a> · {% endif -%}
                  {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Refunds</a>{% endif -%}
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HS product",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "select", "id": "native_artwork_kind", "label": "Native artwork format", "options": [{"value":"off","label":"Off"},{"value":"mug","label":"Illustrated mug"},{"value":"print","label":"Portrait family"}], "default":"off" },
    { "type": "checkbox", "id": "native_purchase_enabled", "label": "Enable tested native artwork ordering", "default": false },
    { "type": "checkbox", "id": "checkout_image_enabled", "label": "Prepare personal checkout image", "default": false },
    { "type": "text", "id": "checkout_image_endpoint", "label": "Checkout image registration endpoint", "info": "Same-store /apps/ proxy path. Enable only after the secured endpoint and checkout transformation pass testing." },
    { "type": "text", "id": "checkout_image_cdn_prefix", "label": "Store's Shopify Files URL prefix", "info": "Exact https://cdn.shopify.com/s/files/1/.../files/ prefix for this store." },
    { "type": "checkbox", "id": "blanket_purchase", "label": "Native word-free blanket", "info": "Explicit native photo upload, shared art choices and Buddy facts. Enable only on the linked word-free blanket product.", "default": false },
    { "type": "checkbox", "id": "city_art_preview", "label": "City artwork acceptance preview", "info": "Isolated draft only. Disables ordering and automatic photo submission while artwork checks are pending.", "default": false },
    { "type": "checkbox", "id": "blanket_art_preview", "label": "Personality blanket acceptance preview", "info": "Isolated draft only. Uses chat facts and blocks ordering while likeness and production checks are pending.", "default": false },
    { "type": "checkbox", "id": "mug_art_preview", "label": "Illustrated mug acceptance preview", "info": "Shows the existing wrap reference with shared choices. No image generation or ordering.", "default": false },
    { "type": "checkbox", "id": "show_poster", "label": "Show the live review poster", "info": "On for the Annual Review products. It fills in from the shopper's homepage answers.", "default": false },
    {
      "type": "select", "id": "open_on", "label": "Gallery opens on", "default": "preview",
      "options": [
        { "value": "preview", "label": "The live preview" },
        { "value": "photo", "label": "The photo, then the preview once one is added" }
      ]
    },
    {
      "type": "select", "id": "photo_shape", "label": "Photo shape", "default": "square",
      "options": [ { "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait, 4:5" } ]
    },
    { "type": "text", "id": "shot", "label": "Placeholder tag when the product has no images", "default": "[PRODUCT SHOT]" },
    { "type": "text", "id": "option_labels", "label": "Plain names for product options", "info": "Option: name, split by |. Options with one value are hidden. Example: Color: Frame | Size: Size", "default": "Size: Size" },
    { "type": "select", "id": "media_ratio", "label": "Photo box shape", "default": "1", "options": [ { "value": "1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait, 4:5" } ] },
    { "type": "text", "id": "hide_media_alt", "label": "Hide photos whose alt text contains", "info": "The blank technical reference, for example. Its picture still appears in the cart.", "default": "shown in your cart" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "stamp", "name": "Stamp", "limit": 1, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "MADE FOR {DOG}" } ] },
    { "type": "title", "name": "Title", "limit": 1, "settings": [] },
    { "type": "price", "name": "Price", "limit": 1, "settings": [ { "type": "text", "id": "note", "label": "Note under the price", "default": "Free US shipping on every order." } ] },
    {
      "type": "description", "name": "Description",
      "settings": [
        { "type": "paragraph", "content": "Teeinblue overwrites the product description with Printful's text on every campaign update, so write ours here, in the dog's voice. Add one block per product. Empty everywhere shows the product's own description." },
        { "type": "product", "id": "product", "label": "For product", "info": "Empty applies to every product on this template." },
        { "type": "richtext", "id": "text", "label": "Description", "info": "Tokens: {dog}, {dogs}, {person}." }
      ]
    },
    {
