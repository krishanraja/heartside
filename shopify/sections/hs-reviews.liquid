{%- comment -%}
  What people say: an auto-rotating carousel of customer quotes under the showcase (Krish, 10 Nov 2026).
  Each quote is a block, in the person's own words as Krish gave them: people who used the site or received
  Heartside products made by hand before it. A block's photo is optional: without one the card shows
  the person's initials, and adding their photo in the theme editor replaces them. No star ratings
  or counts are shown. Behaviour: assets/hs-reviews.js (rotates every 6 s, pauses on hover, focus, touch, a
  hidden tab and the Pause button; never moves under reduced motion). Tests: tools/preview/reviews.browser.test.mjs.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
{{ 'hs-reviews.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hs-reviews.js' | asset_url }}" defer="defer"></script>
<section class="hsr" data-hsr data-hsr-seconds="{{ section.settings.seconds }}" aria-roledescription="carousel" aria-label="{{ section.settings.heading | escape }}">
  <div class="hsr__wrap">
    <div class="hsr__head">
      <div>
        <h2 class="hsr__title">{{ section.settings.heading }}</h2>
        {%- if section.settings.lead != blank -%}<p class="hsr__lead">{{ section.settings.lead }}</p>{%- endif -%}
      </div>
      <div class="hsr__ctl" data-hsr-ctl hidden>
        <button type="button" class="hsr__btn" data-hsr-prev aria-label="Previous review"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="hsr__btn" data-hsr-pause aria-pressed="false" aria-label="Pause the reviews"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path class="hsr__bars" d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/><path class="hsr__play" d="M8 5l11 7-11 7z" fill="currentColor"/></svg></button>
        <button type="button" class="hsr__btn" data-hsr-next aria-label="Next review"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
    <ul class="hsr__track" data-hsr-track aria-live="off">
      {%- for b in section.blocks -%}
        {%- assign who = b.settings.name | strip -%}
        {%- assign parts = who | split: ' ' -%}
        {%- capture initials -%}{{ parts.first | slice: 0 }}{%- if parts.size > 1 -%}{{ parts.last | slice: 0 }}{%- endif -%}{%- endcapture -%}
        <li class="hsr__card" data-hsr-card role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}" {{ b.shopify_attributes }}>
          <figure class="hsr__fig">
            <blockquote class="hsr__quote">
              {%- if b.settings.title != blank -%}<p class="hsr__head-quote">{{ b.settings.title }}</p>{%- endif -%}
              <p class="hsr__body">{{ b.settings.text }}</p>
            </blockquote>
            <figcaption class="hsr__who">
              {%- if b.settings.photo != blank -%}
                {{ b.settings.photo | image_url: width: 96, height: 96, crop: 'center' | image_tag: class: 'hsr__face', width: 32, height: 32, loading: 'lazy', alt: '' }}
              {%- else -%}
                <span class="hsr__face hsr__face--initials" aria-hidden="true">{{ initials | upcase }}</span>
              {%- endif -%}
              <span class="hsr__meta"><span class="hsr__name">{{ who }}</span><span class="hsr__place">{{ b.settings.place }}</span></span>
              {%- if b.settings.gift != blank -%}<span class="hsr__gift">{{ b.settings.gift }}</span>{%- endif -%}
            </figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
    <div class="hsr__dots" data-hsr-dots aria-hidden="true"></div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "HS reviews",
  "tag": "div",
  "class": "hs2-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What people say" },
    { "type": "text", "id": "lead", "label": "Line under the heading", "default": "From people who have made or received a Heartside gift." },
    { "type": "range", "id": "seconds", "label": "Seconds per review", "min": 4, "max": 12, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name, as shown (first name and last initial)" },
        { "type": "text", "id": "place", "label": "Place" },
        { "type": "text", "id": "gift", "label": "Gift (optional)" },
        { "type": "text", "id": "title", "label": "Headline, in their words (optional)" },
        { "type": "textarea", "id": "text", "label": "Their words" },
        { "type": "image_picker", "id": "photo", "label": "Their photo (optional, with their permission)", "info": "Shown small next to the review. Without one, the card shows their initials." }
      ]
    }
  ],
  "presets": [{ "name": "HS reviews" }]
}
{% endschema %}
