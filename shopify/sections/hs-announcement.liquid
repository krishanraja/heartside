{%- render 'hs-head' -%}
{%- capture hs_active -%}{% render 'hs-offer', part: 'active' %}{%- endcapture -%}
{%- if hs_active == 'true' or request.design_mode -%}
  <div class="hs hs-announce" data-hs-ends="{% render 'hs-offer', part: 'ends' %}" role="region" aria-label="Offer">
    <div class="hs-wrap hs-announce__inner">
      <span>{{ section.settings.text }}</span>
      <span class="hs-announce__count" data-hs-count></span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Heartside offer bar",
  "tag": "section",
  "class": "hs-section",
  "enabled_on": { "templates": ["*"], "groups": ["header"] },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Message",
      "default": "30% off and free US shipping until November 1."
    },
    {
      "type": "paragraph",
      "content": "The countdown reads the end time from snippets/hs-offer.liquid, so it always matches the real discount. The bar hides itself when the offer ends."
    }
  ],
  "presets": [{ "name": "Heartside offer bar" }]
}
{% endschema %}
