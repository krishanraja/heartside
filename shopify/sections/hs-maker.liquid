{%- render 'hs-head' -%}
{%- liquid
  assign s = section.settings
  assign hs_url = s.button_link | default: '/collections/all'
  if s.product != blank
    assign hs_url = s.product.url
  endif
  assign hs_name = s.default_name | default: 'Biscuit'
  assign hs_faces = 'dachshund:Dachshund,poodle:Poodle,pug:Pug,maltipoo:Maltipoo,apricot:Poodle mix,golden:Golden' | split: ','
-%}
<div class="hs hs-maker hs-section" id="maker"
  data-hs-maker
  data-default-name="{{ hs_name | escape }}"
  data-frame="{{ 'hs-ornament-frame.webp' | asset_url }}"
  data-share-url="{{ shop.url }}{{ hs_url }}"
  data-share-text="{{ s.share_text | escape }}"
  data-share-domain="{{ shop.domain }}">
  <div class="hs-wrap hs-maker__grid">
    <div class="hs-maker__head">
      {%- if s.eyebrow != blank -%}<p class="hs-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if s.text != blank -%}<p class="hs-muted">{{ s.text }}</p>{%- endif -%}
    </div>


    <div class="hs-maker__stage">
      <div class="hs-orn" data-hs-orn>
        <div class="hs-orn__card">
          <div class="hs-orn__face hs-orn__front">
            <img class="hs-orn__photo" data-hs-photo
              src="{{ 'hs-window-dachshund.webp' | asset_url }}" width="715" height="681" alt="">
            <img class="hs-orn__frame"
              src="{{ 'hs-ornament-frame.webp' | asset_url }}" width="1000" height="1000" alt="">
            <span class="hs-orn__hole" aria-hidden="true"></span>
            <p class="hs-orn__name" data-hs-name-out aria-live="polite">{{ hs_name }}</p>
            <p class="hs-orn__line">is my person.</p>
          </div>
          <div class="hs-orn__face hs-orn__back">
            <img src="{{ 'hs-ornament-back.webp' | asset_url }}" width="1000" height="1000" loading="lazy"
              alt="The back of the ornament reads: Merry Christmas from the one who hogs the bed.">
            <span class="hs-orn__hole" aria-hidden="true"></span>
          </div>
        </div>
      </div>
      <button type="button" class="hs-btn hs-btn--outline hs-flip" data-hs-flip aria-pressed="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16M3 21v-5h5"/></svg>
        <span data-hs-flip-label>Turn it over</span>
      </button>
    </div>

    <div class="hs-maker__controls">
      <div class="hs-field">
        <label for="hs-name-{{ section.id }}">What's their name?</label>
        <div class="hs-input-wrap is-hinting">
          <input class="hs-input" id="hs-name-{{ section.id }}" type="text" maxlength="14"
            placeholder="e.g. {{ hs_name | escape }}" autocomplete="off" autocapitalize="words" spellcheck="false"
            enterkeyhint="done" data-hs-name-in aria-describedby="hs-name-hint-{{ section.id }}">
        </div>
        <p class="hs-hint" id="hs-name-hint-{{ section.id }}">Up to 14 letters. We print it exactly as you type it.</p>
      </div>

      <fieldset class="hs-faces">
        <legend class="hs-legend">Pick a face like theirs</legend>
        <div class="hs-faces__row">
          {%- for f in hs_faces -%}
            {%- assign parts = f | split: ':' -%}
            {%- assign key = parts[0] -%}
            {%- assign window = 'hs-window-' | append: key | append: '.webp' -%}
            <label class="hs-chip">
              <input type="radio" name="hs-face-{{ section.id }}" value="{{ key }}"
                data-hs-face="{{ window | asset_url }}" {% if forloop.first %}checked{% endif %}>
              <span><img src="{{ window | asset_url }}" alt="" width="32" height="32" loading="lazy">{{ parts[1] }}</span>
            </label>
          {%- endfor -%}
          <label class="hs-upload">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h3l2-3h6l2 3h3v13H4z"/><circle cx="12" cy="13" r="4"/></svg>
            <span>Use your dog's photo</span>
            <input type="file" accept="image/*" data-hs-upload>
          </label>
        </div>
      </fieldset>
      <p class="hs-status" data-hs-status role="status"></p>

      <div class="hs-maker__buy">
        {%- render 'hs-price', hs_product: s.product, fallback_cents: s.fallback_price, note: true -%}
        <a class="hs-btn hs-btn--block" href="{{ hs_url }}" data-hs-cta><span>Make <span data-hs-cta-name>{{ hs_name }}'s</span> ornament</span></a>
        <div class="hs-maker__share">
          <button type="button" class="hs-textlink" data-hs-share>{{ s.share_label }}</button>
          <span class="hs-small hs-muted">Saves a picture of it to send.</span>
        </div>
      </div>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Heartside name preview",
  "tag": "section",
  "class": "hs-section",
  "settings": [
    { "type": "paragraph", "content": "Shoppers type their dog's name, pick a face or add their own photo, and see the ornament change. Their photo never leaves their device." },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "Who's your person?" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Try it with their name." },
    { "type": "text", "id": "text", "label": "Text", "default": "Type it in, pick a face like theirs or use your own photo, then turn it over." },
    { "type": "text", "id": "default_name", "label": "Sample name", "default": "Biscuit" },
    { "type": "product", "id": "product", "label": "Ornament product" },
    { "type": "number", "id": "fallback_price", "label": "Price in cents if no product is chosen", "default": 3499 },
    { "type": "url", "id": "button_link", "label": "Button link if no product is chosen" },
    { "type": "text", "id": "share_label", "label": "Share link label", "default": "Send it to the group chat" },
    { "type": "text", "id": "share_text", "label": "Message sent with the picture", "default": "Who's your person?" }
  ],
  "presets": [{ "name": "Heartside name preview" }]
}
{% endschema %}
