{%- render 'hs2-head' -%}
{%- liquid
  assign s = section.settings
  assign hs_url = '#benefits'
  if s.product != blank
    assign hs_url = s.product.url
  endif
-%}
<div class="hs2">
  <section id="review" class="hs2-review" aria-labelledby="review-h-{{ section.id }}">
    <div class="hs2-review__inner">
      <div class="hs2-review__head">
        <div class="hs2-review__eyebrow">{{ s.eyebrow }}</div>
        <h2 id="review-h-{{ section.id }}">{% render 'hs2-t', text: s.heading %}</h2>
        <p>{% render 'hs2-t', text: s.text %}</p>
      </div>
      <div class="hs2-review__body">

        <div class="hs2-form">
          <div class="hs2-form__pair">
            <div class="hs2-field">
              <label for="person-{{ section.id }}">Employee name (you)</label>
              <input id="person-{{ section.id }}" type="text" maxlength="14" placeholder="Sarah" autocomplete="given-name" data-hs2-input="person">
            </div>
            <div class="hs2-field">
              <label for="cupboard-{{ section.id }}">Times you opened the treat cupboard</label>
              <input id="cupboard-{{ section.id }}" type="text" maxlength="6" value="1,412" inputmode="numeric" data-hs2-input="cupboard">
              <div class="hs2-field__note"><span data-hs2="dog">Biscuit</span> counted. Round down if you like.</div>
            </div>
          </div>

          <div class="hs2-chips" role="group" aria-label="Area for improvement">
            <div class="hs2-chips__label">Area for improvement</div>
            <div class="hs2-chips__row">{% render 'hs2-lines', kind: 'improvement', mode: 'chips', pick: 'Leaving' %}</div>
          </div>
          <div class="hs2-chips" role="group" aria-label="Open incident report">
            <div class="hs2-chips__label">Open incident report</div>
            <div class="hs2-chips__row">{% render 'hs2-lines', kind: 'incident', mode: 'chips', pick: 'The sock' %}</div>
          </div>
          <div class="hs2-chips" role="group" aria-label="Known enemy of the company">
            <div class="hs2-chips__label">Known enemy of the company</div>
            <div class="hs2-chips__row">{% render 'hs2-lines', kind: 'enemy', mode: 'chips', pick: 'The mailman' %}</div>
          </div>

          <label class="hs2-attach">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#121010" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"></rect><circle cx="12" cy="12" r="3.2"></circle><path d="M8 5l1.5-2h5L16 5"></path></svg>
            <span class="hs2-attach__text"><strong>Attach <span data-hs2="dogs">Biscuit's</span> headshot</strong> · a person checks every review before it prints</span>
            <input type="file" accept="image/*" data-hs2-photo-in>
          </label>

          <div class="hs2-buy">
            <div class="hs2-buy__row">
              <div>
                <div class="hs2-buy__price">{{ s.price }} <span>{{ s.price_note }}</span></div>
                <div class="hs2-buy__ship">{{ s.shipping }}</div>
              </div>
              <a class="hs2-btn hs2-btn--blush" href="{{ hs_url }}" data-hs2-carry><span>Approve <span data-hs2="dogs">Biscuit's</span> review</span></a>
            </div>
            <button type="button" class="hs2-voice" data-hs2-voice aria-pressed="false">+ Hear Biscuit read it out loud · 15s video · $12</button>
          </div>
        </div>

        <div class="hs2-review__side">
          {% render 'hs2-poster', photo: s.poster_photo %}
          {%- if s.exhibits -%}
            <div class="hs2-exhibits">
              <div class="hs2-exhibits__label">EVIDENCE ON FILE</div>
              <div class="hs2-exhibits__row">
                <figure class="hs2-exhibit" data-hs2-exhibit="improvement">
                  <img src="{{ 'hs-photo-bed-640.webp' | asset_url }}" alt="Evidence: a dachshund across the middle of the bed" width="640" height="800" loading="lazy">
                  <figcaption>EXHIBIT A<span data-hs2="improvement">Leaving</span></figcaption>
                </figure>
                <figure class="hs2-exhibit" data-hs2-exhibit="incident">
                  <img src="{{ 'hs-photo-incident-640.webp' | asset_url }}" alt="Evidence: a dachshund holding a sock, unrepentant" width="640" height="640" loading="lazy">
                  <figcaption>EXHIBIT B<span data-hs2="incident">The sock</span></figcaption>
                </figure>
                <figure class="hs2-exhibit" data-hs2-exhibit="enemy">
                  <img src="{{ 'hs-photo-window-640.webp' | asset_url }}" alt="Evidence: a terrier at the window, watching the delivery driver" width="640" height="800" loading="lazy">
                  <figcaption>EXHIBIT C<span data-hs2="enemy">The mailman</span></figcaption>
                </figure>
              </div>
            </div>
            {% render 'hs2-photos' %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "HS review builder",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "Form HR-26. The chips and their joke lines live in snippets/hs2-lines.liquid. The button opens the poster product with the answers in the link." },
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "FORM HR-26 · ANNUAL PERFORMANCE REVIEW" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help {dog} fill in the paperwork." },
    { "type": "text", "id": "text", "label": "Text", "default": "{dog} has opinions and no thumbs. You type, {dog} signs. It prints as a poster, made for your wall or for someone whose dog is clearly their manager." },
    { "type": "product", "id": "product", "label": "Annual Review poster product", "info": "The Approve button opens this product with the answers attached." },
    { "type": "text", "id": "price", "label": "Price", "default": "$39" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "poster · $89 framed" },
    { "type": "text", "id": "shipping", "label": "Shipping line", "default": "Free US shipping" },
    { "type": "image_picker", "id": "poster_photo", "label": "Sample headshot on the poster", "info": "Empty uses the hero dachshund's face. Shoppers can attach their own; it stays on their device until they use it on the product page." },
    { "type": "checkbox", "id": "exhibits", "label": "Show the evidence photos under the poster", "info": "Three photos that change with the chips: Exhibit A (improvement), B (incident), C (enemy).", "default": true }
  ],
  "presets": [{ "name": "HS review builder" }]
}
{% endschema %}
