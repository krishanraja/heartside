{%- comment -%}
  The Heartside journey (Krish, 29 Oct: rebuilt after the phone batch, not patched). Six screens,
  each doing one thing, nothing asked twice, taps instead of typing:
    1. this first screen (the hook),
    2. about your dog (?step=about),
    3. your dog's profile: the words and the look, text only (?step=profile),
    4. the photo (?step=photo), which hands over to the best-fit gift's page, where it paints,
    5. the gifts on the real products, and 6. the cart (both on the product pages, hs2.js).
  Behaviour lives in assets/hs-journey.js. This file holds the first screen, so it shows before
  the script runs, the gifts from Shopify and the settings.
{%- endcomment -%}
{%- render 'hs2-head' -%}
{%- render 'hs-schema', kind: 'home' -%}
{%- assign ai_host = section.settings.compose_url | split: '/webhook' | first -%}
{%- if section.settings.ai_on and ai_host contains 'https://' -%}<link rel="preconnect" href="{{ ai_host }}" crossorigin>{%- endif -%}
{{ 'hs-journey.css' | asset_url | stylesheet_tag }}
{{ 'hs-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hs-showcase.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hs-breeds.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hs-brief.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hs-journey.js' | asset_url }}" defer="defer"></script>
{%- assign s = section.settings -%}
<script>if(/[?&]step=/.test(location.search)){document.documentElement.classList.add('hsj-routed','hsj-focus');setTimeout(function(){document.documentElement.classList.remove('hsj-routed')},3500);}</script>
{%- comment -%} The mug's colors in the brand book's order, only those the product sells. {%- endcomment -%}
{%- assign mug_hex = '#050505,#191A4D,#216251,#D9292C,#E49EAA' | split: ',' -%}
{%- assign mug_order = 'Black,Dark Blue,Dark Green,Red,Pink' | split: ',' -%}
{%- assign mug_n = 0 -%}
{%- capture mug_colors -%}
  {%- if s.product_mug != blank -%}
    {%- for c in mug_order -%}
      {%- assign ci = forloop.index0 -%}
      {%- for v in s.product_mug.variants -%}
        {%- if v.options contains c -%}
          {%- if mug_n > 0 -%},{%- endif -%}
          { "name": {{ c | json }}, "hex": {{ mug_hex[ci] | json }}, "id": {{ v.id | json }} }
          {%- assign mug_n = mug_n | plus: 1 -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
<div class="hsj" data-hsj id="journey-{{ section.id }}">
  <script type="application/json" data-hsj-config>
    {
      "composeUrl": {{ s.compose_url | json }},
      "ai": {{ s.ai_on | json }},
      "corePurchase": {{ s.core_purchase | json }},
      "mug": { "colors": [{{ mug_colors | strip }}] },
      "hero": {{ 'hs-ex-hero-mug.webp' | asset_url | json }},
      "examples": {
        "painterly": {{ 'hs-ex-style-painterly.webp' | asset_url | json }},
        "cinematic": {{ 'hs-ex-style-cinematic.webp' | asset_url | json }},
        "comic": {{ 'hs-ex-style-comic.webp' | asset_url | json }},
        "screenprint": {{ 'hs-ex-style-screenprint.webp' | asset_url | json }},
        "ink": {{ 'hs-ex-style-ink.webp' | asset_url | json }},
        "collage": {{ 'hs-ex-style-collage.webp' | asset_url | json }}
      },
      "gifts": {
        {%- assign keys = 'mug,blanket,print' | split: ',' -%}
        {%- for k in keys -%}
          {%- assign pid = 'product_' | append: k -%}
          {%- assign p = s[pid] -%}
          "{{ k }}": {
            {%- if p != blank -%}
              "url": {{ p.url | json }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }},
              "price": {{ p.price_min | divided_by: 100.0 | json }}, "priceMax": {{ p.price_max | divided_by: 100.0 | json }},
              {%- assign min_variant = nil -%}
              {%- for v in p.variants -%}
                {%- if v.available and v.price == p.price_min -%}{%- assign min_variant = v.id -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              "minVariant": {{ min_variant | json }}
            {%- else -%}
              "url": null, "handle": null, "price": null
            {%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  </script>
  {%- comment -%} 1. The hook (Krish, 3 Nov: the phone homepage is two screens at most). The Christmas offer
    first, the six example sets fading by as the hero (the old mug example was the weakest thing on the
    page), one price line, and one button that stays pinned to the bottom of the screen in the heart's
    pink. Policies and the company live in the footer. {%- endcomment -%}
  <section class="hsj__screen hsj-hook" data-hsj-screen="hook">
    <p class="hsj-eyebrow">{{ s.eyebrow }}</p>
    <h1 class="hsj-h1">{{ s.headline }} <em>{{ s.headline_em }}</em></h1>
    {%- comment -%} The offer reads what the memo strip already knows. The countdown is hs2.js's, to the
      confirmed last order date (or Christmas morning while none is set); the strip above already says the
      date, so the card does not repeat it. The saving shows only while the strip's bundle switch is on,
      so the card never promises a discount that doesn't exist. {%- endcomment -%}
    <div class="hsj-offer" data-hsj-offer>
      <p class="hsj-offer__top"><span class="hsj-offer__badge">{{ s.offer_badge }}</span><span class="hsj-offer__count" data-hs2-countdown="memo" hidden></span></p>
      <p class="hsj-offer__main"><strong>{{ s.offer_ship }}</strong><span class="hsj-offer__bundle" data-hsj-offer-bundle hidden><span aria-hidden="true"> · </span><strong>{{ s.offer_bundle }}</strong></span></p>
    </div>
    <script>
      (function (card) {
        var m = document.querySelector('[data-hs2-memo]');
        if (!card || !m) return;
        if (m.hasAttribute('data-hs-bundle-live')) card.querySelector('[data-hsj-offer-bundle]').hidden = false;
      })(document.currentScript.previousElementSibling);
    </script>
    {%- comment -%} The hero: the six example sets, one at a time (hs-showcase.js runs it, as it did lower down). {%- endcomment -%}
    <div class="hss hss--hero" data-hss>
      <div class="hss-block hss-sets" data-hss-reel>
        <ul class="hss-row hss-row--sets" data-hss-reel-track>
          <li>{%- render 'hs-showcase-fig', id: 'set-golden', w: 540, h: 675, eager: true, alt: 'Example: Maple, a golden retriever, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Maple', sub: 'Mug · Blanket · Portrait' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'set-lab', w: 540, h: 675, alt: 'Example: Bear, a Labrador Retriever, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Bear', sub: 'Mug · Blanket · Portrait' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'set-frenchie', w: 540, h: 675, alt: 'Example: Bao, a French bulldog, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Bao', sub: 'Mug · Blanket · Portrait' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'set-doodle', w: 540, h: 675, alt: 'Example: Clover, a goldendoodle, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Clover', sub: 'Mug · Blanket · Portrait' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'set-dachshund', w: 540, h: 675, alt: 'Example: Frank, a dachshund, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Frank', sub: 'Mug · Blanket · Portrait' -%}</li>
          <li>{%- render 'hs-showcase-fig', id: 'set-shepherd', w: 540, h: 675, alt: 'Example: Juno, a German shepherd, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Juno', sub: 'Mug · Blanket · Portrait' -%}</li>
        </ul>
        <div class="hss-ctl" data-hss-reel-ctl hidden>
          <div class="hss-ticks" data-hss-ticks></div>
          <button type="button" class="hss-pause" data-hss-pause aria-pressed="false" aria-label="Pause"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path class="hss-pause__bars" d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/><path class="hss-pause__play" d="M8 5l11 7-11 7z" fill="currentColor"/></svg></button>
        </div>
      </div>
    </div>
    {%- comment -%} what each gift costs, from Shopify, before anything is asked (audit, 30 Oct); one line {%- endcomment -%}
    {%- capture price_line -%}
      {%- for k in keys -%}
        {%- assign pid = 'product_' | append: k -%}{%- assign p = s[pid] -%}
        {%- if p != blank -%}{%- unless forloop.first %} · {% endunless -%}{%- case k -%}{%- when 'mug' -%}Mug{%- when 'blanket' -%}Blanket{%- else -%}Portrait{%- endcase %} {% if p.price_max > p.price_min %}from {% endif %}{{ p.price_min | money_without_trailing_zeros }}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if price_line != blank -%}<p class="hsj-price">{{ price_line | strip }}</p>{%- endif -%}
    <p class="hsj-small hsj-resume" data-hsj-resume hidden><button type="button" class="hsj-link" data-hsj-resume-go>Pick up where you left off</button> · <button type="button" class="hsj-link" data-hsj-restart>Start over</button></p>
    <div class="hsj-dock hsj-dock--pin">
      <a class="hsj-btn hs-btn-heart" href="?step=name" data-hsj-go="name"><span>{{ s.start }}</span><svg class="hsj-ico" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h13M13 6.5 18.5 12 13 17.5"/></svg></a>
    </div>
  </section>
  <div class="hsj-app" data-hsj-app></div>
  <noscript><p class="hsj-small">This page needs JavaScript. Turn it on, or email krish@heartside.io and a person will help.</p></noscript>
  <p class="hsj-privacy" data-hsj-privacy hidden>{{ s.privacy }}</p>
</div>

{% schema %}
{
  "name": "HS journey",
  "tag": "section",
  "class": "hsj-section",
  "settings": [
    { "type": "paragraph", "content": "The Heartside journey: the first screen, about your dog, the profile and the photo. The painting, the gifts and the cart follow on the product pages. Prices come from the products picked below." },
    { "type": "header", "content": "First screen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gifts from your dog" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Your dog" },
    { "type": "text", "id": "headline_em", "label": "Headline, italic part", "default": "loves you too." },
    { "type": "text", "id": "offer_badge", "label": "Offer card: badge", "default": "Christmas offer" },
    { "type": "text", "id": "offer_ship", "label": "Offer card: shipping", "default": "Free US shipping" },
    { "type": "text", "id": "offer_bundle", "label": "Offer card: bundle saving", "info": "Shows only while the memo bar's bundle switch is on, which is ticked only once the Shopify automatic discount exists.", "default": "15% off 2 gifts, 20% off 3" },
    { "type": "text", "id": "start", "label": "Button", "default": "Make one for my dog" },
    { "type": "textarea", "id": "privacy", "label": "AI privacy note", "default": "Your answers go to our writing service only to write your dog's note. Your photo stays on your device until you choose a gift." },
    { "type": "header", "content": "Retired 3 Nov (not shown)" },
    { "type": "paragraph", "content": "Kept so a saved theme still loads. The phone homepage is two screens at most (Krish, 3 Nov), so the example card and the lines under the button are gone; the footer holds the policies." },
    { "type": "text", "id": "example_for", "label": "Example: who it's for", "default": "Maple's mug for Sam" },
    { "type": "text", "id": "example_line", "label": "Example: the dog's line", "default": "I saved your spot. It is also my spot." },
    { "type": "text", "id": "example_dog", "label": "Example: the dog's name", "default": "Maple" },
    { "type": "textarea", "id": "intro", "label": "Line under the example", "default": "Tell us about your dog. We paint them onto a mug, a blanket or a portrait for the person they love, with a note in their voice in the box." },
    { "type": "text", "id": "time_line", "label": "Under the button", "default": "Have a photo of your dog on your phone? It takes about 2 minutes." },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "Free US shipping on every order. A person checks every design before it prints." },
    { "type": "text", "id": "legal_note", "label": "Company note", "default": "Heartside is a Mindmaker LLC company." },
    { "type": "header", "content": "Gifts and services" },
    { "type": "product", "id": "product_mug", "label": "Mug product" },
    { "type": "product", "id": "product_blanket", "label": "Blanket product" },
    { "type": "product", "id": "product_print", "label": "Portrait product" },
    { "type": "checkbox", "id": "core_purchase", "label": "Use the native product pages", "default": true },
    { "type": "checkbox", "id": "ai_on", "label": "Write the note with AI", "info": "Off: the note uses the scripted lines for each answer.", "default": true },
    { "type": "text", "id": "compose_url", "label": "Compose webhook", "default": "https://krishraja10101.app.n8n.cloud/webhook/heartside-compose" }
  ],
  "presets": [{ "name": "HS journey" }]
}
{% endschema %}
