{%- comment -%}
  The Heartside journey, photo first (Krish, 4 Nov: "one step at a time, non-duplicative, in the right
  order, and then the user purchases"). Each screen does one thing and nothing is asked twice:
    1. this first screen (the hook),
    2. the photo (?step=photo), kept on the phone,
    3. the style (?step=look),
    4. the tone (?step=tone), which changes the painting's scene and light, never the dog's face,
    5. the gifts (?step=gifts), each with its colour or frame, chosen once; "Start painting" opens
       the first gift's page, which paints at once and asks about the dog and the note while it
       paints (snippets/hs-journey-choose.liquid), then shows the painting on the real product.
  Behaviour lives in assets/hs-journey.js. This file holds the first screen, so it shows before
  the script runs, the gifts and their variants from Shopify, and the settings.
{%- endcomment -%}
{%- render 'hs2-head' -%}
{%- render 'hs-schema', kind: 'home' -%}
{%- assign ai_host = section.settings.compose_url | split: '/webhook' | first -%}
{%- if section.settings.ai_on and ai_host contains 'https://' -%}<link rel="preconnect" href="{{ ai_host }}" crossorigin>{%- endif -%}
{{ 'hs-journey.css' | asset_url | stylesheet_tag }}
{{ 'hs-showcase.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hs-showcase.js' | asset_url }}" defer="defer"></script>
{%- comment -%} hs-breeds.js is the gift page's (the breed question there); the gifts step prefetches it (5 Nov speed ask) {%- endcomment -%}
<script src="{{ 'hs-journey.js' | asset_url }}" defer="defer"></script>
{%- assign s = section.settings -%}
<script>if(/[?&]step=/.test(location.search)){document.documentElement.classList.add('hsj-routed','hsj-focus');setTimeout(function(){document.documentElement.classList.remove('hsj-routed')},3500);}</script>
{%- comment -%} The mug's colors in the brand book's order, only those the product sells. {%- endcomment -%}
{%- assign mug_hex = '#050505,#191A4D,#216251,#D9292C,#E49EAA' | split: ',' -%}
{%- assign mug_order = 'Black,Dark Blue,Dark Green,Red,Pink' | split: ',' -%}
{%- assign mug_n = 0 -%}
{%- capture mug_colors -%}
  {%- if s.product_mug != blank -%}
    {%- for c in mug_order -%}
      {%- assign ci = forloop.index0 -%}
      {%- for v in s.product_mug.variants -%}
        {%- if v.options contains c -%}
          {%- if mug_n > 0 -%},{%- endif -%}
          { "name": {{ c | json }}, "hex": {{ mug_hex[ci] | json }}, "id": {{ v.id | json }} }
          {%- assign mug_n = mug_n | plus: 1 -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- comment -%} Buddy's one drawing for hs-journey.js, who says the line under each question {%- endcomment -%}
<template data-hs-buddy>{% render 'hs-buddy' %}</template>
<div class="hsj" data-hsj id="journey-{{ section.id }}"><script>
    /* Helio's header is cleared before the first paint, as hs2-product.liquid does, with the same measure as
       hs-journey.js clearHeader (+8 px), so the hero never drops when the script runs (5 Nov, ten buyers) */
    (function (box) {
      try {
        if (!box || document.documentElement.classList.contains('hsj-focus') || window.scrollY > 10) return;
        var header = document.querySelector('.header-section, header.shopify-section');
        if (!header) return;
        var top = box.getBoundingClientRect().top, bottom = header.getBoundingClientRect().bottom;
        header.querySelectorAll('header-component, .header__row, .header__underlay').forEach(function (el) { var r = el.getBoundingClientRect(); if (r.width && r.height) bottom = Math.max(bottom, r.bottom); });
        bottom = Math.min(bottom, top + 200);
        if (bottom > top) box.style.paddingTop = Math.ceil(bottom - top + 8) + 'px';
      } catch (e) { /* hs-journey.js clearHeader still runs */ }
    })(document.currentScript.closest('.shopify-section'));
  </script>
  <script type="application/json" data-hsj-config>
    {
      "composeUrl": {{ s.compose_url | json }},
      {%- comment -%} what the gift page needs that the home page has not loaded: prefetched from the gifts step (hs-journey.js warmGift) {%- endcomment -%}
      "warm": [{{ 'hs-journey-choose.js' | asset_url | json }}, {{ 'hs-journey-choose.css' | asset_url | json }}, {{ 'hs-wait.js' | asset_url | json }}, {{ 'hs-wait.css' | asset_url | json }}, {{ 'hs-breed-facts.js' | asset_url | json }}, {{ 'hs-breeds.js' | asset_url | json }}],
      "ai": {{ s.ai_on | json }},
      "corePurchase": {{ s.core_purchase | json }},
      "mug": { "colors": [{{ mug_colors | strip }}] },
      "hero": {{ 'hs-ex-hero-mug.webp' | asset_url | json }},
      {%- comment -%} The tone cards show their icon and words, not the 30 Oct example paintings: those were painted
      under the old recipes, with plush toys, thrones and scatters of poses that v19 no longer paints (5 Nov
      review). New examples come from the v19 likeness path, one dog in four tones, on Krish's choice of photo. {%- endcomment -%}
      "toneExamples": {},
      "scenes": {
        "mug": {{ 'hs-ex-scene-mug-home.webp' | asset_url | json }},
        "print": {{ 'hs-ex-scene-portrait-home.webp' | asset_url | json }},
        "blanket": {{ 'hs-ex-scene-blanket-home.webp' | asset_url | json }}
      },
      "examples": {
        "painterly": {{ 'hs-ex-style-painterly.webp' | asset_url | json }},
        "cinematic": {{ 'hs-ex-style-cinematic.webp' | asset_url | json }},
        "comic": {{ 'hs-ex-style-comic.webp' | asset_url | json }},
        "screenprint": {{ 'hs-ex-style-screenprint.webp' | asset_url | json }},
        "ink": {{ 'hs-ex-style-ink.webp' | asset_url | json }},
        "collage": {{ 'hs-ex-style-collage.webp' | asset_url | json }}
      },
      "gifts": {
        {%- assign keys = 'mug,blanket,print' | split: ',' -%}
        {%- for k in keys -%}
          {%- assign pid = 'product_' | append: k -%}
          {%- assign p = s[pid] -%}
          "{{ k }}": {
            {%- if p != blank -%}
              "url": {{ p.url | json }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }},
              "price": {{ p.price_min | divided_by: 100.0 | json }}, "priceMax": {{ p.price_max | divided_by: 100.0 | json }},
              {%- assign min_variant = nil -%}
              {%- for v in p.variants -%}
                {%- if v.available and v.price == p.price_min -%}{%- assign min_variant = v.id -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              "minVariant": {{ min_variant | json }},
              {%- comment -%} every variant, so the colour or frame is chosen once, on the gifts screen (Krish, 4 Nov) {%- endcomment -%}
              "variants": [{%- for v in p.variants -%}{ "id": {{ v.id | json }}, "options": {{ v.options | json }}, "price": {{ v.price | divided_by: 100.0 | json }}, "available": {{ v.available | json }} }{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
            {%- else -%}
              "url": null, "handle": null, "price": null
            {%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  </script>
  {%- comment -%} 1. The hook (Krish, 3 Nov: the phone homepage is two screens at most; the carousel is 70 to 80%
    of the phone's first screen; one Christmas offer, not two). On a phone the six example sets fill the screen
    edge to edge with the headline on the picture, and the prices and the button stay pinned to the bottom in
    the heart's pink. The offer is the memo strip above (sections/hs2-memo.liquid), never a second card. On
    desktop: the words, prices and button on the left with the photo-to-gift slider under them, the sets on
    the right. Policies and the company live in the footer. {%- endcomment -%}
  <section class="hsj__screen hsj-hook" data-hsj-screen="hook">
    <div class="hsj-hook__words">
      <p class="hsj-eyebrow">{{ s.eyebrow }}</p>
      <h1 class="hsj-h1">{{ s.headline }} <em>{{ s.headline_em }}</em></h1>
    </div>
    {%- comment -%} The hero: the six example sets, one at a time (hs-showcase.js runs it). Since 3 Nov each shows the real product
      mug, served at 540 and 1080 wide (tools/print-art/hero-sets.py). {%- endcomment -%}
    {%- render 'hs-showcase-later' -%}
    {%- comment -%} Under each dog's name, one line on a phone (Krish, 6 Nov: "The true personality of your best friend,
      customized thoughtfully in to the perfect gift." Paraphrased to fit one line). {%- endcomment -%}
    {%- assign hs_tagline = 'Their true self, made the perfect gift' -%}
    <div class="hss hss--hero" data-hss>
      <div class="hss-block hss-sets" data-hss-reel>
        <ul class="hss-row hss-row--sets" data-hss-reel-track>
          <li>{%- render 'hs-showcase-fig', hero: 'golden', eager: true, alt: 'Example: Maple, a golden retriever, on a mug, a sherpa blanket and a framed portrait in one living room.', caption: 'Maple', sub: hs_tagline -%}</li>
          <li>{%- render 'hs-showcase-fig', hero: 'lab', alt: 'Example: Bear, a Labrador Retriever, on a mug, a sherpa blanket and a framed portrait in one living room.', later: true, caption: 'Bear', sub: hs_tagline -%}</li>
          <li>{%- render 'hs-showcase-fig', hero: 'frenchie', alt: 'Example: Bao, a French bulldog, on a mug, a sherpa blanket and a framed portrait in one living room.', later: true, caption: 'Bao', sub: hs_tagline -%}</li>
          <li>{%- render 'hs-showcase-fig', hero: 'doodle', alt: 'Example: Clover, a goldendoodle, on a mug, a sherpa blanket and a framed portrait in one living room.', later: true, caption: 'Clover', sub: hs_tagline -%}</li>
          <li>{%- render 'hs-showcase-fig', hero: 'dachshund', alt: 'Example: Frank, a dachshund, on a mug, a sherpa blanket and a framed portrait in one living room.', later: true, caption: 'Frank', sub: hs_tagline -%}</li>
          <li>{%- render 'hs-showcase-fig', hero: 'shepherd', alt: 'Example: Juno, a German shepherd, on a mug and a sherpa blanket in one living room.', later: true, caption: 'Juno', sub: hs_tagline -%}</li>
        </ul>
        <div class="hss-ctl" data-hss-reel-ctl hidden>
          <div class="hss-ticks" data-hss-ticks></div>
          <button type="button" class="hss-pause" data-hss-pause aria-pressed="false" aria-label="Pause"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path class="hss-pause__bars" d="M8 5h3v14H8zM13 5h3v14h-3z" fill="currentColor"/><path class="hss-pause__play" d="M8 5l11 7-11 7z" fill="currentColor"/></svg></button>
        </div>
      </div>
    </div>
    {%- comment -%} what each gift costs, from Shopify, before anything is asked (audit, 30 Oct); one line {%- endcomment -%}
    {%- capture price_line -%}
      {%- for k in keys -%}
        {%- assign pid = 'product_' | append: k -%}{%- assign p = s[pid] -%}
        {%- if p != blank -%}{%- unless forloop.first %} · {% endunless -%}{%- case k -%}{%- when 'mug' -%}Mug{%- when 'blanket' -%}Blanket{%- else -%}Portrait{%- endcase %} {% if p.price_max > p.price_min %}from {% endif %}{{ p.price_min | money_without_trailing_zeros }}{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <p class="hsj-small hsj-resume" data-hsj-resume hidden><button type="button" class="hsj-link" data-hsj-resume-go>Pick up where you left off</button> · <button type="button" class="hsj-link" data-hsj-restart>Start over</button></p>
    <div class="hsj-dock hsj-dock--pin">
      {%- if price_line != blank -%}<p class="hsj-price">{{ price_line | strip }}</p>{%- endif -%}
      <a class="hsj-btn hs-btn-heart" href="?step=photo" data-hsj-go="photo"><span>{{ s.start }}</span><svg class="hsj-ico" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h13M13 6.5 18.5 12 13 17.5"/></svg></a>
    </div>
    {%- comment -%} From a photo to a gift (Krish, 3 Nov: on desktop it belongs in the carousel's section). On a phone it
      follows the first screen, as before; on desktop it fills the column under the button. {%- endcomment -%}
    <div class="hss hss--flow" data-hss>
      <div class="hss-block hss-flow is-live" data-hss-flow>
        <h2 class="hss-h3">{{ s.flow_heading }}</h2>
        <div class="hss-flow__stage" data-hss-stage>
          {%- render 'hs-showcase-fig', id: 'flow-photo', w: 720, h: 900, alt: 'Reference photo: a golden retriever sitting on a tiled floor.', later: true, eager: false -%}
          {%- render 'hs-showcase-fig', id: 'flow-painting', w: 720, h: 900, alt: 'Example painting of the same golden retriever in a play bow on a fleece blanket with a plush toy.', later: true -%}
          {%- render 'hs-showcase-fig', id: 'flow-gift', w: 720, h: 900, alt: 'Example: the painting on a black-handled mug held in a hand.', later: true -%}
        </div>
        <div class="hss-flow__ctl" data-hss-ctl>
          <input type="range" min="0" max="2" step="0.01" value="1" aria-label="Photo, painting, gift" aria-valuetext="Painting" data-hss-range>
          <div class="hss-flow__steps">
            <button type="button" data-hss-step="0">Photo</button>
            <button type="button" data-hss-step="1">Painting</button>
            <button type="button" data-hss-step="2">Gift</button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="hsj-app" data-hsj-app></div>
  <noscript><p class="hsj-small">This page needs JavaScript. Turn it on, or email krish@heartside.io and a person will help.</p></noscript>
  <p class="hsj-privacy" data-hsj-privacy hidden>{{ s.privacy }}</p>
</div>

{% schema %}
{
  "name": "HS journey",
  "tag": "section",
  "class": "hsj-section",
  "settings": [
    { "type": "paragraph", "content": "The Heartside journey: the first screen, about your dog, the profile and the photo. The painting, the gifts and the cart follow on the product pages. Prices come from the products picked below." },
    { "type": "header", "content": "First screen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gifts from your dog" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Your dog" },
    { "type": "text", "id": "headline_em", "label": "Headline, italic part", "default": "loves you too." },
    { "type": "text", "id": "start", "label": "Button", "default": "Design yours in minutes" },
    { "type": "text", "id": "flow_heading", "label": "Photo to gift heading", "default": "From a photo to a gift" },
    { "type": "textarea", "id": "privacy", "label": "AI privacy note", "default": "Your answers go to our writing service only to write your dog's note. Your photo stays on your device until you choose a gift." },
    { "type": "header", "content": "Retired 3 Nov (not shown)" },
    { "type": "paragraph", "content": "Kept so a saved theme still loads. The phone homepage is two screens at most (Krish, 3 Nov), so the example card and the lines under the button are gone; the footer holds the policies." },
    { "type": "text", "id": "example_for", "label": "Example: who it's for", "default": "Maple's mug for Sam" },
    { "type": "text", "id": "example_line", "label": "Example: the dog's line", "default": "I saved your spot. It is also my spot." },
    { "type": "text", "id": "example_dog", "label": "Example: the dog's name", "default": "Maple" },
    { "type": "textarea", "id": "intro", "label": "Line under the example", "default": "Tell us about your dog. We paint them onto a mug, a blanket or a portrait for the person they love, with a note in their voice in the box." },
    { "type": "text", "id": "time_line", "label": "Under the button", "default": "Have a photo of your dog on your phone? It takes about 2 minutes." },
    { "type": "text", "id": "trust_line", "label": "Trust line", "default": "Free US shipping on every order. A person checks every design before it prints." },
    { "type": "text", "id": "legal_note", "label": "Company note", "default": "Heartside is a Mindmaker LLC company." },
    { "type": "header", "content": "Gifts and services" },
    { "type": "product", "id": "product_mug", "label": "Mug product" },
    { "type": "product", "id": "product_blanket", "label": "Blanket product" },
    { "type": "product", "id": "product_print", "label": "Portrait product" },
    { "type": "checkbox", "id": "core_purchase", "label": "Use the native product pages", "default": true },
    { "type": "checkbox", "id": "ai_on", "label": "Write the note with AI", "info": "Off: the note uses the scripted lines for each answer.", "default": true },
    { "type": "text", "id": "compose_url", "label": "Compose webhook", "default": "https://krishraja10101.app.n8n.cloud/webhook/heartside-compose" }
  ],
  "presets": [{ "name": "HS journey" }]
}
{% endschema %}
