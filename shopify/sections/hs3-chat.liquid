{%- comment -%}
  Heartside v3: gifts from your dog, phone first: the first screen, the chat with Buddy,
  the reveal, choose gifts and the share card, each step at its own address (/?step=).
  Built from the approved prototype (design/prototype-v3/Main.dc.html) and redesigned on
  27 Oct around the real products. Behaviour lives in assets/hs3.js; this file holds the
  first screen (so it shows before the script runs), the gifts from Shopify and the settings.
{%- endcomment -%}
{%- render 'hs2-head' -%}
{%- render 'hs-schema', kind: 'home' -%}
{%- assign ai_host = section.settings.typed_url | split: '/webhook' | first -%}
{%- if section.settings.ai_on and ai_host contains 'https://' -%}<link rel="preconnect" href="{{ ai_host }}" crossorigin>{%- endif -%}
{{ 'hs3.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hs-breeds.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'hs3.js' | asset_url }}" defer="defer"></script>
{%- assign s = section.settings -%}
{%- comment -%} A reload or a shared link to a step (/?step=spot) paints the step, not the first screen
  and then the step: hs3.js removes this class once it has drawn the step (27 Oct). {%- endcomment -%}
<script>if(/[?&]step=/.test(location.search)){document.documentElement.classList.add('hs3-routed');setTimeout(function(){document.documentElement.classList.remove('hs3-routed')},3500);}</script>
{%- comment -%} The mug's colors, Black first (Krish, 19 Oct): only those the picked product has as a
  variant, each with its handle-left and handle-right product photos, matched by alt text
  ("Illustrated mug, black inside: handle-left view."). Hex from the brand book's mug interiors. {%- endcomment -%}
{%- assign mug_hex = '#050505,#191A4D,#216251,#D9292C,#E49EAA' | split: ',' -%}
{%- assign mug_order = 'Black,Dark Blue,Dark Green,Red,Pink' | split: ',' -%}
{%- assign mug_n = 0 -%}
{%- capture mug_colors -%}
  {%- if s.product_mug != blank -%}
    {%- for c in mug_order -%}
      {%- assign ci = forloop.index0 -%}
      {%- assign needle = c | downcase | append: ' inside' -%}
      {%- for v in s.product_mug.variants -%}
        {%- if v.options contains c -%}
          {%- assign left = '' -%}{%- assign right = '' -%}
          {%- for m in s.product_mug.media -%}
            {%- assign a = m.alt | downcase -%}
            {%- if m.media_type == 'image' and a contains needle -%}
              {%- if a contains 'handle-left' -%}{%- assign left = m | image_url: width: 900 -%}{%- endif -%}
              {%- if a contains 'handle-right' -%}{%- assign right = m | image_url: width: 900 -%}{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if mug_n > 0 -%},{%- endif -%}
          { "name": {{ c | json }}, "hex": {{ mug_hex[ci] | json }}, "id": {{ v.id | json }}, "left": {{ left | json }}, "right": {{ right | json }} }
          {%- assign mug_n = mug_n | plus: 1 -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
<div class="hs3" data-hs3 id="gift-{{ section.id }}">
  <script type="application/json" data-hs3-config>
    {
      "typedUrl": {{ s.typed_url | json }},
      "composeUrl": {{ s.compose_url | json }},
      "ai": {{ s.ai_on | json }},
      "artworkCandidates": {{ s.artwork_candidates | json }},
      "blanketPurchase": {{ s.blanket_purchase | json }},
      "corePurchase": {{ s.core_purchase | json }},
      "ornamentBundle": {{ s.ornament_bundle | json }},
      "mug": { "colors": [{{ mug_colors | strip }}] },
      "gifts": {
        {%- comment -%} Each gift straight from its Shopify product: its own address, its lowest and
          highest variant price, and up to four labelled photos. The blank technical reference
          ("shown in your cart") and unlabelled photos never show. {%- endcomment -%}
        {%- assign keys = 'mug,blanket,print,ornament' | split: ',' -%}
        {%- for k in keys -%}
          {%- assign pid = 'product_' | append: k -%}
          {%- assign p = s[pid] -%}
          "{{ k }}": {
            {%- if p != blank -%}
              "url": {{ p.url | json }}, "handle": {{ p.handle | json }}, "title": {{ p.title | json }},
              "price": {{ p.price_min | divided_by: 100.0 | json }}, "priceMax": {{ p.price_max | divided_by: 100.0 | json }},
              {%- comment -%} the first available variant at the lowest price, so a gift with more than one
                price opens on the price the choose screen shows (28 Oct: the portrait opened Framed) {%- endcomment -%}
              {%- assign min_variant = nil -%}
              {%- for v in p.variants -%}
                {%- if v.available and v.price == p.price_min -%}{%- assign min_variant = v.id -%}{%- break -%}{%- endif -%}
              {%- endfor -%}
              "minVariant": {{ min_variant | json }},
              "images": [
                {%- assign n = 0 -%}
                {%- for m in p.media -%}
                  {%- assign a = m.alt | downcase -%}
                  {%- if m.media_type == 'image' and n < 4 and m.alt != blank -%}
                    {%- unless a contains 'shown in your cart' or a contains 'blank ' or a contains 'checkout tile' -%}
                      {%- if n > 0 -%},{%- endif -%}{ "src": {{ m | image_url: width: 900 | json }}, "alt": {{ m.alt | json }} }
                      {%- assign n = n | plus: 1 -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              ]
            {%- else -%}
              "url": null, "handle": null, "price": null
            {%- endif -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  </script>
  <div class="hs3__frame" data-hs3-screen="hero">
    <div class="hs3-hero">
      <div class="hs3-hero__copy">
        <div class="hs3-eyebrow">{{ s.eyebrow }}</div>
        <h1 class="hs3-hero__h">{{ s.headline }} <em>{{ s.headline_em }}</em></h1>
        <p class="hs3-hero__p">{{ s.intro }}</p>
      </div>
      {%- comment -%} The button comes straight after the words, so it is in the first screen on every phone
        and is read in the order it is seen; the gifts and Buddy's bubble follow it (28 Oct). On a wide
        screen the grid places each part. The Christmas countdown lives in the memo bar, so the line under
        the button is the trust line alone. {%- endcomment -%}
      <div class="hs3-hero__foot">
        <p class="hs3-resume" data-hs3-resume hidden>Welcome back. <span data-hs3-resume-dog></span>'s answers are still here.</p>
        <button type="button" class="hs3-btn" data-hs3-start>{{ s.start }}</button>
        <p class="hs3-resume hs3-resume--quiet" data-hs3-resume hidden><button type="button" class="hs3-quiet" data-hs3-restart>Start over</button></p>
        <p class="hs3-small hs3-trust">{{ s.trust_line }}</p>
      </div>
      <div class="hs3-hero__art">
        {%- comment -%} the real range, labelled Example: someone else's dog, today's Shopify prices {%- endcomment -%}
        <div class="hs3-fan">
          <span class="hs3-example">EXAMPLE</span>
          {%- assign fan = 'print,mug,blanket' | split: ',' -%}
          {%- for k in fan -%}
            {%- assign pid = 'product_' | append: k -%}
            {%- assign p = s[pid] -%}
            {%- if p != blank -%}
              {%- assign shot = nil -%}
              {%- for m in p.media -%}
                {%- assign a = m.alt | downcase -%}
                {%- if m.media_type == 'image' and m.alt != blank -%}
                  {%- unless a contains 'shown in your cart' or a contains 'blank ' or a contains 'checkout tile' -%}{%- assign shot = m -%}{%- break -%}{%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
              <a class="hs3-fan__item hs3-fan__item--{{ k }}" href="{{ p.url }}">
                {%- if shot -%}{{ shot | image_url: width: 600 | image_tag: alt: shot.alt, loading: 'eager', sizes: '(min-width: 1000px) 240px, 34vw', class: 'hs3-fan__img' }}{%- endif -%}
                <span class="hs3-fan__name">{% case k %}{% when 'mug' %}Mug{% when 'print' %}Portrait{% else %}Blanket{% endcase %}</span>
                <span class="hs3-fan__price">{% if p.price_varies %}From {% endif %}{{ p.price_min | money_without_trailing_zeros }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="hs3-peek">
          <span class="hs3-biscuit hs3-biscuit--peek" aria-hidden="true"></span>
          <span class="hs3-bubble hs3-bubble--peek">{{ s.peek }}</span>
        </div>
      </div>
      <ol class="hs3-beats">
        <li><span class="hs3-beats__n">1</span>{{ s.beat_one }}</li>
        <li><span class="hs3-beats__n">2</span>{{ s.beat_two }}</li>
        <li><span class="hs3-beats__n">3</span>{{ s.beat_three }}</li>
      </ol>
      {%- comment -%} The signature feature, free to try before anything is asked: one example note at
        each end of the slider and in between (Krish, 27 Oct). Labelled Example. {%- endcomment -%}
      <div class="hs3-demo{% if s.examples_on %} hs3-demo--art{% endif %}">
        <div class="hs3-demo__head"><span class="hs3-label">{{ s.demo_label }}</span><strong data-hs3-demo-name>Sentimental</strong></div>
        {%- if s.examples_on -%}
          {%- comment -%} The slider moves the painting too: one dog at each tone, from the reviewed 28 Oct batch
            (design/examples-2026-10-28/site.json; Krish, 28 Oct). hs3.js shows the one that matches the slider. {%- endcomment -%}
          <div class="hs3-demo__art" data-hs3-demo-art>
            <span class="hs3-example">EXAMPLE</span>
            <img class="hs3-demo__img is-on" src="{{ 'hs-example-pug-sentimental-portrait.webp' | asset_url }}" alt="Example: a pug lying in autumn leaves, soft-eyed and still, in vintage screenprint. Sentimental." width="600" height="900" loading="lazy" decoding="async" data-hs3-demo-img="0">
            <img class="hs3-demo__img" src="{{ 'hs-example-pug-warm-portrait.webp' | asset_url }}" alt="Example: the same pug standing in the leaves with a head tilt and a small smile, in vintage screenprint. Warm with a wink." width="600" height="900" loading="lazy" decoding="async" data-hs3-demo-img="1" aria-hidden="true">
            <img class="hs3-demo__img" src="{{ 'hs-example-pug-hilarious-portrait.webp' | asset_url }}" alt="Example: the same pug bounding at you through flying leaves, tongue out, in vintage screenprint. Hilarious." width="600" height="900" loading="lazy" decoding="async" data-hs3-demo-img="2" aria-hidden="true">
          </div>
        {%- endif -%}
        <div class="hs3-note hs3-note--demo">
          <span class="hs3-example">EXAMPLE</span>
          <div class="hs3-note__for">For {{ s.demo_for }}</div>
          <div class="hs3-note__lines">
            <span class="hs3-line hs3-ink" data-hs3-demo-line="0">{{ s.demo_sentimental }}</span>
            <span class="hs3-line hs3-ink" data-hs3-demo-line="1" hidden>{{ s.demo_warm }}</span>
            <span class="hs3-line hs3-ink" data-hs3-demo-line="2" hidden>{{ s.demo_hilarious }}</span>
          </div>
          <span class="hs3-sign">Love, {{ s.demo_dog }}</span>
        </div>
        <div class="hs3-tone__row"><span>Sentimental</span><input type="range" min="0" max="2" step="1" value="0" aria-label="Try the tone" aria-valuetext="Sentimental" data-hs3-demo><span>Hilarious</span></div>
        <p class="hs3-small">{{ s.demo_note }}</p>
      </div>
      {%- if s.examples_on -%}
        {%- comment -%} The same slider on every gift: one dog at both ends on a mug, then a portrait, a blanket
          and another mug. Stock photos of dogs, painted by the store's own prompts; every picture says Example. {%- endcomment -%}
        <section class="hs3-range" aria-labelledby="hs3-range-h">
          <h2 class="hs3-range__h" id="hs3-range-h">{{ s.range_heading }}</h2>
          <p class="hs3-small">{{ s.range_note }}</p>
          <div class="hs3-range__pair">
            <figure><img class="hs3-range__img" src="{{ 'hs-example-golden-sentimental-mug.webp' | asset_url }}" alt="Example mug art: a golden retriever puppy asleep on a rug, chin on its paws, in cut-paper collage. Sentimental." width="960" height="640" loading="lazy" decoding="async"><figcaption>Mug · Sentimental</figcaption></figure>
            <figure><img class="hs3-range__img" src="{{ 'hs-example-golden-hilarious-mug.webp' | asset_url }}" alt="Example mug art: the same puppy rolling belly-up on the rug with its paws in the air, in cut-paper collage. Hilarious." width="960" height="640" loading="lazy" decoding="async"><figcaption>Mug · Hilarious</figcaption></figure>
          </div>
          <div class="hs3-range__tiles">
            <figure><img class="hs3-range__img" src="{{ 'hs-example-golden-sentimental-portrait.webp' | asset_url }}" alt="Example portrait art: a golden retriever puppy resting its chin on a paw, eyes half closed, in cut-paper collage. Sentimental." width="480" height="720" loading="lazy" decoding="async"><figcaption>Portrait · Sentimental</figcaption></figure>
            <figure><img class="hs3-range__img" src="{{ 'hs-example-golden-sentimental-blanket.webp' | asset_url }}" alt="Example blanket art: a repeated pattern of a sleepy golden retriever puppy among leaf sprigs and hearts, in cut-paper collage. Sentimental." width="720" height="720" loading="lazy" decoding="async"><figcaption>Blanket · Sentimental</figcaption></figure>
            <figure><img class="hs3-range__img" src="{{ 'hs-example-pug-hilarious-mug.webp' | asset_url }}" alt="Example mug art: a pug leaping into autumn leaves with its tongue out, in vintage screenprint. Hilarious." width="720" height="480" loading="lazy" decoding="async"><figcaption>Mug · Hilarious</figcaption></figure>
          </div>
          <span class="hs3-example">EXAMPLES</span>
        </section>
      {%- endif -%}
      {%- comment -%} the policies stay one tap away; Heartside's own footer replaces this line once it is placed {%- endcomment -%}
      <p class="hs3-legal">
        {%- if shop.privacy_policy -%}<a href="{{ shop.privacy_policy.url }}">Privacy</a> · {% endif -%}
        {%- if shop.terms_of_service -%}<a href="{{ shop.terms_of_service.url }}">Terms</a> · {% endif -%}
        {%- if shop.shipping_policy -%}<a href="{{ shop.shipping_policy.url }}">Shipping</a> · {% endif -%}
        {%- if shop.refund_policy -%}<a href="{{ shop.refund_policy.url }}">Refunds</a> · {% endif -%}
        {{ s.legal_note }}
      </p>
    </div>
  </div>
  <noscript><p class="hs3-small">Buddy needs JavaScript to chat. Turn it on, or email hello@krishraja.com and a person will help.</p></noscript>
  <p class="hs3-privacy" data-hs3-privacy hidden>{{ s.privacy }}</p>
  {%- comment -%} The lead the chat keeps (27 Oct): a buyer not ready to choose leaves an email for one
    reminder before Christmas delivery closes. Shopify's own customer form; the newsletter tag is
    what makes them a subscriber. hs3.js shows it on the choose and card screens, and after a post. {%- endcomment -%}
  {%- if s.remind_on -%}
    <div class="hs3-remind" data-hs3-remind hidden>
      {%- form 'customer', id: 'hs3-remind-form', class: 'hs3-remind__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="hs3-remind__done" role="status" data-hs3-remind-show>{{ s.remind_done }}</p>
        {%- else -%}
          <input type="hidden" name="contact[tags]" value="newsletter, buddy-reminder">
          <label class="hs3-label" for="hs3-remind-email">{{ s.remind_label }}</label>
          <div class="hs3-row hs3-row--typed">
            <input id="hs3-remind-email" class="hs3-field" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required>
            <button type="submit" class="hs3-btn hs3-btn--small">Remind me</button>
          </div>
          {%- if form.errors -%}<p class="hs3-small" role="alert" data-hs3-remind-show>{{ form.errors | default_errors }}</p>{%- endif -%}
          <p class="hs3-small">{{ s.remind_fine }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HS3 gift chat",
  "tag": "section",
  "class": "hs3-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "remind_on",
      "label": "Offer a Christmas reminder by email on the choose screen",
      "info": "Adds the email to Shopify customers with the newsletter and buddy-reminder tags. Someone must send that reminder.",
      "default": true
    },
    {
      "type": "text",
      "id": "remind_label",
      "label": "Reminder: ask",
      "default": "Not ready to choose? Get one reminder before Christmas delivery closes."
    },
    {
      "type": "text",
      "id": "remind_fine",
      "label": "Reminder: fine print",
      "default": "Your email joins Heartside's list. Unsubscribe any time."
    },
    {
      "type": "text",
      "id": "remind_done",
      "label": "Reminder: thanks",
      "default": "Done. I'll send one reminder before Christmas delivery closes."
    },
    {
      "type": "checkbox",
      "id": "core_purchase",
      "label": "Enable tested core native product routes",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "artwork_candidates",
      "label": "Draft shared artwork choices",
      "default": false,
      "info": "Candidate controls only. Does not enable image generation or qualified previews."
    },
    {
      "type": "paragraph",
      "content": "Gifts from your dog: the chat with Buddy, the reveal and the gift picker. Each step has its own address (/?step=). Buddy's lines are in assets/hs3.js. Prices and photos come from the products picked below."
    },
    {
      "type": "header",
      "content": "First screen"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Gifts from your dog"
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Your dog"
    },
    {
      "type": "text",
      "id": "headline_em",
      "label": "Headline, italic part",
      "default": "loves you too."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Line under the headline",
      "default": "Tell Buddy about your dog and the person they love most. We'll make something from your dog that they'll use every day."
    },
    {
      "type": "text",
      "id": "peek",
      "label": "Buddy's first bubble",
      "default": "Psst. Who does your dog love most?"
    },
    {
      "type": "text",
      "id": "gifts_note",
      "label": "Under the gift pills",
      "default": "Chat for a minute, then put your words on any of these. Pick one, or a few."
    },
    {
      "type": "text",
      "id": "start",
      "label": "Button",
      "default": "Start with your dog"
    },
    {
      "type": "text",
      "id": "trust_line",
      "label": "Under the button",
      "default": "Free US shipping on every order. A person checks every design before it prints."
    },
    {
      "type": "text",
      "id": "beat_one",
      "label": "Step 1",
      "default": "Tell Buddy about your dog."
    },
    {
      "type": "text",
      "id": "beat_two",
      "label": "Step 2",
      "default": "Add a photo, now or on the gift."
    },
    {
      "type": "text",
      "id": "beat_three",
      "label": "Step 3",
      "default": "Slide from sentimental to hilarious."
    },
    {
      "type": "header",
      "content": "Try the slider (example)"
    },
    {
      "type": "text",
      "id": "demo_label",
      "label": "Label",
      "default": "Try the slider"
    },
    {
      "type": "text",
      "id": "demo_for",
      "label": "Example person",
      "default": "Sarah"
    },
    {
      "type": "text",
      "id": "demo_dog",
      "label": "Example dog",
      "default": "Milo"
    },
    {
      "type": "text",
      "id": "demo_sentimental",
      "label": "Sentimental line",
      "default": "I'd choose you every time. Even when you leave."
    },
    {
      "type": "text",
      "id": "demo_warm",
      "label": "Warm with a wink line",
      "default": "You're my favorite person. The fridge is a close second."
    },
    {
      "type": "text",
      "id": "demo_hilarious",
      "label": "Hilarious line",
      "default": "I ate one sock for you. Just the one. You're welcome."
    },
    {
      "type": "text",
      "id": "demo_note",
      "label": "Under the slider",
      "default": "Every gift gets a slider like this. It sets the words and the painting."
    },
    {
      "type": "checkbox",
      "id": "examples_on",
      "label": "Show the example paintings",
      "info": "The slider's pictures and the Same slider, every gift strip, from design/examples-2026-10-28/site.json.",
      "default": true
    },
    {
      "type": "text",
      "id": "range_heading",
      "label": "Example strip heading",
      "default": "Same slider, every gift"
    },
    {
      "type": "text",
      "id": "range_note",
      "label": "Under the strip heading",
      "default": "The tone you choose sets the painting too. These are stock photos of dogs, painted the way your gift will be."
    },
    {
      "type": "header",
      "content": "Buddy's AI (n8n)"
    },
    {
      "type": "checkbox",
      "id": "ai_on",
      "label": "Use the AI for typed answers",
      "info": "Off: typed answers become lines in the buyer's own words, with no AI call. Chip answers never call the AI.",
      "default": true
    },
    {
      "type": "text",
      "id": "typed_url",
      "label": "Typed answer webhook",
      "default": "https://krishraja10101.app.n8n.cloud/webhook/heartside-typed-answer"
    },
    {
      "type": "text",
      "id": "compose_url",
      "label": "Compose webhook",
      "default": "https://krishraja10101.app.n8n.cloud/webhook/heartside-compose"
    },
    {
      "type": "text",
      "id": "legal_note",
      "label": "Company note under the first screen",
      "info": "A quiet line under the first screen with the policy links, until the Heartside footer is placed.",
      "default": "Heartside is a Mindmaker LLC company."
    },
    {
      "type": "textarea",
      "id": "privacy",
      "label": "AI privacy note",
      "info": "Shows wherever the buyer can type. Keep it true to the privacy policy.",
      "default": "Your answers, including choices you select, are processed through n8n using Google Gemini and Anthropic Claude to write your note. Your photo and artwork instructions are processed through Teeinblue using OpenAI. We don't send your email, address or payment details to the text-writing services."
    },
    {
      "type": "header",
      "content": "The gifts"
    },
    {
      "type": "product",
      "id": "product_mug",
      "label": "Mug product"
    },
    {
      "type": "product",
      "id": "product_blanket",
      "label": "Blanket product"
    },
    {
      "type": "checkbox",
      "id": "blanket_purchase",
      "label": "Enable native blanket purchase route",
      "default": false,
      "info": "With shared artwork choices enabled, sends only the selected blanket product to blanket-native. Enable after its native campaign, price and purchase flow are verified."
    },
    {
      "type": "product",
      "id": "product_print",
      "label": "Portrait product"
    },
    {
      "type": "product",
      "id": "product_ornament",
      "label": "Ornament product (held)"
    },
    {
      "type": "checkbox",
