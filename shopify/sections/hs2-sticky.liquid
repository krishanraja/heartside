{%- render 'hs2-head' -%}
<div class="hs2">
  <div class="hs2-sticky" data-hs2-sticky>
    <a href="{{ section.settings.link | default: '#review' }}" tabindex="-1"><span class="hs2-sticky__main">{% render 'hs2-t', text: section.settings.text %}</span><span class="hs2-sticky__sub" data-hs2-countdown="sub" hidden></span></a>
  </div>
</div>

{% schema %}
{
  "name": "HS sticky review button",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "Appears once the hero has scrolled away; hides while the review builder or the footer is on screen." },
    { "type": "text", "id": "text", "label": "Button", "default": "Make my poster · $39" },
    { "type": "text", "id": "link", "label": "Goes to", "info": "#review on the homepage; #buy on the ad landing page.", "default": "#review" }
  ],
  "presets": [{ "name": "HS sticky review button" }]
}
{% endschema %}
