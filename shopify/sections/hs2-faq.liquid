{%- render 'hs2-head' -%}
<div class="hs2">
  <section class="hs2-faq" aria-labelledby="faq-h-{{ section.id }}">
    <h2 id="faq-h-{{ section.id }}">{{ section.settings.heading }}</h2>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}</summary><p>{% render 'hs2-t', text: block.settings.answer %}</p></details>
    {%- endfor -%}
  </section>
</div>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in section.blocks -%}
  {%- comment -%} Shopify ends an output tag at the first closing brace, so the token replacing happens in this tag {%- endcomment -%}
  {%- assign hs_answer = block.settings.answer | replace: '{dogs}', "your dog's" | replace: '{dog}', 'your dog' -%}
  { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ hs_answer | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
] }
</script>
{%- endif -%}

{% schema %}
{
  "name": "HS HR FAQs",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "HR FAQs" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Where do you ship?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Anywhere in the US, free." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "HS HR FAQs" }]
}
{% endschema %}
