{%- render 'hs2-head' -%}
{%- liquid
  assign s = section.settings
  assign mail = s.email | strip
  assign mail_link = '<a href="mailto:' | append: mail | append: '">' | append: mail | append: '</a>'
-%}
<div class="hs2">
  <section id="faq" class="hs2-faq" aria-labelledby="faq-h-{{ section.id }}">
    <div class="hs2-faq__inner">
      <h2 class="hs2-faq__head" id="faq-h-{{ section.id }}" data-hs2-reveal>{{ s.heading }}</h2>

      <aside class="hs2-faq__desk" aria-label="{{ s.desk_eyebrow | escape }}" data-hs2-reveal style="--d: .08s">
        <figure class="hs2-faq__photo">
          {%- if s.image != blank -%}
            {{ s.image | image_url: width: 1000 | image_tag: widths: '500, 800, 1000', sizes: '(min-width: 900px) 380px, 100vw', loading: 'lazy', alt: s.alt }}
          {%- else -%}
            <img src="{{ 'hs-photo-asleep-640.webp' | asset_url }}" srcset="{{ 'hs-photo-asleep-640.webp' | asset_url }} 640w, {{ 'hs-photo-asleep-1200.webp' | asset_url }} 1200w"
              sizes="(min-width: 900px) 380px, 100vw" width="640" height="640" loading="lazy" alt="{{ s.alt | escape }}">
          {%- endif -%}
          <figcaption class="hs2-faq__status">{% render 'hs2-t', text: s.status %}</figcaption>
        </figure>
        <div class="hs2-faq__card">
          <div class="hs2-faq__eyebrow">{{ s.desk_eyebrow }}</div>
          <p>{% render 'hs2-t', text: s.desk_text %}</p>
          {%- if mail != blank -%}<a class="hs2-faq__mail" href="mailto:{{ mail }}">{{ mail }}</a>{%- endif -%}
        </div>
      </aside>

      <div class="hs2-faq__list" data-hs2-faq data-hs2-reveal data-hs2-group>
        {%- for block in section.blocks -%}
          {%- liquid
            assign num = forloop.index | prepend: '00' | slice: -3, 3
            assign answer = block.settings.answer
            if mail != blank
              assign answer = answer | replace: mail, mail_link
            endif
          -%}
          <details class="hs2-ticket" name="hs2-faq-{{ section.id }}" style="--i: {{ forloop.index0 }}" {% if forloop.first and s.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary><span class="hs2-ticket__no"><span class="hs2-ticket__word">TICKET </span>{{ num }}</span><span class="hs2-ticket__q">{{ block.settings.question }}</span><span class="hs2-ticket__icon" aria-hidden="true"></span></summary>
            <div class="hs2-ticket__a">
              <p>{% render 'hs2-t', text: answer %}</p>
              <span class="hs2-ticket__stamp" aria-hidden="true">RESOLVED</span>
            </div>
          </details>
        {%- endfor -%}

        <button type="button" class="hs2-faq__more" data-hs2-faq-more hidden><span data-hs2-faq-more-n>4</span> more tickets</button>
        {%- if s.close_text != blank -%}
          <div class="hs2-faq__close">
            <p>{% render 'hs2-t', text: s.close_text %}</p>
            <a class="hs2-btn" href="#review"><span>{% render 'hs2-t', text: s.close_button %}</span></a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </section>
</div>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in section.blocks -%}
  {%- comment -%} Shopify ends an output tag at the first closing brace, so the token replacing happens in this tag {%- endcomment -%}
  {%- assign hs_answer = block.settings.answer -%}
  {%- assign hs_head = hs_answer | slice: 0, 5 -%}
  {%- if hs_head == '{dog}' -%}{%- assign hs_answer = hs_answer | remove_first: '{dog}' | prepend: 'Your dog' -%}{%- endif -%}
  {%- assign hs_answer = hs_answer | replace: '{dogs}', "your dog's" | replace: '{dog}', 'your dog' -%}
  { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ hs_answer | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
] }
</script>
{%- endif -%}

{% schema %}
{
  "name": "HS HR FAQs",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "The HR help desk. {dog}, {dogs} and {person} work in every text field. The email address below becomes a link wherever it appears in an answer." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "HR FAQs" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first ticket", "default": true },
    { "type": "image_picker", "id": "image", "label": "Help desk photo", "info": "Empty uses status-asleep.jpg, the spaniel asleep on the laptop." },
    { "type": "text", "id": "alt", "label": "Photo description", "default": "A spaniel asleep on a laptop, next to a to-do list" },
    { "type": "text", "id": "status", "label": "Photo caption", "default": "HR is in a meeting (asleep)" },
    { "type": "text", "id": "desk_eyebrow", "label": "Desk label", "default": "SELF-SERVICE DESK" },
    { "type": "textarea", "id": "desk_text", "label": "Desk text", "default": "HR is asleep, so the answers are filed here. Anything {dog} can't answer goes to a person." },
    { "type": "text", "id": "email", "label": "Contact email", "default": "krish@heartside.io" },
    { "type": "text", "id": "close_text", "label": "Closing line", "default": "Still deciding? {dog} has already decided." },
    { "type": "text", "id": "close_button", "label": "Closing button", "default": "Make {dogs} poster · $39" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Where do you ship?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Anywhere in the US, free." }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [{ "name": "HS HR FAQs" }]
}
{% endschema %}
