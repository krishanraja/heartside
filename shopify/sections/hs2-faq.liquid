{%- render 'hs2-head' -%}
{%- liquid
  assign s = section.settings
  assign mail = s.email | strip
  assign mail_link = '<a href="mailto:' | append: mail | append: '">' | append: mail | append: '</a>'
  assign promises = section.blocks | where: 'type', 'promise'
  assign questions = section.blocks | where: 'type', 'question'
-%}
<div class="hs2">
  <section id="faq" class="hs2-faq" aria-labelledby="faq-h-{{ section.id }}">
    <div class="hs2-faq__inner">
      <h2 class="hs2-faq__head" id="faq-h-{{ section.id }}" data-hs2-reveal>{{ s.heading }}</h2>

      {%- comment -%} Our promises sit beside the questions: true of every order, said once. {%- endcomment -%}
      <aside class="hs2-faq__desk" aria-label="{{ s.promises_label | escape }}" data-hs2-reveal style="--d: .08s">
        {%- if promises.size > 0 -%}
          <ul class="hs2-faq__promises">
            {%- for block in promises -%}
              <li {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
                <span><strong>{{ block.settings.title }}</strong>{%- if block.settings.text != blank -%} <span class="hs2-faq__promise-text">{{ block.settings.text }}</span>{%- endif -%}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if mail != blank -%}<p class="hs2-faq__contact">{% render 'hs2-t', text: s.contact %} <a class="hs2-faq__mail" href="mailto:{{ mail }}">{{ mail }}</a></p>{%- endif -%}
      </aside>

      <div class="hs2-faq__list" data-hs2-faq data-hs2-reveal data-hs2-group>
        {%- for block in questions -%}
          {%- liquid
            assign answer = block.settings.answer
            if mail != blank
              assign answer = answer | replace: mail, mail_link
            endif
          -%}
          <details class="hs2-ticket" name="hs2-faq-{{ section.id }}" style="--i: {{ forloop.index0 }}" {% if forloop.first and s.open_first %}open{% endif %} {{ block.shopify_attributes }}>
            <summary><span class="hs2-ticket__q">{{ block.settings.question }}</span><span class="hs2-ticket__icon" aria-hidden="true"></span></summary>
            <div class="hs2-ticket__a">
              <p>{% render 'hs2-t', text: answer %}</p>
            </div>
          </details>
        {%- endfor -%}

        <button type="button" class="hs2-faq__more" data-hs2-faq-more hidden><span data-hs2-faq-more-n>4</span> more questions</button>
        {%- if s.close_text != blank -%}
          <div class="hs2-faq__close">
            <p>{% render 'hs2-t', text: s.close_text %}</p>
            <a class="hs2-btn" href="{{ s.close_link | default: '#review' }}"><span>{% render 'hs2-t', text: s.close_button %}</span></a>
          </div>
        {%- endif -%}
      </div>

    </div>
  </section>
</div>
{%- if questions.size > 0 -%}
<script type="application/ld+json">
{ "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [
  {%- for block in questions -%}
  {%- comment -%} Shopify ends an output tag at the first closing brace, so the token replacing happens in this tag {%- endcomment -%}
  {%- assign hs_answer = block.settings.answer -%}
  {%- assign hs_head = hs_answer | slice: 0, 5 -%}
  {%- if hs_head == '{dog}' -%}{%- assign hs_answer = hs_answer | remove_first: '{dog}' | prepend: 'Your dog' -%}{%- endif -%}
  {%- assign hs_answer = hs_answer | replace: '{dogs}', "your dog's" | replace: '{dog}', 'your dog' -%}
  { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ hs_answer | json }} } }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
] }
</script>
{%- endif -%}

{% schema %}
{
  "name": "HS questions",
  "tag": "section",
  "class": "hs2-section",
  "settings": [
    { "type": "paragraph", "content": "Questions, with our promises beside them. {dog}, {dogs} and {person} work in every text field. The email address below becomes a link wherever it appears in an answer." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "text", "id": "promises_label", "label": "Promises, for screen readers", "default": "Our promises" },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": true },
    { "type": "text", "id": "contact", "label": "Line before the email address", "default": "Anything else:" },
    { "type": "text", "id": "email", "label": "Contact email", "default": "krish@heartside.io" },
    { "type": "text", "id": "close_text", "label": "Closing line", "info": "Empty hides the closing line and its button (on product pages, Add To Cart is already there).", "default": "Still deciding? {dog} has already decided." },
    { "type": "text", "id": "close_button", "label": "Closing button", "default": "Make {dogs} poster · $39" },
    { "type": "text", "id": "close_link", "label": "Closing button goes to", "info": "#review on the homepage; #buy on the ad landing page.", "default": "#review" }
  ],
  "blocks": [
    {
      "type": "promise",
      "name": "Promise",
      "settings": [
        { "type": "paragraph", "content": "Every promise must stay true of every order." },
        { "type": "text", "id": "title", "label": "Promise", "default": "A person checks every order before it prints." },
        { "type": "text", "id": "text", "label": "Detail", "info": "Shows on wider screens." }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Where do you ship?" },
        { "type": "textarea", "id": "answer", "label": "Answer", "default": "Anywhere in the US, free." }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{ "name": "HS questions" }]
}
{% endschema %}
