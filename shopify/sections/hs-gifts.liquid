{%- render 'hs-head' -%}
{%- assign s = section.settings -%}
{%- capture hs_active -%}{% render 'hs-offer', part: 'active' %}{%- endcapture -%}
{%- capture hs_pct -%}{% render 'hs-offer', part: 'pct' %}{%- endcapture -%}
{%- capture hs_ends_label -%}{% render 'hs-offer', part: 'ends_label' %}{%- endcapture -%}
<div class="hs hs-gifts hs-section">
  <div class="hs-wrap">
    <div class="hs-gifts__head" data-hs-reveal>
      {%- if s.eyebrow != blank -%}<p class="hs-eyebrow">{{ s.eyebrow }}</p>{%- endif -%}
      <h2>{{ s.heading }}</h2>
      {%- if hs_active == 'true' -%}
        <p class="hs-muted">Every gift is {{ hs_pct }}% off until {{ hs_ends_label }}, with free US shipping.</p>
      {%- endif -%}
    </div>

    <ul class="hs-gifts__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        {%- if p != blank -%}
          <li {{ block.shopify_attributes }} data-hs-reveal>
            <a class="hs-card" href="{{ p.url }}">
              <div class="hs-card__media{% if block.settings.contain %} hs-card__media--contain{% endif %}">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw' }}
                {%- elsif p.featured_media != blank -%}
                  {{ p.featured_media | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 900px) 25vw, 50vw', alt: p.featured_media.alt | default: p.title }}
                {%- else -%}
                  <img class="hs-card__placeholder" src="{{ 'hs-heart.webp' | asset_url }}" alt="" width="240" height="230" loading="lazy">
                {%- endif -%}
              </div>
              <h3 class="hs-card__title">{{ block.settings.title | default: p.title }}</h3>
              {%- if block.settings.promise != blank -%}<p class="hs-card__promise">{{ block.settings.promise }}</p>{%- endif -%}
              {%- render 'hs-price', hs_product: p, note: false -%}
            </a>
          </li>
        {%- elsif request.design_mode -%}
          <li {{ block.shopify_attributes }}>
            <div class="hs-card">
              <div class="hs-card__media"><img class="hs-card__placeholder" src="{{ 'hs-heart.webp' | asset_url }}" alt="" width="240" height="230"></div>
              <h3 class="hs-card__title">{{ block.settings.title | default: 'Choose a product' }}</h3>
              <p class="hs-card__promise">Pick a product for this card. It stays hidden on the live site until you do.</p>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Heartside gifts",
  "tag": "section",
  "class": "hs-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above", "default": "The rest of the shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More ways to keep them close." },
    { "type": "paragraph", "content": "The 30% line and the sale prices only show while the offer runs, and only for products in the All gifts collection." }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the product's own title." },
        { "type": "text", "id": "promise", "label": "One-line promise" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the product's main image." },
        { "type": "checkbox", "id": "contain", "label": "Show the whole image (for renders on a plain background)", "default": false }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Heartside gifts",
      "blocks": [
        { "type": "product", "settings": { "title": "Their Person Ornament", "promise": "Their face and their name, on the tree every year." } },
        { "type": "product", "settings": { "title": "The Heartside Sling", "promise": "For the walk where little legs get tired. Dogs up to 15 lbs." } },
        { "type": "product", "settings": { "title": "The Heartside Tag", "promise": "Their name, on something they wear every day." } },
        { "type": "product", "settings": { "title": "Travel Water Bottle", "promise": "Water for the long walk, in your bag." } }
      ]
    }
  ]
}
{% endschema %}
