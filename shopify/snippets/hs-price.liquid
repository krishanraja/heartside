{%- comment -%}
  Price with the launch discount shown, only while the offer runs and only for
  products in the discounted collection, so the page never shows a price that
  checkout won't honour.

  {% render 'hs-price', hs_product: product, fallback_cents: 3499, note: true %}
  - hs_product: a product (optional). Without one, fallback_cents is used.
  - note: show the "30% off and free US shipping until ..." line.
{%- endcomment -%}
{%- capture hs_active -%}{% render 'hs-offer', part: 'active' %}{%- endcapture -%}
{%- capture hs_pct_s -%}{% render 'hs-offer', part: 'pct' %}{%- endcapture -%}
{%- capture hs_handle -%}{% render 'hs-offer', part: 'collection' %}{%- endcapture -%}
{%- capture hs_ends_label -%}{% render 'hs-offer', part: 'ends_label' %}{%- endcapture -%}
{%- assign hs_pct = hs_pct_s | plus: 0 -%}

{%- if hs_product != blank -%}
  {%- assign hs_was = hs_product.price -%}
  {%- assign hs_in_offer = false -%}
  {%- for c in hs_product.collections -%}
    {%- if c.handle == hs_handle -%}{%- assign hs_in_offer = true -%}{%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- assign hs_was = fallback_cents | plus: 0 -%}
  {%- assign hs_in_offer = true -%}
{%- endif -%}

<div class="hs-price">
  {%- if hs_active == 'true' and hs_in_offer and hs_was > 0 -%}
    {%- assign hs_keep = 100 | minus: hs_pct -%}
    {%- assign hs_now = hs_was | times: hs_keep | divided_by: 100 -%}
    <span class="hs-price__now">{{ hs_now | money }}</span>
    <s class="hs-price__was"><span class="hs-visually-hidden">Regular price </span>{{ hs_was | money }}</s>
    {%- if note -%}
      <span class="hs-price__note">{{ hs_pct }}% off and free US shipping until {{ hs_ends_label }}</span>
    {%- endif -%}
  {%- elsif hs_was > 0 -%}
    <span class="hs-price__now">{{ hs_was | money }}</span>
  {%- endif -%}
</div>
