{%- comment -%}
  Journey mode on a gift page, photo first (Krish, 4 Nov: "one step at a time, non-duplicative, in the
  right order, and then the user purchases"; every step should look like the style screen). A buyer who
  chose the photo, the style and the gifts on the home page lands here: the painter starts at once, the
  studio shows for a few seconds, the questions about the dog and the note follow in the journey's own
  frame while it paints (hs-journey.js, gift mode), then the painting on the real product, one tick and
  one button. Everything else on the page is hidden by hs-journey-choose.css; Teeinblue's working parts
  stay in the page, visually hidden, because they paint and add to cart. Behaviour is in
  assets/hs-journey-choose.js; it shows nothing without a fresh photo-first journey.
{%- endcomment -%}
{{ 'hs-journey.css' | asset_url | stylesheet_tag }}
{{ 'hs-journey-choose.css' | asset_url | stylesheet_tag }}
{%- comment -%} the easel's talk uses the wait room's styles; linked here so it is styled from the first paint {%- endcomment -%}
{{ 'hs-wait.css' | asset_url | stylesheet_tag }}
{%- comment -%} The journey's own scripts are fetched at once and started by the loader after the journey check below,
  ahead of the deferred queue, which waits for Teeinblue's app-v1.js in the head (5 Nov speed review). {%- endcomment -%}
{{ 'hs-breeds.js' | asset_url | preload_tag: as: 'script' }}
{{ 'hs-journey.js' | asset_url | preload_tag: as: 'script' }}
{{ 'hs-journey-choose.js' | asset_url | preload_tag: as: 'script' }}
<section class="hs-jm" data-hs-jm hidden aria-labelledby="hs-jm-title" data-hs-jm-handle="{{ product.handle | escape }}">
  <div class="hsj hs-jm__frame hsj__screen hsj__screen--step" data-hs-jm-frame>
    <header class="hsj-bar">
      <a class="hsj-icon-btn" href="/?step=gifts" aria-label="Back to the gifts"><svg class="hsj-ico" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14.5 5.5 8 12l6.5 6.5"/></svg></a>
      <p class="hsj-bar__step" data-hs-jm-step>The painting</p>
    </header>
    <div class="hsj-progress" role="progressbar" aria-label="Progress" aria-valuemin="0" aria-valuemax="100"><span data-hs-jm-progress style="width:45%"></span></div>
    <main class="hsj-content">
      <div class="hsj-heading">
        <h2 class="hsj-headline" id="hs-jm-title" data-hs-jm-title>Painting your dog</h2>
        <p class="hsj-support" data-hs-jm-sub>A few quick questions while your painting starts.</p>
      </div>
      <div class="hsj-body hs-jm__body">
        <div class="hs-jm__paint" data-hs-jm-paint>
          {%- comment -%} The easel: the studio from the first paint of the page, before Teeinblue's painter opens and
          hs2.js shows its own painting card here (5 Nov judges: nine of eleven buyers saw an empty "Painting your
          dog"). It is the card's first frame (Krish, 5 Nov: "Is there no way we can mask that from the user's
          view?"): the buyer's whole photo, read from this device before the scripts load, the wash, the brush, the
          dog's one speech bubble and the card's bar row, so nothing changes size, label or text when the card
          takes its place. {%- endcomment -%}
          <div class="hs-art hs-jm__easel" data-hs-jm-easel style="{% if s.native_artwork_kind == 'mug' %}--hs-art-ratio: 3 / 2; --hs-art-r: 1.5{% elsif s.native_artwork_kind == 'print' %}--hs-art-ratio: 2 / 3; --hs-art-r: 0.6667{% else %}--hs-art-ratio: 5 / 6; --hs-art-r: 0.8333{% endif %}">
            <div class="hs-art__canvas">
              <div class="hs-art__wash" aria-hidden="true"><i></i><i></i><i></i></div>
              <img class="hs-art__photo" data-hs-jm-photo alt="" width="480" height="480" decoding="sync" hidden>
              <svg class="hs-art__brush" aria-hidden="true" viewBox="0 0 64 64" width="56" height="56"><path d="M44 6c4 0 14 10 14 14 0 3-16 20-22 24l-6-6c4-6 11-32 14-32Z" fill="#121010"/><path d="M28 40l6 6c-2 6-7 12-16 12-5 0-10-2-12-4 6-1 8-4 9-8 1-5 7-8 13-6Z" fill="#a8284e"/></svg>
            </div>
            <div class="hs-wait__talk hs-jm__talk">
              <span class="hs-wait__me" aria-hidden="true"><img data-hs-jm-face alt="" width="52" height="52" hidden><svg class="hs-wait__ico" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><circle cx="6.5" cy="9" r="2.2"/><circle cx="10" cy="5.6" r="2.2"/><circle cx="14" cy="5.6" r="2.2"/><circle cx="17.5" cy="9" r="2.2"/><path d="M12 11c3 0 6 3.6 6 6.4 0 2-1.6 2.9-3.2 2.9-1.3 0-1.9-.7-2.8-.7s-1.5.7-2.8.7C7.6 20.3 6 19.4 6 17.4 6 14.6 9 11 12 11Z"/></svg></span>
              <div class="hs-wait__bubble"><p class="hs-wait__who" data-hs-jm-who>your dog, live from the studio</p><p class="hs-wait__say" data-hs-jm-say role="status" aria-live="polite">Getting the paints out. My photo goes on the easel first.</p></div>
            </div>
            <div class="hs-art__bar" aria-hidden="true"><span></span></div>
          </div>
        </div>
        <div class="hs-jm__reveal" data-hs-jm-reveal hidden>
          <div class="hs-jm__square">
            <div class="hs-jm__gallery" data-hs-jm-gallery></div>
            <div class="hs-jm__close" data-hs-jm-close hidden><img alt="Your dog's painting, the whole print" width="1000" height="1200" decoding="async"></div>
          </div>
          <div class="hs-jm__views" role="group" aria-label="How to see it">
            <button type="button" class="hsj-chip is-on" aria-pressed="true" data-hs-jm-view="product"><span>On the gift</span></button>
            <button type="button" class="hsj-chip" aria-pressed="false" data-hs-jm-view="close"><span>Whole print</span></button>
          </div>
          <button type="button" class="hs-jm__repaint" data-hs-jm-repaint style="visibility:hidden">Not quite right? Paint it again, free</button>
        </div>
      </div>
    </main>
    <footer class="hsj-dock hs-jm__dock">
      <label class="hs-jm__tick" data-hs-jm-tickrow style="visibility:hidden"><input type="checkbox" data-hs-jm-tick> <span data-hs-jm-tick-text>Yes, this is my dog</span></label>
      <button type="button" class="hsj-btn" data-hs-jm-add><span>Next</span><span class="hsj-btn__dots" aria-hidden="true"></span></button>
      <p class="hs-jm__line" data-hs-jm-line role="status" aria-live="polite"></p>
    </footer>
  </div>
  {%- comment -%} the questions, in the same frame, while it paints (hs-journey.js reads data-hsj-mode) {%- endcomment -%}
  <div class="hsj hs-jm__ask" data-hsj data-hsj-mode="gift" hidden>
    <script type="application/json" data-hsj-config>{}</script>
    <div class="hsj-app" data-hsj-app hidden></div>
  </div>
  {%- comment -%} One free repaint: the same photo and style, painted once more {%- endcomment -%}
  <div class="hs-jm-sheet" data-hs-jm-sheet hidden role="dialog" aria-modal="true" aria-labelledby="hs-jm-sheet-title">
    <div class="hs-jm-sheet__panel">
      <p class="hs-jm-sheet__title" id="hs-jm-sheet-title">Paint it again, free</p>
      <p class="hs-jm__small">We paint the same photo once more, in the same style. You can do this once.</p>
      <button type="button" class="hsj-btn" data-hs-jm-again><span>Paint it again</span></button>
      <button type="button" class="hs-jm__keep" data-hs-jm-keep>Keep this one</button>
    </div>
  </div>
</section>
<script>
  /* journey mode before the first paint, so the product page never shows under the panel and then jumps
     (5 Nov, ten buyers on the live store). hs-journey-choose.js confirms it once the page has loaded and
     takes it back if this guessed wrong. */
  (function (root) {
    try {
      var rv = JSON.parse(sessionStorage.getItem('hs2-review') || '{}') || {}, j = rv.hs_journey, h = root.getAttribute('data-hs-jm-handle');
      if (!j || j.mode !== 'photo-first' || !j.t || Date.now() - j.t > 6 * 36e5) return;
      var on = /[?&]journey=1(&|$)/.test(location.search);
      // the same rules as hs2.js journey(): this product's own key, and a gift in this journey's queue
      // (5 Nov review: any gift's key turned a normal gift page into the panel until the scripts loaded)
      if (!on) on = sessionStorage.getItem('hs2-journey-on:' + {{ product.id | json }}) === String(j.t);
      var mine = (j.queue || []).some(function (q) { var m = /\/products\/([^/?#]+)/.exec(q.url || ''); return m && m[1] === h; });
      if (on && mine) {
        root.hidden = false; document.documentElement.classList.add('hs-jm-on');
        // a later gift comes after the first one's questions: its line starts where they left it
        var at = 0; (j.queue || []).forEach(function (q, i) { var m = /\/products\/([^/?#]+)/.exec(q.url || ''); if (m && m[1] === h && !at) at = i; });
        var bar = root.querySelector('[data-hs-jm-progress]'); if (bar && at > 0) bar.style.width = '95%';
        // the words hs-journey-choose.js will write, written now, so nothing flips when it loads
        var NAME = { mug: 'mug', blanket: 'blanket', print: 'portrait' }, who = String(rv.dog || '').trim(), g = NAME[((j.queue || [])[at] || {}).gift];
        var set = function (sel, t) { var el = root.querySelector(sel); if (el && t) el.textContent = t; };
        set('[data-hs-jm-who]', (who || 'your dog') + ', live from the studio');
        if (at === 0) set('[data-hs-jm-title]', 'Painting ' + (who || 'your dog'));
        else if (g) { set('[data-hs-jm-title]', 'Now the ' + g); set('[data-hs-jm-sub]', 'Painting ' + (who || 'your dog') + ' for the ' + g + ', from the same photo, in the same style.'); }
        // the screen reader hears the studio, never the hidden product page and its photo notes under it
        var buy = root.parentNode; if (buy && buy.id === 'buy') for (var c = buy.firstElementChild; c; c = c.nextElementSibling) if (c !== root) c.setAttribute('aria-hidden', 'true');
        /* the buyer's own photo on the easel from the first paint, read from this device as hs2.js reads it
           (speed review, 5 Nov: the scripts wait seconds behind Teeinblue's). The store is made exactly as
           hs2.js makes it, so a device with no photo database is never left with one hs2.js cannot use. */
        var pt = rv.hs3_photo_t, pn = rv.hs3_photo_next;
        if (pt && window.indexedDB && window.URL && URL.createObjectURL) {
          var o = indexedDB.open('hs2', 1);
          o.onupgradeneeded = function () { o.result.createObjectStore('files'); };
          o.onsuccess = function () {
            var db = o.result, rq;
            try { rq = db.transaction('files', 'readonly').objectStore('files').get('headshot'); } catch (e) { db.close(); return; }
            rq.onerror = function () { db.close(); };
            rq.onsuccess = function () {
              db.close();
              var rec = rq.result;
              if (!rec || !rec.file || (rec.t !== pt && rec.t !== pn) || Date.now() - rec.t >= 3 * 864e5 || window.__hsjmPhoto) return;
              var u = window.__hsjmPhoto = URL.createObjectURL(rec.file), easel = root.querySelector('[data-hs-jm-easel]');
              ['[data-hs-jm-photo]', '[data-hs-jm-face]'].forEach(function (sel) { var img = root.querySelector(sel); if (img && !img.getAttribute('src')) { img.src = u; img.hidden = false; } });
              var paw = root.querySelector('.hs-jm__talk .hs-wait__ico'); if (paw) paw.style.display = 'none';
              if (easel) easel.style.setProperty('--hs-jm-photo', 'url("' + u + '")');
            };
          };
        }
      }
    } catch (e) { /* hs-journey-choose.js decides once the page has loaded */ }
  })(document.currentScript.previousElementSibling);
</script>
<script>
  /* The journey's own scripts, in order, as soon as they arrive (5 Nov speed review). Teeinblue's app block puts
     app-v1.js (424 KB) in the head as a defer script, and deferred scripts run in document order, so a defer tag
     here waited for it: on a cold phone the questions came about 16 s after the page opened. Scripts added like
     this run in their own order, outside that queue; they start once the page is parsed and wait for hs2.js
     only where they need it. Nothing here touches Teeinblue or the photo. */
  [{{ 'hs-breeds.js' | asset_url | json }}, {{ 'hs-journey.js' | asset_url | json }}, {{ 'hs-journey-choose.js' | asset_url | json }}].forEach(function (src) {
    var s = document.createElement('script'); s.src = src; s.async = false; document.head.appendChild(s);
  });
</script>
