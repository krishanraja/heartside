{%- comment -%}
  Structured data (schema.org JSON-LD) for search and answer engines (21 Oct 2026; strategy in
  growth-heartside docs/GEO-AEO.md). Helio only emits a bare Organization, so:
  - kind: 'home' adds Heartside's Organization, the WebSite and the three core gifts as an ItemList;
  - kind: 'product' adds the Product with one Offer per variant (price, availability, free US shipping
    with its handling and transit days from /policies/shipping-policy, the made-to-order return terms from
    /policies/refund-policy) and a BreadcrumbList;
  - kind: 'answers' lists every Answers article for the library page (10 Nov 2026);
  - the home graph also carries an FAQPage from the live policies (10 Nov 2026).
  Every claim here must be true on the page and in the policies: no ratings or reviews until real
  ones exist (HANDOFF 2.3). Rendered once per page by hs3-chat (home) and hs2-product (product).
{%- endcomment -%}
{%- assign hs_site = 'https://heartside.io' -%}{%- comment -%} the canonical domain, also on preview themes {%- endcomment -%}
{%- assign hs_org = hs_site | append: '/#organization' -%}
{%- if kind == 'home' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": {{ hs_org | json }},
      "name": "Heartside",
      "alternateName": "Heartside: Personalized Dog Gifts",
      "url": {{ hs_site | json }},
      "logo": {{ 'hs-logo.png' | asset_url | prepend: 'https:' | json }},
      "email": "hello@krishraja.com",
      "slogan": "Your dog loves you too.",
      "description": "Heartside makes personalized gifts from a dog to the person it loves: an illustrated mug, a sherpa blanket, and a portrait available unframed or framed. Each gift is the dog painted from the owner's photo, with no words printed on it; a note in the dog's voice comes in the box and on a free digital card. The painting and the note follow the details shared with Buddy, Heartside's dachshund host. Made to order by Printful for US customers. A person checks every order before it prints. Shipping is free on every US order.",
      "areaServed": { "@type": "Country", "name": "United States" },
      "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "email": "hello@krishraja.com", "areaServed": "US", "availableLanguage": "English" },
      "knowsAbout": ["personalized dog gifts", "custom dog portraits from a photo", "custom dog mugs", "custom dog blankets", "gifts from the dog", "dog lover gifts"],
      "sameAs": ["https://www.instagram.com/yourdoghasnotes", "https://www.facebook.com/yourdoghasnotes", "https://www.tiktok.com/@yourdoghasnotes"]
    },
    {
      "@type": "WebSite",
      "@id": {{ hs_site | append: '/#website' | json }},
      "url": {{ hs_site | json }},
      "name": "Heartside",
      "inLanguage": "en-US",
      "publisher": { "@id": {{ hs_org | json }} }
    },
    {
      "@type": "FAQPage",
      "@id": {{ hs_site | append: '/#faq' | json }},
      "mainEntity": [
        { "@type": "Question", "name": "What is Heartside?", "acceptedAnswer": { "@type": "Answer", "text": "Heartside makes gifts from your dog: an illustrated mug, a sherpa blanket or a portrait, each with your dog painted from your photo. A short note in your dog's own voice comes in the box and on a free digital card." } },
        { "@type": "Question", "name": "How much do Heartside gifts cost?", "acceptedAnswer": { "@type": "Answer", "text": "The illustrated mug is $45, the 12 x 18 portrait is $59 unframed or $119 framed in black, white or red oak, and the 50 x 60 sherpa blanket is $129. Two gifts save 15% and three or more save 20%. Shipping is free on every US order." } },
        { "@type": "Question", "name": "How does a custom dog gift from a photo work?", "acceptedAnswer": { "@type": "Answer", "text": "Add one clear photo of your dog, pick a look and a feel, and answer a few taps about your dog. The painting is ready in about a minute and you see it on the gift before you order. A person checks every order before it prints." } },
        { "@type": "Question", "name": "When should I order a personalized dog gift for Christmas?", "acceptedAnswer": { "@type": "Answer", "text": "Order by December 4 for Christmas delivery to a US address. Printing usually takes 2 to 5 business days and delivery another 3 to 7." } },
        { "@type": "Question", "name": "What if a gift arrives damaged or misprinted?", "acceptedAnswer": { "@type": "Answer", "text": "Tell Heartside within 30 days of delivery with a photo, and you get a full refund including shipping or a free remake. Nothing needs to be sent back." } },
        { "@type": "Question", "name": "Are words printed on the gifts?", "acceptedAnswer": { "@type": "Answer", "text": "No. Each gift carries the painting only. The note from your dog comes in the box and as a free digital card." } }
      ]
    },
    {
      "@type": "ItemList",
      "name": "Gifts from your dog",
      "itemListElement": [
        {%- assign hs_n = 0 -%}
        {%- assign hs_handles = 'your-dogs-illustrated-mug,your-dogs-personality-blanket,your-dogs-portrait' | split: ',' -%}
        {%- for handle in hs_handles -%}
          {%- assign p = all_products[handle] -%}
          {%- if p and p.available -%}
            {%- if hs_n > 0 -%},{%- endif -%}
            {%- assign hs_n = hs_n | plus: 1 -%}
            { "@type": "ListItem", "position": {{ hs_n }}, "name": {{ p.title | json }}, "url": {{ hs_site | append: p.url | json }} }
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  ]
}
</script>
{%- elsif kind == 'product' and product -%}
{%- assign hs_url = hs_site | append: product.url -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": {{ hs_url | append: '#product' | json }},
      "name": {{ product.title | json }},
      "url": {{ hs_url | json }},
      "description": {{ product.description | strip_html | strip_newlines | strip | truncate: 1500 | json }},
      "image": [
        {%- for m in product.images limit: 10 -%}
          {{ m | image_url: width: 1200 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ],
      "brand": { "@type": "Brand", "name": "Heartside" },
      "manufacturer": { "@id": {{ hs_org | json }} },
      "offers": [
        {%- for v in product.variants -%}
        {
          "@type": "Offer",
          "name": {{ v.title | json }},
          {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
          "url": {{ hs_url | append: '?variant=' | append: v.id | json }},
          "price": {{ v.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | default: 'USD' | json }},
          "availability": "{% if v.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition",
          "seller": { "@id": {{ hs_org | json }} },
          "shippingDetails": {
            "@type": "OfferShippingDetails",
            "shippingRate": { "@type": "MonetaryAmount", "value": 0, "currency": "USD" },
            "shippingDestination": { "@type": "DefinedRegion", "addressCountry": "US" },
            "deliveryTime": {
              "@type": "ShippingDeliveryTime",
              "handlingTime": { "@type": "QuantitativeValue", "minValue": 2, "maxValue": 5, "unitCode": "DAY" },
              "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 7, "unitCode": "DAY" }
            }
          },
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "applicableCountry": "US",
            "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
            "merchantReturnLink": {{ hs_site | append: '/policies/refund-policy' | json }}
          }
        }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Heartside", "item": {{ hs_site | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ hs_url | json }} }
      ]
    }
  ]
}
</script>
{%- elsif kind == 'article' and article -%}
{%- assign hs_url = hs_site | append: article.url -%}
{%- assign hs_answer = article.excerpt | strip_html | strip_newlines | strip -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": {{ hs_url | append: '#article' | json }},
      "headline": {{ article.title | json }},
      "description": {{ hs_answer | json }},
      "url": {{ hs_url | json }},
      "mainEntityOfPage": {{ hs_url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "inLanguage": "en-US",
      {%- if article.image %}"image": {{ article.image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      "author": { "@id": {{ hs_org | json }} },
      "publisher": { "@id": {{ hs_org | json }} },
      "isPartOf": { "@type": "Blog", "name": {{ blog.title | json }}, "url": {{ hs_site | append: blog.url | json }} }
    }
    {%- if hs_answer != blank -%},
    {
      "@type": "FAQPage",
      "mainEntity": [{ "@type": "Question", "name": {{ article.title | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ hs_answer | json }} } }]
    }
    {%- endif -%},
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Heartside", "item": {{ hs_site | json }} },
        { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ hs_site | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": {{ hs_url | json }} }
      ]
    }
  ]
}
</script>
{%- elsif kind == 'answers' and blog -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": {{ hs_site | append: blog.url | json }},
  "name": "Gifts from your dog, answered",
  "url": {{ hs_site | append: blog.url | json }},
  "isPartOf": { "@id": {{ hs_site | append: '/#website' | json }} },
  "publisher": { "@id": {{ hs_org | json }} },
  "mainEntity": {
    "@type": "ItemList",
    "itemListElement": [
      {%- for a in blog.articles limit: 50 -%}
      { "@type": "ListItem", "position": {{ forloop.index }}, "name": {{ a.title | json }}, "url": {{ hs_site | append: a.url | json }} }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
</script>
{%- endif -%}
