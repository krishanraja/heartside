{%- comment -%}
  The product page as the chat's last step (27 Oct): Buddy's bar says where the buyer is, and
  the journey card (filled by hs2.js journeyCard from what they told Buddy) shows what carries
  over, each part with a Change link back to its exact chat step. A direct visit gets Buddy's
  offer to start in the chat, or to fill the gift in right here.
{%- endcomment -%}
{%- liquid
  case s.native_artwork_kind
    when 'mug'
      assign gift = 'mug'
    when 'print'
      assign gift = 'portrait'
    else
      assign gift = 'blanket'
  endcase
-%}
<div class="hs-journey" data-hs-journey data-gift="{{ gift }}">
  <div class="hs-journey__bar">
    <span class="hs-journey__buddy">{% render 'hs-buddy' %}</span>
    <p class="hs-journey__line" data-hs-journey-line>Hi, I'm Buddy. I help dogs pick gifts for their people.</p>
  </div>
  <div class="hs-journey__intro" data-hs-journey-intro>
    <p>Tell me about your dog first and I'll set this {{ gift }} up for you. It takes about a minute.</p>
    <a class="hs-journey__go" href="{{ routes.root_url }}?step=dog&amp;gift={{ gift }}">Tell me about your dog</a>
    <button type="button" class="hs-journey__here" data-hs-journey-here>I'll fill it in here</button>
  </div>
  <div class="hs-journey__card" data-hs-journey-card hidden></div>
  {%- comment -%} Before first paint: a buyer arriving from the chat never sees the direct-visit offer
    flash up for a second (28 Oct, Recording 4). The same test as hs2.js journeyCard, the chat's saved
    dog and words; journeyCard then fills the card and the line. {%- endcomment -%}
  <script>
    (function (box) {
      try {
        var s = JSON.parse(window.sessionStorage.getItem('hs2-review') || '{}') || {};
        if (!String(s.dog || '').trim() || !s.hs3_lines) return;
        var intro = box.querySelector('[data-hs-journey-intro]'), line = box.querySelector('[data-hs-journey-line]');
        if (intro) intro.hidden = true;
        if (line) line.textContent = 'Getting your {{ gift }} ready.';
      } catch (e) { /* the server's offer stays until hs2.js runs */ }
    })(document.currentScript.parentNode);
  </script>
</div>
