{% doc %}
  Cart Products

  Renders the cart products list or empty cart state.

  @param {boolean} [force_empty] - Force render empty cart state
  @param {block} [block] - The block object providing settings and editor attributes.
  @param {string} [context] - Render context — pass `'drawer'` when rendered inside the cart drawer to enable drawer-specific styles.

  @example
  {% render 'cart-products', force_empty: true %}
{% enddoc %}

{% render 'cart-typography-styles' %}
{% render 'price-styles' %}

{% liquid
  assign block_settings = block.settings
%}

{%- if block_settings.input_style == 'custom' -%}
  {%- capture custom_style -%}
    {%- render 'input-custom-styles', block_settings: block_settings -%}
    --style-border-width-inputs: {{ block_settings.border_width }}px;
    --style-border-radius-inputs: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-primary: {{ block_settings.border_radius }}px;
    --style-border-radius-buttons-secondary: {{ block_settings.border_radius }}px;
  {%- endcapture -%}
{%- endif -%}

<script
  src="{{ 'component-cart-items.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'volume-pricing-info.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'text-component-shimmer-styles' %}

<div
  {{ block.shopify_attributes }}
  class="cart-items__wrapper{% if context == 'drawer' and cart.empty? or force_empty %} cart-items__wrapper--drawer-empty{% endif %}"
  {% if context == 'drawer' and cart.empty? or force_empty %}
    data-cart-drawer-empty
  {% endif %}
  style="
    {%- if settings.product_title_case == 'uppercase' -%}--product-title-case: uppercase;{%- endif -%}
    {{- custom_style -}}
  "
>
  {% if cart.empty? or force_empty %}
    {%- if shop.customer_accounts_enabled and customer == null -%}
      <p>
        {{ 'actions.log_in_html' | t: link: routes.account_login_url }}
      </p>
    {%- endif -%}

    {%- comment -%} Heartside's empty cart (27 Oct): Buddy, one line, and the way into the chat, not Helio's catalog {%- endcomment -%}
    <div class="hs-cart-empty">
      <span class="hs-cart-empty__buddy">{% render 'hs-buddy' %}</span>
      <p class="hs-cart-empty__line">Nothing in here yet. I checked twice.</p>
    </div>
    <a
      class="button cart-items__empty-button"
      href="{{ routes.root_url }}"
    >
      <span class="button-text">Start with your dog</span>
    </a>
  {%- else -%}
    <span
      class="visually-hidden"
      ref="cartItemCount"
      aria-hidden="true"
    >
      {{- cart.item_count -}}
    </span>
    <form
      action="{{ routes.cart_url }}"
      class="cart-form"
      id="cart-form"
      method="post"
    >
      <div
        class="cart-items spacing-style{% if block_settings.dividers %} cart-items--dividers{% endif %}"
        style="{% render 'spacing-style', settings: block_settings %} --cart-items-gap:{{ block_settings.gap | append: "px" }};"
      >
        <table
          class="cart-items__table"
          role="table"
        >
          <caption
            class="visually-hidden"
            role="caption"
          >
            {{ 'content.cart_total' | t }}
            <span
              ><bdi>{{ cart.total_price | money_with_currency }}</bdi></span
            >
          </caption>

          <thead
            class="visually-hidden"
            role="rowgroup"
          >
            <tr
              role="row"
              class="cart-items__table-row"
            >
              <th
                id="productImage"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_image' | t }}
              </th>
              <th
                id="productInformation"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_information' | t }}
              </th>
              <th
                id="quantity"
                scope="col"
                role="columnheader"
              >
                {{ 'content.quantity' | t }}
              </th>
              <th
                id="productTotal"
                scope="col"
                role="columnheader"
              >
                {{ 'content.product_total' | t }}
              </th>
            </tr>
          </thead>

          <tbody role="rowgroup">
            {%- comment -%} Each Artist's touch right after the gift it reworks (Krish, 28 Oct: it sat above its gift).
              Shopify lists the newest line first and keeps its own line numbers, so each row carries its number
              (data-hs-line) and component-cart-items.js finds a row by that number, never by position. A design's
              id is the line's own _customization_id, else its first component's. Written with filters, not
              branches (Theme Check's complexity limit): ",DESIGN=INDEX," finds a gift by its design; a row's
              sort key is "GIFT.KIND.OWN:INDEX" (the gift's index for an add-on whose gift is here, else its own;
              1 for an add-on), so a gift's add-ons follow it and an add-on whose gift has left the cart keeps
              its own place. {%- endcomment -%}
            {%- liquid
              assign hs_gifts = ','
              assign hs_fors = ','
              assign hs_redos = ','
              for hs_line in cart.items
                assign hs_design = hs_line.properties._customization_id | default: hs_line.item_components.first.properties._customization_id | default: ''
                assign hs_gifts = hs_gifts | append: hs_design | append: '=' | append: forloop.index0 | append: ',' | replace: ',=', ',x'
                assign hs_fors = hs_fors | append: hs_line.properties._hs_addon_for | append: ',' | replace: ',,', ','
                assign hs_redo_of = hs_line.properties._hs_redo_of | default: hs_line.item_components.first.properties._hs_redo_of | default: ''
                assign hs_redos = hs_redos | append: hs_redo_of | append: ',' | replace: ',,', ','
              endfor
              assign hs_keys = ''
              for hs_line in cart.items
                assign hs_find = ',' | append: hs_line.properties._hs_addon_for | append: '='
                assign hs_base = hs_gifts | append: hs_find | append: 'x,' | split: hs_find
                assign hs_base = hs_base[1] | split: ',' | first | replace: 'x', forloop.index0 | plus: 1000
                assign hs_kind = hs_line.properties._hs_addon_for | size | at_most: 1
                assign hs_own = forloop.index0 | plus: 1000
                assign hs_keys = hs_keys | append: hs_base | append: '.' | append: hs_kind | append: '.' | append: hs_own | append: ':' | append: forloop.index0 | append: '|'
              endfor
              assign hs_rows = hs_keys | split: '|' | sort
            -%}
            {% for hs_row in hs_rows %}
              {%- liquid
                assign hs_n = hs_row | split: ':' | last | plus: 0
                assign item = cart.items[hs_n]
              -%}
              {%- liquid
                assign hs_quantity_item = item
                assign hs_quantity_key = ''
                assign hs_unit_original_price = item.original_price
                assign hs_unit_final_price = item.final_price
                if item.quantity == 1 and item.item_components.size == 1
                  assign hs_component = item.item_components.first
                  assign hs_prepared = hs_component.properties._hs_checkout_image
                  assign hs_image_origin = hs_prepared | slice: 0, 34
                  assign hs_native_id = hs_component.properties._customization_id
                  assign hs_expected_filename = 'heartside-checkout-' | append: hs_native_id | append: '.jpg'
                  assign hs_image_filename = hs_prepared | split: '?' | first | split: '/' | last
                  if hs_component.variant_id == item.variant_id and hs_component.quantity > 0 and hs_native_id != blank and hs_image_origin == 'https://cdn.shopify.com/s/files/1/' and hs_image_filename == hs_expected_filename
                    assign hs_quantity_item = hs_component
                    assign hs_quantity_key = hs_component.key
                    assign hs_unit_original_price = item.original_line_price | divided_by: hs_component.quantity
                    assign hs_unit_final_price = item.final_line_price | divided_by: hs_component.quantity
                  endif
                endif
              -%}
              {%- comment -%} Current-row artwork and quantity evidence only; no cart token or buyer answers. {%- endcomment -%}
              {%- capture hs_cart_line -%}
                {"key":{{ item.key | json }},"variant_id":{{ item.variant_id | json }},"quantity":{{ item.quantity | json }},
                "properties":{"_hs_checkout_image":{{ item.properties._hs_checkout_image | json }},"_customization_image":{{ item.properties._customization_image | json }},"_customization_id":{{ item.properties._customization_id | json }},"_hs_redo_of":{{ item.properties._hs_redo_of | json }},"_hs_addon_for":{{ item.properties._hs_addon_for | json }}},
                "item_components":[{%- for component in item.item_components -%}
                  {"key":{{ component.key | json }},"variant_id":{{ component.variant_id | json }},"quantity":{{ component.quantity | json }},
                  "properties":{"_hs_checkout_image":{{ component.properties._hs_checkout_image | json }},"_customization_image":{{ component.properties._customization_image | json }},"_customization_id":{{ component.properties._customization_id | json }},"_hs_redo_of":{{ component.properties._hs_redo_of | json }}}}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}]}
              {%- endcapture -%}
              {%- comment -%} This line's Heartside facts, read the way hs2.js cartLineFacts reads them, as keys built
                with filters (see the order above): its design, the gift an Artist's touch reworks (nil once that gift
                has left the cart), the presentation bundle, and the redo and Artist's touch offers. {%- endcomment -%}
              {%- liquid
                assign hs_line_id = item.properties._customization_id | default: item.item_components.first.properties._customization_id | default: ''
                assign hs_line_of = item.properties._hs_redo_of | default: item.item_components.first.properties._hs_redo_of | default: ''
                assign hs_id_mark = ',' | append: hs_line_id | append: ','
                # "36:" for a design id of 36 hex digits and dashes
                assign hs_uuid = hs_line_id | downcase | remove: '0' | remove: '1' | remove: '2' | remove: '3' | remove: '4' | remove: '5' | remove: '6' | remove: '7' | remove: '8' | remove: '9' | remove: 'a' | remove: 'b' | remove: 'c' | remove: 'd' | remove: 'e' | remove: 'f' | remove: '-'
                assign hs_uuid = hs_line_id | size | append: ':' | append: hs_uuid
                # Heartside's one-component presentation bundle (its parent is the original variant) matches hs_presentation (N2);
                # a line with no components is "0:"
                assign hs_parts = item.item_components.size | append: ':' | append: item.item_components.first.variant_id
                assign hs_presentation = '1:' | append: item.variant_id
                assign hs_addon_for = item.properties._hs_addon_for | default: ''
                assign hs_find = ',' | append: hs_addon_for | append: '='
                assign hs_gift_at = hs_gifts | append: hs_find | append: 'x,' | split: hs_find
                assign hs_gift_at = hs_gift_at[1] | split: ',' | first
                assign hs_gift_n = hs_gift_at | replace: 'x', '9999' | plus: 0
                assign hs_gift = cart.items[hs_gift_n]
                # "1136:/" offers a redo: a personalized design (quantity key), one unit, a design id, not itself a redo
                assign hs_personal = hs_quantity_key | size | at_most: 1
                assign hs_redo_offer = hs_personal | append: item.quantity | append: hs_uuid | append: '/' | append: hs_line_of
                # "136:/1" keeps the Artist's touch offer's place: a personalized design with no add-on yet
                assign hs_taken = hs_fors | prepend: 'z' | append: 'z' | split: hs_id_mark | size
                assign hs_artist_offer = hs_personal | append: hs_uuid | append: '/' | append: hs_taken
                # "1x": an Artist's touch whose gift has left the cart
                assign hs_orphan = hs_addon_for | size | at_most: 1 | append: hs_gift_at
                # one per design, an Artist's touch too (A9c); "11" is an add-on at one
                assign hs_one_per = hs_quantity_key | append: hs_addon_for | append: hs_line_id
                assign hs_addon_one = hs_addon_for | size | at_most: 1 | append: item.quantity
              -%}
              <tr
                id="CartItem-{{ item.key }}"
                role="row"
                class="cart-items__table-row{% if item.parent_relationship.parent != null %} cart-items__nested-line{% endif %}{% if context == 'drawer' %}{% unless item.unit_price_measurement %} cart-items__table-row--full-width-variants{% endunless %}{% endif %}{% if hs_gift != nil %} hs2-addon-line{% endif %}"
                ref="cartItemRows[]"
                data-parent-key="{{ item.parent_relationship.parent.key }}"
                data-key="{{ item.key }}"
                data-hs-line="{{ item.index | plus: 1 }}"
                data-hs2-cart-line="{{ hs_cart_line | escape }}"
                data-hs2-quantity-key="{{ hs_quantity_key | escape }}"
              >
                <td
                  class="cart-items__media"
                  role="cell"
                  headers="productImage"
                >
                  {% if item.image or hs_gift != nil -%}
                    {% liquid
                      assign ratio = 1
                      assign border_opacity = settings.cart_thumbnail_border_opacity | divided_by: 100.0
                      assign border_override = '--border-width: [cart_thumbnail_border_width]px; --border-style: [cart_thumbnail_border_style]; --border-color: rgb(var(--color-border-rgb) / [cart_thumbnail_border_opacity]); --border-radius: [cart_thumbnail_border_radius]px;' | replace: '[cart_thumbnail_border_width]', settings.cart_thumbnail_border_width | replace: '[cart_thumbnail_border_style]', settings.cart_thumbnail_border | replace: '[cart_thumbnail_border_opacity]', border_opacity | replace: '[cart_thumbnail_border_radius]', settings.cart_thumbnail_border_radius

                      if settings.cart_thumbnail_border_radius > 0
                        assign border_override = border_override | append: ' overflow: hidden;'
                      endif
                      if block_settings.image_ratio == 'portrait'
                        assign ratio = 0.8
                      elsif block_settings.image_ratio == 'adapt'
                        assign ratio = item.image.aspect_ratio | default: 1
                      endif

                      # The accepted design, drawn by the server (Krish, 28 Oct: the cart thumbnail
                      # "glitches epileptically"). Before, the product photo came from here, hs2.js
                      # swapped in the design and Teeinblue swapped that for its spinner, again on
                      # every re-render. Same sources as cartArtworkImage() in hs2.js: the line's
                      # prepared checkout image, else Teeinblue's, else its one matching component's.
                      # An Artist's touch has no design of its own: it shows the design it reworks, its gift's (A9b).
                      assign hs_design_item = item
                      assign hs_design_alt = 'Your personalized artwork'
                      if hs_gift != nil
                        assign hs_design_item = hs_gift
                        assign hs_design_alt = "Artist's touch for this design"
                      endif
                      assign hs_design_line = hs_design_item
                      assign hs_design_prepared = hs_design_item.properties._hs_checkout_image | default: ''
                      assign hs_design_native = hs_design_item.properties._customization_image | default: ''
                      if hs_design_prepared == blank and hs_design_native == blank and hs_design_item.item_components.size == 1
                        assign hs_design_line = hs_design_item.item_components.first
                        if hs_design_line.variant_id == hs_design_item.variant_id
                          assign hs_design_prepared = hs_design_line.properties._hs_checkout_image | default: ''
                          assign hs_design_native = hs_design_line.properties._customization_image | default: ''
                        endif
                      endif
                      assign hs_design = ''
                      assign hs_design_src = ''
                      assign hs_design_name = hs_design_prepared | split: '?' | first | split: '/' | last
                      assign hs_design_head = hs_design_name | slice: 0, 19
                      assign hs_design_tail = hs_design_name | slice: -4, 4
                      if hs_design_prepared != '' and hs_design_name.size == 59 and hs_design_head == 'heartside-checkout-' and hs_design_tail == '.jpg'
                        assign hs_design_origin = hs_design_prepared | slice: 0, 34
                        if hs_design_origin == 'https://cdn.shopify.com/s/files/1/'
                          assign hs_design = hs_design_prepared
                          if hs_design contains '?'
                            assign hs_design_src = hs_design | append: '&width=300'
                          else
                            assign hs_design_src = hs_design | append: '?width=300'
                          endif
                        endif
                      endif
                      if hs_design == '' and hs_design_native != ''
                        assign hs_design_name = hs_design_native | split: '?' | first | split: '/' | last
                        assign hs_design_tail = hs_design_name | slice: -4, 4
                        assign hs_design_origin = hs_design_native | slice: 0, 41
                        if hs_design_origin == 'https://cdn.teeinblue.com/customizations/' and hs_design_name.size == 40 and hs_design_tail == '.jpg'
                          assign hs_design = hs_design_native
                          # protocol-relative, so Teeinblue's img[src^="https://cdn.teeinblue.com/..."]
                          # never claims it; hs2.js retries it while Teeinblue is still rendering it
                          assign hs_design_src = hs_design | remove_first: 'https:'
                        endif
                      endif
                    %}
                    <a
                      href="{{ item.url }}"
                      class="cart-items__media-container{% if hs_design != '' %} teeinblue-item--customization-images{% endif %}"
                      style="--ratio:{{ ratio }};"
                    >
                      {%- if hs_design != '' -%}
                        {%- comment -%} teeinblue-item--customization-images is Teeinblue's own "leave these thumbnails alone" container {%- endcomment -%}
                        <img src="{{ hs_design_src | escape }}" alt="{{ hs_design_alt }}" width="250" height="250" class="cart-items__media-image border-style hs2-cart-preview" style="{{ border_override }}" data-hs2-design data-hs2-src="{{ hs_design | escape }}">
                        {%- if hs_gift != nil -%}
                          <span class="hs2-cart-addon-badge" aria-hidden="true"><svg viewBox="0 0 24 24" width="14" height="14" focusable="false"><path d="M16.5 3c1.2 0 4.5 3.3 4.5 4.5 0 1-5.3 6.7-7.3 8l-2-2c1.3-2 3.8-10.5 4.8-10.5Z" fill="currentColor"/><path d="M10.6 14.6l2 2c-.7 2-2.4 4-5.4 4-1.7 0-3.3-.7-4-1.3 2-.3 2.7-1.3 3-2.7.3-1.7 2.4-2.7 4.4-2Z" fill="currentColor"/></svg></span>
                        {%- endif -%}
                      {%- elsif item.image -%}
                      {%- liquid
                        echo item.image | image_url: width: 250 | image_tag: class: 'cart-items__media-image border-style', style: border_override
                      -%}
                      {%- endif -%}
                    </a>
                  {%- endif %}
                </td>
                <td
                  class="cart-items__details cart-primary-typography"
                  role="cell"
                  headers="productInformation"
                >
                  <div class="cart-items__product-info">
                    {%- liquid
                      assign cart_disclosure_unique_id = 'page-' | append: item.index
                      if context == 'drawer'
                        assign cart_disclosure_unique_id = 'drawer-' | append: item.index
                      endif
                    -%}
                    <div class="cart-items__title-row">
                      <a
                        href="{{ item.url }}"
                        class="cart-items__title"
                        {% if item.parent_relationship.parent != null %}
                          aria-label="{{ 'accessibility.nested_product' | t: product_title: item.product.title, parent_title: item.parent_relationship.parent.title | escape }}"
                        {% endif %}
                      >
                        {{- item.product.title -}}
                      </a>
                      {% render 'cart-disclosure-tooltip',
                        product: item.product,
                        unique_id: cart_disclosure_unique_id,
                        mode: 'trigger'
                      %}
                    </div>
                    {%- comment -%} An Artist's touch names the gift it reworks (A9d). The delay shows as its Delivery
                      property; a line added before that property existed says it here. {%- endcomment -%}
                    {%- if hs_gift != nil -%}
                      <p class="hs2-addon-for">For the {{ hs_gift.product.title | remove_first: "Your Dog's " | remove_first: 'Your Dog’s ' | escape }}{% if item.properties.Delivery == blank %}. Adds 5&nbsp;days.{% endif %}</p>
                    {%- endif -%}
                    {% if item.product.vendor and block_settings.vendor %}
                      <p>
                        <bdi>{{ item.product.vendor }}</bdi>
                      </p>
                    {% endif %}

                    {%- if item.item_components.size != 0 and hs_parts != hs_presentation -%}
                      <ul class="cart-items__bundle list-unstyled">
                        {%- for component in item.item_components -%}
                          <li>
                            {{- component.title -}}
                            {%- if component.quantity > 1 -%}
                              <span> × {{ component.quantity }}</span>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>

                  <div class="cart-items__variants-wrapper">
                    {%- if item.product.has_only_default_variant == false
                      or item.properties.size != 0
                      or item.selling_plan_allocation != null
                    -%}
                      {%- if hs_parts == '0:' or hs_parts == hs_presentation -%}{%- if item.product.has_only_default_variant == false -%}
                        <dl class="cart-items__variants">
                          {%- for option in item.options_with_values -%}
                            <div class="cart-items__variant">
                              <dt class="visually-hidden">{{ option.name }}:</dt>
                              <dd>
                                {{- option.value -}}
                                {%- if forloop.last != true %},&nbsp;{% endif -%}
                              </dd>
                            </div>
                          {%- endfor -%}
                        </dl>
                      {%- endif -%}{%- endif -%}

                      {%- liquid
                        assign has_visible_properties = false
                        for property in item.properties
                          assign property_first_char = property.first | slice: 0
                          if property.last != blank and property_first_char != '_'
                            assign has_visible_properties = true
                            break
                          endif
                        endfor
                      -%}
                      {%- if has_visible_properties -%}
                        <dl class="cart-items__properties">
                          {%- for property in item.properties -%}
                            {%- assign property_first_char = property.first | slice: 0 -%}
                            {%- if property.last != blank and property_first_char != '_' -%}
                              <div class="cart-items__property">
                                <dt>{{ property.first | escape_once }}:</dt>
                                <dd>
                                  {%- comment -%} Teeinblue pre-encodes some values, so escape_once; only https uploads link.
                                    An upload shows as a small picture and "View photo", never Shopify's hashed file name (A9e);
                                    a format browsers cannot draw (HEIC) keeps the words alone. {%- endcomment -%}
                                  {%- assign hs_property_scheme = property.last | slice: 0, 8 -%}
                                  {%- if property.last contains '/uploads/' and hs_property_scheme == 'https://' -%}
                                    {%- assign hs_upload_type = property.last | split: '?' | first | split: '.' | last | downcase -%}
                                    {%- assign hs_upload_mark = ',' | append: hs_upload_type | append: ',' -%}
                                    <a class="hs2-cart-upload" href="{{ property.last | escape_once }}">
                                      {%- if ',jpg,jpeg,png,webp,gif,' contains hs_upload_mark -%}
                                        <img class="hs2-cart-upload__img" src="{{ property.last | escape_once }}" width="48" height="48" loading="lazy" alt="">
                                      {%- endif -%}
                                      <span>View photo</span></a>
                                  {%- else -%}
                                    {{ property.last | escape_once }}
                                  {%- endif -%}
                                </dd>
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </dl>
                      {%- endif -%}

                      {%- if item.selling_plan_allocation -%}
                        <p>{{ item.selling_plan_allocation.selling_plan.name }}</p>
                      {%- endif -%}

                      {%- if item.line_level_discount_allocations.size > 0 -%}
                        <ul
                          class="list-unstyled"
                          role="list"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li>
                              <bdi>{{ discount.discount_application.title | escape }}</bdi>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    {%- endif -%}
                  </div>

                  {%- comment -%} The unit price only when it says something the line price does not (N3): several
                    units, or a sale. Every design is one unit, so it only repeated the price beside it. {%- endcomment -%}
                  {%- if hs_quantity_item.quantity > 1 or hs_unit_original_price != hs_unit_final_price or item.variant.compare_at_price > hs_unit_original_price -%}
                  <div class="cart-items__unit-price-wrapper">
                    <div>
                      {% if hs_unit_original_price != hs_unit_final_price %}
                        <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                        <span
                          ><bdi>{{ hs_unit_final_price | money }}</bdi></span
                        >
                        <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                        <s class="compare-at-price">
                          {% if item.variant.compare_at_price > hs_unit_original_price %}
                            <bdi>{{ item.variant.compare_at_price | money }}</bdi>
                          {% else %}
                            <bdi>{{ hs_unit_original_price | money }}</bdi>
                          {% endif %}
                        </s>
                      {% else %}
                        {% if item.variant.compare_at_price > hs_unit_original_price %}
                          <span class="visually-hidden">{{ 'content.price_sale' | t }}</span>
                        {% else %}
                          <span class="visually-hidden">{{ 'content.price' | t }}</span>
                        {% endif %}

                        <span
                          ><bdi>{{ hs_unit_original_price | money }}</bdi></span
                        >

                        {% if item.variant.compare_at_price > hs_unit_original_price %}
                          <span class="visually-hidden">{{ 'content.price_regular' | t }}</span>
                          <s class="compare-at-price"
                            ><bdi>{{ item.variant.compare_at_price | money }}</bdi></s
                          >
                        {% endif %}
                      {% endif %}
                    </div>
                  </div>
                  {%- endif -%}
                  {%- comment -%} Drawn with the line, not added after paint (28 Oct: the cart filled in a second late
                    and Check out jumped down). The redo offer exactly as hs2.js redoOffers writes it, which then
                    takes it over; an Artist's touch whose gift has left the cart; and the place for the Artist's
                    touch offer, which hs2.js artistTouch fills on the cart page. {%- endcomment -%}
                  {%- liquid
                    assign hs_redo_href = item.url | append: '?redo=' | append: hs_line_id
                    if item.url contains '?'
                      assign hs_redo_href = item.url | append: '&redo=' | append: hs_line_id
                    endif
                  -%}
                  {%- if hs_redos contains hs_id_mark -%}
                    <div class="hs2-redo" data-hs2-redo><p class="hs2-redo__tag">First version</p><p>You made a new version of this gift. Keep the new one?</p><button type="button" class="hs2-redo__remove" data-hs2-redo-remove>Remove this version</button></div>
                  {%- elsif hs_redo_offer == '1136:/' -%}
                    <div class="hs2-redo" data-hs2-redo><a href="{{ hs_redo_href | escape }}" data-hs2-redo-go>Not quite right? Make another version.</a><span>One redo per gift. Your design stays here until you choose.</span></div>
                  {%- endif -%}
                  {%- if hs_orphan == '1x' -%}
                    <p class="hs2-artist__orphan" data-hs2-artist-orphan role="status">The design this rework was for is no longer in your cart. Remove this line unless you meant to keep it.</p>
                  {%- endif -%}
                  {%- if context != 'drawer' and hs_artist_offer == '136:/1' -%}
                    <div class="hs2-artist-slot" data-hs2-artist-slot></div>
                  {%- endif -%}
                </td>
                <td
                  class="cart-items__quantity"
                  role="cell"
                  headers="quantity"
                >
                  {% # Here I want to pass some arguments to the quantity block so it knows which value should the input be set to. Though quantity block could be a snippet instead %}
                  {% assign can_update_quantity = item.instructions.can_update_quantity
                    | default: true, allow_false: true
                  %}
                  {% if hs_quantity_item.instructions.can_update_quantity == false %}{% assign can_update_quantity = false %}{% endif %}
                  {%- comment -%} One unit per design (28 Oct): Shopify's checkout merge turned 2 of a design ($258 in the cart)
                    into 4 ($516 in checkout). A design at one has no quantity control; one already above one keeps it, to
                    come back down (component-cart-items.js refuses anything higher). {%- endcomment -%}
                  {%- if hs_one_per != '' and hs_quantity_item.quantity == 1 -%}{%- assign can_update_quantity = false -%}{%- endif -%}
                  {%- comment -%} One Artist's touch per design (A9c), the same way: at one it has no quantity control. {%- endcomment -%}
                  {%- if hs_addon_one == '11' -%}{%- assign can_update_quantity = false -%}{%- endif -%}
                  <div class="cart-items__quantity-controls">
                    {% render 'volume-pricing-info',
                      variant: item.variant,
                      unique_id: item.index,
                      quantity: hs_quantity_item.quantity
                    %}

                    {%- capture hs_quantity_selector -%}
                      {% render 'quantity-selector',
                        product: item.product,
                        variant: item.variant,
                        in_cart_quantity: hs_quantity_item.quantity,
                        line_index: item.index,
                        class: 'cart-primary-typography',
                        can_update_quantity: can_update_quantity
                      %}
                    {%- endcapture -%}
                    {%- comment -%} A design never goes up (28 Oct), nor does an Artist's touch: its plus is served disabled and
                      inert. Helio's cart selector ignores a plus that arrives disabled: it turns it back on when it connects and
                      after every redraw, as the line has no max. Inert keeps it unpressable all the same, and
                      component-cart-items.js puts disabled back after each redraw (data-hs2-one-per). {%- endcomment -%}
                    {%- if hs_one_per != '' -%}{{ hs_quantity_selector | replace: 'name="plus"', 'name="plus" disabled inert aria-disabled="true" data-hs2-one-per' }}{%- else -%}{{ hs_quantity_selector }}{%- endif -%}
                    {%- if hs_one_per != '' -%}<p class="hs2-one-per">One per design</p>{%- endif -%}

                    <button
                      class="button cart-items__remove"
                      type="button"
                      aria-label="{{ 'accessibility.remove_item' | t: title: item.title | escape }}"
                      on:click="/onLineItemRemove/{{ item.index | plus: 1 }}"
                      {% assign can_remove = item.instructions.can_remove | default: true, allow_false: true %}
                      {% if hs_quantity_item.instructions.can_remove == false %}{% assign can_remove = false %}{% endif %}
                      {% if can_remove == false %}
                        hidden
                      {% endif %}
                    >
                      {{- 'icon-delete.svg' | inline_asset_content -}}
                      <span class="visually-hidden">{{ 'accessibility.remove' | t }}</span>
                    </button>
                  </div>
                </td>
                <td
                  class="cart-items__error hidden"
                  role="cell"
                  ref="cartItemErrorContainer-{{ item.index | plus: 1 }}"
                  headers="quantity"
                >
                  <div
                    class="cart-item__error"
                    role="alert"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-item__error-text cart-primary-typography"
                      ref="cartItemError-{{ item.index | plus: 1 }}"
                    ></small>
                  </div>
                </td>
                {%- liquid
                  if settings.currency_code_enabled_cart_items
                    assign price = item.final_line_price | money_with_currency
                    assign unit_price = item.unit_price | money_with_currency
                  else
                    assign price = item.final_line_price | money
                    assign unit_price = item.unit_price | money
                  endif
                -%}
                <td
                  class="cart-items__price cart-secondary-typography"
                  role="cell"
                  headers="productTotal"
                >
                  <text-component value="{{ price | strip_html }}"
                    ><bdi>{{ price }}</bdi></text-component
                  >
                  {%- if item.unit_price_measurement -%}
                    <div class="cart-items__price-unit cart-secondary-typography">
                      {% render 'unit-price', price: unit_price, measurement: item.unit_price_measurement %}
                    </div>
                  {%- endif -%}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        {% for item in cart.items %}
          {%- liquid
            assign cart_disclosure_unique_id = 'page-' | append: item.index
            if context == 'drawer'
              assign cart_disclosure_unique_id = 'drawer-' | append: item.index
            endif
          -%}
          {% render 'cart-disclosure-tooltip',
            product: item.product,
            unique_id: cart_disclosure_unique_id,
            mode: 'dialog'
          %}
        {% endfor %}
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
  .cart-items {
    --cart-item-media-width-min: 2.5rem;
    --cart-item-media-width-max: 7.5rem;

    container-name: cart-items;
    container-type: inline-size;
    width: 100%;
  }

  .cart-items-disabled {
    pointer-events: none;
  }

  .cart-items__wrapper {
    display: flex;
    flex-direction: column;
  }

  .cart-page--empty .cart-items__wrapper {
    align-items: center;
    margin-block-start: 0;
    text-align: center;
  }

  .cart-items__wrapper--drawer-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cart-items__table {
    width: 100%;
    border-spacing: 0;
  }

  .cart-items__table * {
    margin: 0;
  }

  .cart-items__table-row {
    --cart-item-price-width: 6rem;

    display: grid;
    grid-template-columns: clamp(2.5rem, 15cqi, 7.5rem) minmax(0, 1fr) minmax(var(--cart-item-price-width), auto);
    grid-template-areas:
      'media details price'
      'media quantity price'
      'media error error';
    column-gap: var(--gap-md);
    align-items: start;
    padding-bottom: var(--cart-items-gap);
    margin-bottom: var(--margin-lg);
  }

  .cart-items__details {
    grid-area: details;
    min-width: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }

  .cart-items__product-info {
    min-width: 0;
  }

  /* Cart drawer: separate grid areas for variants and unit price */
  .cart-items__table-row--full-width-variants {
    grid-template-columns: clamp(2.5rem, 15cqi, 7.5rem) minmax(0, 1fr) auto;
    grid-template-rows: repeat(4, min-content) 1fr;
    grid-template-areas:
      'media details price'
      'media variants variants'
      'media unit_price unit_price'
      'media quantity quantity'
      'media error error';

    .cart-items__details {
      display: contents;
    }

    .cart-items__product-info {
      grid-area: details;
    }

    .cart-items__variants-wrapper {
      grid-area: variants;

      &:empty {
        display: none;
      }

      p {
        margin: 0;
      }
    }

    .cart-items__unit-price-wrapper {
      grid-area: unit_price;
      font-size: var(--font-size--sm);
    }

    .cart-items__price {
      min-width: auto;
      width: max-content;
    }
  }

  .cart-items__table-row.cart-items__nested-line td:first-child {
    width: 60%;
    justify-self: right;
  }

  html:active-view-transition-type(page-navigation) .cart-items__table-row {
    /* stylelint-disable-next-line declaration-no-important */
    view-transition-name: none !important;
  }

  .cart-items__table-row.removing {
    overflow: hidden;
    animation: removeRow calc(var(--animation-speed) * 2) var(--animation-easing) forwards;
    animation-delay: var(--animation-speed);
  }

  @keyframes removeRow {
    0% {
      height: var(--row-height);
    }

    100% {
      opacity: 0;
      height: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      border-color: transparent;
    }
  }

  .cart-items__table-row.adding {
    interpolate-size: allow-keywords;
    overflow: hidden;
    animation: addRow calc(var(--animation-speed) * 2) var(--animation-easing) forwards;
  }

  @keyframes addRow {
    0% {
      opacity: 0;
      height: 0;
      padding-bottom: 0;
      margin-bottom: 0;
      border-color: transparent;
    }

    100% {
      opacity: 1;
      height: auto;
    }
  }

  .cart-items__table-row:last-child {
    padding-bottom: 0;
  }

  .cart-items--dividers .cart-items__table-row {
    border-bottom: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--cart-items-gap);
  }

  .cart-items--dividers .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-items--dividers .cart-items__table-row:last-of-type {
    border-block-end: none;
    padding-block-end: 0;
    margin-bottom: 0;
  }

  .cart-items__details > * + *,
  .cart-items__bundle li {
    margin-block-start: var(--margin-3xs);
  }

  .cart-items__details * {
    font-size: var(--font-size--sm);
  }

  .cart-items__details a {
    text-decoration: none;
  }

  .cart-items__title-row {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-xs);
    max-width: 100%;
    min-width: 0;
  }

  .cart-items__title {
    font-size: var(--font-size--md);
    color: var(--color-foreground);
    text-transform: var(--product-title-case);
    display: block;
    margin-block-start: 0;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .cart-items__variants {
    display: block;
  }

  .cart-items__variant {
    display: inline;
  }

  .cart-items__variant dt,
  .cart-items__variant dd {
    display: inline;
    margin: 0;
  }

  .cart-items__quantity {
    grid-area: quantity;
    margin-block-start: var(--margin-xs);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--gap-xs);
    width: fit-content;
  }

  .cart-items__quantity-controls {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--gap-xs);
    width: fit-content;
  }

  .cart-items__quantity-controls > .volume-pricing-info {
    margin-inline-start: calc(-1 * var(--minimum-touch-target) - var(--gap-xs));
  }

  .cart-items__quantity .quantity-selector {
    display: inline-flex;
    font-size: var(--font-size--sm);
    height: auto;
  }

  .cart-items__remove {
    background-color: transparent;
    color: var(--color-foreground);
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    justify-content: center;
    box-shadow: none;
    padding: 0;
  }

  .cart-items__media {
    grid-area: media;
    padding: 0;
  }

  .cart-items__price {
    grid-area: price;
    min-height: unset;
    min-width: var(--cart-item-price-width);
    text-align: end;
    display: block;
    font-size: var(--font-size--sm);
    line-height: var(--line-height);
  }

  .cart-items__price-unit {
    font-size: var(--font-size--xs);
    padding-block-start: var(--padding-2xs);
  }

  .cart-items__media-container {
    display: flex;
    aspect-ratio: var(--ratio);
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .cart-items__media-image {
    aspect-ratio: inherit;
    object-fit: cover;
    object-position: center center;
    width: 100%;
    height: auto;
  }

  .cart-items__empty-button {
    margin-top: var(--margin-md);
    margin-inline: auto;
    padding-inline: var(--padding-4xl);
    padding-block: var(--padding-lg);
  }

  /* Error message */
  .cart-items__error {
    display: flex;
    align-items: flex-start;
    width: 100%;
    grid-area: error;
    margin-block-start: var(--margin-xs);
    opacity: 1;
    overflow: hidden;
    transform: translateY(0);
    transition: opacity var(--drawer-animation-speed) var(--animation-easing),
      transform var(--drawer-animation-speed) var(--animation-easing);

    @starting-style {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .cart-item__error {
    display: flex;
    align-items: flex-start;
    width: 100%;
    font-size: var(--font-size--sm);
    padding-block: var(--padding-2xs);
  }

  .cart-item__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
    margin-block-start: var(--margin-3xs);
  }

  @container cart-items (min-width: 720px) {
    /* Cart page: original layout */
    .cart-items__table-row {
      --cart-item-price-width: 6rem;

      grid-template-columns: 7.5rem 1fr 1fr minmax(var(--cart-item-price-width), auto);
      grid-template-rows: min-content 1fr;
      grid-template-areas:
        'media details quantity price'
        'media details error error';
    }

    .cart-items__quantity,
    .cart-items__price {
      grid-area: initial;
    }

    .cart-items__quantity {
      margin-top: 0;
    }

    .cart-items__price {
      min-height: var(--minimum-touch-target);
      display: flex;
      flex-direction: column;
      align-items: flex-end;
    }

    /* Cart drawer: separate areas for variants and unit price */
    .cart-items__table-row--full-width-variants {
      grid-template-rows: min-content min-content min-content 1fr;
      grid-template-areas:
        'media details quantity price'
        'media variants variants variants'
        'media unit_price unit_price unit_price'
        'media error error error';

      .cart-items__quantity,
      .cart-items__price {
        grid-area: initial;
      }
    }
  }

  .cart__subtotal-container,
  .cart__total-container {
    display: flex;
    flex-direction: column;
  }

  .cart__total-container {
    row-gap: var(--gap-2xs);

    &.cart__total-container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart__subtotal-container:empty {
    display: none;
  }

  .cart__summary-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart__subtotal-container, .cart__total-container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart__subtotal-container,
  .cart__subtotal-container * {
    font-size: var(--font-size--sm);
  }

  .cart__total {
    font-weight: var(--font-weight-bold);
  }

  .cart__total-label {
    font-size: var(--font-size--sm);
  }

  .cart__total-value {
    font-size: var(--font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__additional-checkout-buttons {
    width: 100%;
  }

  shopify-accelerated-checkout-cart {
    --shopify-accelerated-checkout-inline-alignment: center;
    --shopify-accelerated-checkout-button-border-radius: var(--style-border-radius-buttons-primary);
    --shopify-accelerated-checkout-button-block-size: var(--height-buy-buttons);
    --shopify-accelerated-checkout-row-gap: var(--checkout-button-gap, 10px);
  }

  /* Remove animation */
  .remove-icon-bottom,
  .remove-icon-top {
    transition: transform var(--animation-speed) var(--animation-easing);
  }

  .cart-items__remove:hover .remove-icon-top {
    transform: translate(calc(-1 * var(--icon-stroke-width)), var(--icon-stroke-width)) rotate(-15deg);
  }

  .cart-items__remove:is(:hover, :active) .remove-icon-bottom {
    transform: translateY(var(--icon-stroke-width));
  }

  .cart-items__table-row.removing .remove-icon-bottom {
    transform: translateY(0);
  }

  .cart-items__table-row.removing .remove-icon-top {
    animation: removeButtonClickedIconTop var(--animation-speed) var(--animation-easing) forwards;
  }

  @keyframes removeButtonClickedIconTop {
    50% {
      transform: translate(0, calc(-1 * var(--icon-stroke-width)));
    }

    100% {
      transform: translate(0, 0);
    }
  }

  .cart-items__properties {
    display: block;
    margin-block-start: var(--margin-2xs);
  }

  .cart-items__property {
    display: block;
  }

  .cart-items__properties dt,
  .cart-items__properties dd {
    display: inline;
    margin: 0;
    overflow-wrap: break-word;
  }

  @media screen and (min-width: 750px) {
    .cart-items .quantity-selector {
      --quantity-selector-width: 105px;
      height: var(--button-size-md);
      width: var(--quantity-selector-width);
    }

    .cart-items .quantity-selector button {
      width: var(--button-size-md);
      height: var(--button-size-md);
    }

    .cart-items .quantity-selector input[type='number'] {
      width: calc(var(--quantity-selector-width) - var(--button-size-md) * 2);
    }
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .cart-items__empty-button,
      .cart__checkout-button {
        view-transition-name: cart-drawer-primary-action;

        & > .button-text {
          view-transition-name: cart-drawer-primary-action-text;
        }
      }
    }
  }

  ::view-transition-old(cart-drawer-primary-action-text),
  ::view-transition-new(cart-drawer-primary-action-text) {
    height: 100%;
    object-fit: none;
    overflow: clip;
    overflow-clip-margin: 1em;
  }

  ::view-transition-old(cart-drawer-primary-action-text) {
    animation: cart-drawer-primary-action-text var(--animation-speed) var(--animation-easing) reverse forwards;
  }
  ::view-transition-new(cart-drawer-primary-action-text) {
    animation: cart-drawer-primary-action-text var(--animation-speed) var(--animation-easing) forwards;
  }

  ::view-transition-old(cart-drawer-primary-action),
  ::view-transition-new(cart-drawer-primary-action) {
    height: 100%;
  }

  ::view-transition-group(cart-drawer-primary-action-text),
  ::view-transition-group(cart-drawer-primary-action) {
    animation-duration: var(--spring-d300-b0-duration);
    animation-timing-function: var(--spring-d300-b0-easing);
  }

  @keyframes cart-drawer-primary-action-text {
    from {
      filter: blur(3px);
      opacity: 0;
    }
    to {
      filter: none;
      opacity: 1;
    }
  }
{% endstylesheet %}
