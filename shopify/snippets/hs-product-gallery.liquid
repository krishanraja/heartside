{%- liquid
  assign hidden_media_id = 0
  if product.id == 16158073880958
    if s.blanket_purchase or s.blanket_art_preview
      assign hidden_media_id = 71850515169662
    endif
  endif
-%}
    <div class="hs2-product__media" data-hs2-media{% if v3 %} data-hs2-sample{% endif %}{% if s.open_on == 'photo' and product.media.size > 0 %} data-open="photo" data-show="photo"{% endif %}>
      {%- if v3 -%}<span class="hs2-product__example">{% if artwork_preview %}Existing reference artwork. Generation is paused.{% else %}Example artwork. Add your dog's photo to see yours.{% endif %}</span>{%- endif -%}
      <div class="hs2-product__tib" data-hs2-tib-gallery></div>
      {%- if s.show_poster -%}
        <div class="hs2-product__poster">{% render 'hs2-poster' %}</div>
      {%- endif -%}
      {%- if product.media.size > 0 -%}
        {%- comment -%} the chosen variant's own photo first (the mug's color), else the product's {%- endcomment -%}
        {%- assign first = current.featured_media | default: product.featured_media -%}
        {%- if first.id == hidden_media_id -%}
          {%- assign first = nil -%}
          {%- for candidate in product.media -%}
            {%- if candidate.id != hidden_media_id -%}
              {%- assign first = candidate -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        {%- comment -%} A gift sold in colors (the mug) has a pair of photos per color, alt "…, black inside: …".
          Only the chosen color's pair is shown; hs2.js swaps the pair when the color changes. {%- endcomment -%}
        {%- assign color_key = '' -%}
        {%- for opt in product.options_with_values -%}
          {%- if opt.name == 'Color' and opt.values.size > 1 -%}
            {%- assign color_key = current.options[forloop.index0] | downcase | prepend: ', ' | append: ' inside' -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if first -%}
        <div class="hs2-product__main">
          <img data-hs2-main src="{{ first | image_url: width: 1200 }}"
            srcset="{{ first | image_url: width: 600 }} 600w, {{ first | image_url: width: 900 }} 900w, {{ first | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 900px) 50vw, 100vw" alt="{{ first.alt | default: product.title | escape }}" width="1200" height="1200"
            {% if s.show_poster %}loading="lazy"{% else %}fetchpriority="high"{% endif %}>
          {% if s.blanket_purchase %}<p class="hs2-product__placement-note">Example placement only. Upload your dog to preview your blanket.</p>{% endif %}
        </div>
        {%- endif -%}
        {%- comment -%} With Teeinblue's live preview on the page, it is the first picture and the product
          photos sit behind it as thumbnails, so the page shows one picture at a time. {%- endcomment -%}
        {%- if product.media.size > 1 or tib -%}
          <div class="hs2-product__thumbs">
            {%- if tib -%}
              <button type="button" class="hs2-product__thumb-preview" data-hs2-thumb-preview aria-current="false" aria-label="Show your preview">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Yours</span>
              </button>
            {%- endif -%}
            {%- for m in product.media limit: 12 -%}
              {%- if m.id == hidden_media_id -%}{%- continue -%}{%- endif -%}
              {%- assign m_alt = m.alt | downcase -%}
              <button type="button"{% if color_key != '' and m_alt contains ' inside' %} data-hs2-color="{{ m_alt | split: ' inside' | first | split: ', ' | last | escape }}"{% unless m_alt contains color_key %} hidden{% endunless %}{% endif %} data-hs2-thumb="{{ m | image_url: width: 1200 }}" data-alt="{{ m.alt | default: product.title | escape }}" aria-current="{% if m.id == first.id %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">
                <img src="{{ m | image_url: width: 160 }}" alt="" width="76" height="76" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- elsif s.show_poster == false -%}
        <div class="hs2-product__main hs2-card__media">
          <img src="{{ 'hs-photo-asleep-640.webp' | asset_url }}" alt="" width="640" height="640">
          <div class="hs2-card__shot">{{ s.shot }}</div>
          {% if s.blanket_purchase %}<p class="hs2-product__placement-note">Example placement only. Upload your dog to preview your blanket.</p>{% endif %}
        </div>
      {%- endif -%}
    </div>
