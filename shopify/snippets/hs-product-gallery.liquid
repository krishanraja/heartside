{%- liquid
  # The blank technical reference (Printful's plain blanket, "shown in your cart") never shows in
  # the gallery: it is hidden by its alt text, with the known ids kept as a backstop (27 Oct; the
  # old hard-coded id had gone stale and the blank showed first on the live blanket page).
  # A "checkout tile" (the designed picture a gift's variant carries for checkout's component line,
  # 28 Oct) is hidden the same way: it stands for the buyer's design at checkout, never on the page.
  assign hide_alt = s.hide_media_alt | default: 'shown in your cart' | downcase
  assign hidden_ids = '71850515169662,71856697049470' | split: ','
  assign first = nil
  assign color_key = ''
  if product.media.size > 0
    # the chosen variant's own photo first (the mug's color), else the product's first shown photo
    assign first = current.featured_media | default: product.featured_media
    assign first_alt = first.alt | downcase
    assign first_id = first.id | append: ''
    if hidden_ids contains first_id or first_alt contains hide_alt or first_alt contains 'blank ' or first_alt contains 'checkout tile'
      assign first = nil
      for candidate in product.media
        assign c_alt = candidate.alt | downcase
        assign c_id = candidate.id | append: ''
        unless hidden_ids contains c_id or c_alt contains hide_alt or c_alt contains 'blank ' or c_alt contains 'checkout tile'
          assign first = candidate
          break
        endunless
      endfor
    endif
    # A gift once sold in colors with a pair of photos per color, alt "..., black inside: ..." (kept for
    # any such pair; the 30 Oct colour pictures are variant pictures, below).
    # Only the chosen color's pair is shown; hs2.js swaps the pair when the color changes.
    for opt in product.options_with_values
      if opt.name == 'Color' and opt.values.size > 1
        assign color_key = current.options[forloop.index0] | downcase | prepend: ', ' | append: ' inside'
      endif
    endfor
    # A variant's own picture (a mug colour, a frame finish; 30 Oct) is a thumbnail only while that
    # variant is chosen, so the row holds one colour, not five; hs2.js swaps it when the choice changes.
    # The product's first picture stays, since a variant sharing it is not a picture of its own.
    assign vmedia = ','
    for v in product.variants
      if v.featured_media and v.featured_media.id != product.featured_media.id
        assign vmedia = vmedia | append: v.featured_media.id | append: ','
      endif
    endfor
  endif
-%}
    <div class="hs2-product__media" data-hs2-media{% if v3 %} data-hs2-sample{% endif %}{% if s.open_on == 'photo' and product.media.size > 0 %} data-open="photo" data-show="photo"{% endif %}>
      {%- if v3 -%}<span class="hs2-product__example">{% if artwork_preview %}Existing reference artwork. Generation is paused.{% else %}Example artwork. Add your dog's photo to see yours.{% endif %}</span>{%- endif -%}
      {%- comment -%} One stage, one size: the live preview and the product photo are stacked in the same
        box, so switching between them, or between thumbnails, never changes the page's height. {%- endcomment -%}
      <div class="hs2-product__stage" data-hs2-stage style="--hs2-ratio: {{ s.media_ratio | default: '1' }}">
        <div class="hs2-product__tib" data-hs2-tib-gallery></div>
        {%- comment -%} the live preview shows Teeinblue's sample dog until the buyer's painting is in it,
          so it says so too (hs2.js artStage sets data-hs2-sample-dog) {%- endcomment -%}
        <span class="hs2-product__tag hs2-product__tag--preview" aria-hidden="true">Example</span>
        {%- if s.show_poster -%}
          <div class="hs2-product__poster">{% render 'hs2-poster' %}</div>
        {%- endif -%}
        {%- if first -%}
          <div class="hs2-product__main" data-hs2-main-wrap>
            <img data-hs2-main src="{{ first | image_url: width: 1200 }}"
              srcset="{{ first | image_url: width: 600 }} 600w, {{ first | image_url: width: 900 }} 900w, {{ first | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 900px) 50vw, 100vw" alt="{{ first.alt | default: product.title | escape }}" width="1200" height="1200"
              {% if s.show_poster %}loading="lazy"{% else %}fetchpriority="high"{% endif %}>
            {%- comment -%} every product photo shows an example dog, so it says so; the live preview
              ("Your design") sits on its own layer and never carries this label {%- endcomment -%}
            <span class="hs2-product__tag" aria-hidden="true">Example</span>
            {% if s.blanket_purchase %}<p class="hs2-product__placement-note">Example placement only. Upload your dog to preview your blanket.</p>{% endif %}
          </div>
        {%- elsif product.media.size == 0 and s.show_poster == false -%}
          <div class="hs2-product__main hs2-card__media">
            <img src="{{ 'hs-photo-asleep-640.webp' | asset_url }}" alt="" width="640" height="640">
            <div class="hs2-card__shot">{{ s.shot }}</div>
            {% if s.blanket_purchase %}<p class="hs2-product__placement-note">Example placement only. Upload your dog to preview your blanket.</p>{% endif %}
          </div>
        {%- endif -%}
      </div>
      {%- comment -%} With Teeinblue's live preview on the page, it is the first picture and the product
        photos sit behind it as thumbnails, so the page shows one picture at a time. {%- endcomment -%}
      {%- if product.media.size > 0 -%}
        {%- if product.media.size > 1 or tib -%}
          <div class="hs2-product__thumbs">
            {%- if tib -%}
              <button type="button" class="hs2-product__thumb-preview" data-hs2-thumb-preview aria-current="false" aria-label="Show your design">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                <span>Your design</span>
              </button>
            {%- endif -%}
            {%- for m in product.media limit: 18 -%}
              {%- assign m_alt = m.alt | downcase -%}
              {%- assign m_id = m.id | append: '' -%}
              {%- assign m_key = ',' | append: m_id | append: ',' -%}
              {%- if hidden_ids contains m_id or m_alt contains hide_alt or m_alt contains 'blank ' or m_alt contains 'checkout tile' -%}{%- continue -%}{%- endif -%}
              <button type="button"{% if vmedia contains m_key %} data-hs2-vmedia{% unless first and m.id == first.id %} hidden{% endunless %}{% endif %}{% if color_key != '' and m_alt contains ' inside:' %} data-hs2-color="{{ m_alt | split: ' inside' | first | split: ', ' | last | escape }}"{% unless m_alt contains color_key %} hidden{% endunless %}{% endif %} data-hs2-thumb="{{ m | image_url: width: 1200 }}" data-srcset="{{ m | image_url: width: 600 }} 600w, {{ m | image_url: width: 900 }} 900w, {{ m | image_url: width: 1200 }} 1200w" data-alt="{{ m.alt | default: product.title | escape }}" aria-current="{% if first and m.id == first.id %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}">
                <img src="{{ m | image_url: width: 160 }}" alt="" width="76" height="76" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>
